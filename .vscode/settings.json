{
  // The reject programs are invalid on purpose. As plain text they do not go to Fe's
  // language server, which would report their errors and a standalone-file warning.
  "files.associations": {
    "**/corpus/reject/*.fe": "plaintext"
  },
  // Fe's language server checks every .fe file and fe.toml that the file watcher reports. These
  // trees hold invalid or generated programs: the corpus, the tools' output under out/, and
  // copies of the repo under .git/unsmell/.
  "files.watcherExclude": {
    "**/corpus/**": true,
    "**/out/**": true,
    "**/.git/unsmell/**": true
  }
}
