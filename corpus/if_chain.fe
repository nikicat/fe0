// `if` as an expression: else-if chains, nesting, and `if` inside operands.
msg IfChainMsg {
    #[selector = 1]
    Grade { score: u256 } -> u256,
    #[selector = 2]
    Sign { a: u256, b: u256 } -> u256,
    #[selector = 3]
    Nested { a: u256, b: u256 } -> u256,
    #[selector = 4]
    Inline { a: u256 } -> u256,
}

fn grade(_ score: u256) -> u256 {
    if score >= 90 {
        5
    } else if score >= 80 {
        4
    } else if score >= 70 {
        3
    } else if score >= 60 {
        2
    } else if score >= 50 {
        1
    } else {
        0
    }
}

// 0 if a < b, 1 if a == b, 2 if a > b.
fn sign(_ a: u256, _ b: u256) -> u256 {
    if a < b { 0 } else if a == b { 1 } else { 2 }
}

fn nested(_ a: u256, _ b: u256) -> u256 {
    if a > 10 {
        if b > 10 { 11 } else { 10 }
    } else {
        if b > 10 { 1 } else if b == 0 { 100 } else { 0 }
    }
}

fn inline(_ a: u256) -> u256 {
    (if a % 2 == 0 { a / 2 } else { 3 * a + 1 }) + if a > 5 { 1000 } else { 0 }
}

contract IfChain {
    recv IfChainMsg {
        Grade { score } -> u256 {
            grade(score)
        }
        Sign { a, b } -> u256 {
            sign(a, b)
        }
        Nested { a, b } -> u256 {
            nested(a, b)
        }
        Inline { a } -> u256 {
            inline(a)
        }
    }
}
