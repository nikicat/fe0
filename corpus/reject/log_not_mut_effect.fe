// expect: E004 17:13
// A body emits only through a `Log` effect declared `mut` (SPEC §6, "Events"), even when its
// `uses` grants it `mut`.
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed]
    to: Address,
    n: u256,
}
contract C uses (log: Log) {
    recv M {
        Go { n } uses (mut log) {
            log.emit(E { to: Address::zero(), n })
        }
    }
}
