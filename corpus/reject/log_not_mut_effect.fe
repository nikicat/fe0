// expect: P002 13:23
// A `Log` effect is declared `mut Log` (SPEC §6, "Events").
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed]
    to: Address,
    n: u256,
}
contract C uses (log: Log) {
    recv M {
        Go { n } uses (mut log) {
            log.emit(E { to: Address::zero(), n })
        }
    }
}
