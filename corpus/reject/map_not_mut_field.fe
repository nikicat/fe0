// expect: P010 10:5
// A map field must be `mut`, as every field in Fe0 (SPEC §6, "Maps").
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    n: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (n) {
            n[k]
        }
    }
}
