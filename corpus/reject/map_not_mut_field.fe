// expect: P010 11:5
// A map field must be `mut` (SPEC §6), as every field in Fe0. Fe rejects it too, because a
// map is state only (3-0061).
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    n: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (n) {
            n[k]
        }
    }
}
