// expect: P002 10:16
// An attribute must end its line, so `#[indexed]` may not share a line with its field
// (SPEC §3.1).
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed] n: u256,
}
contract C uses (log: mut Log) {
    recv M {
        Go { n } uses (mut log) {
            log.emit(E { n })
        }
    }
}
