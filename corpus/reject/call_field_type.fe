// expect: T001 16:37
// Each value of a call has its field's type (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 uses (mut call) {
            t.call(Other::Echo { a: true })
        }
    }
}
