// expect: P005 12:15
// A newline may not come inside `[ ]` (SPEC §3.4). Fe rejects it too (1-0001).
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            m[
                k
            ]
        }
    }
}
