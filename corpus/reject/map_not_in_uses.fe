// expect: E116 12:13
// Reading an entry needs the map in `uses` (SPEC §6, "Maps").
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (x) {
            m[k]
        }
    }
}
