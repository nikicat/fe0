// expect: N018 14:15
// A bind may not take an event's name (SPEC §5.2).
msg M {
    #[selector = 1]
    Get -> u256,
    #[selector = 2]
    Set { n: u256 } -> u256,
}
#[event]
struct ev { a: u256 }
contract C {
    recv M {
        Get {} -> u256 { 0 }
        Set { n: ev } -> u256 { ev }
    }
}
