// expect: N003 11:21
// A `Ctx` effect is not a value, so it cannot be bound to a local (SPEC §6, "The caller").
// Fe rejects this too.
msg M {
    #[selector = 1]
    Get -> Address,
}
contract C uses (ctx: Ctx) {
    recv M {
        Get {} -> Address uses (ctx) {
            let c = ctx
            Address::zero()
        }
    }
}
