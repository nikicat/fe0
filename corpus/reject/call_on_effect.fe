// expect: N003 16:13
// An effect is not an address, so it cannot be called (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call, log: mut Log) {
    recv M {
        Go { t } -> u256 uses (mut call, log) {
            log.call(Other::Echo { a: 1 })
        }
    }
}
