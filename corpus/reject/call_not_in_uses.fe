// expect: E116 16:13
// A call needs the `Call` effect in the body's `uses` (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 {
            t.call(Other::Echo { a: 1 })
        }
    }
}
