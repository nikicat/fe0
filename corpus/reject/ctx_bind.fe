// expect: N005 9:15
// A bind may not take the name of a `Ctx` effect that its body's `uses` lists (SPEC §5.2).
msg M {
    #[selector = 1]
    Get { ctx: u256 } -> Address,
}
contract C uses (ctx: Ctx) {
    recv M {
        Get { ctx } -> Address uses (ctx) {
            Address::zero()
        }
    }
}
