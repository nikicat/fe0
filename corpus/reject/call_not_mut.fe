// expect: E018 18:13
// fe: accepts
// Fe0 calls only through a `Call` effect that `uses` grants as `mut` (SPEC §6, "Calls"),
// although Fe accepts `uses (call)`.
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 uses (call) {
            t.call(Other::Echo { a: 1 })
        }
    }
}
