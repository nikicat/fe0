// expect: T001 12:13
// Only a map has entries (SPEC §6, "Maps"). Fe rejects it too (8-0016).
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (x) {
            x[1]
        }
    }
}
