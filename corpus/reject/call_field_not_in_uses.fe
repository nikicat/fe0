// expect: E116 18:13
// Calling an address in a contract field reads the field (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    mut g: Address,

    recv M {
        Go { t } -> u256 uses (mut call) {
            g.call(Other::Echo { a: 1 })
        }
    }
}
