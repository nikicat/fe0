// expect: E116 4:5
// A free function may not read a map (SPEC §5.5).
fn g() -> u256 {
    m[1]
}
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            m[k] + g()
        }
    }
}
