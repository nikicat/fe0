// expect: N019 16:13
// An emitted event needs a value for each of its fields (SPEC §6, "Events").
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed]
    to: Address,
    n: u256,
}
contract C uses (log: mut Log) {
    recv M {
        Go { n } uses (mut log) {
            log.emit(E { n })
        }
    }
}
