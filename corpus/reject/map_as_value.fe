// expect: N003 13:21
// fe: accepts
// A map is not a value in Fe0 (SPEC §6, "Maps"), although Fe binds one to a local.
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            let y = m
            y[k]
        }
    }
}
