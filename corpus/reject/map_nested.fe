// expect: P004 11:29
// fe: accepts
// A map's values may not be maps in Fe0 (SPEC §3.3), although Fe nests them.
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    mut n: StorageMap<u256, StorageMap<u256, u256>>,
    recv M {
        Get { k, a } -> u256 uses (mut n) {
            n[k][k] = 1
            0
        }
    }
}
