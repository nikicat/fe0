// expect: E018 13:13
// Writing an entry needs `mut` on the map in `uses` (SPEC §6, "Maps"). Fe rejects it too
// (8-0018).
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            m[k] = 1
            0
        }
    }
}
