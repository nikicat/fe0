// expect: N001 14:31
// fe: accepts
// A contract has at most one `Call` effect (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (a: mut Call, b: mut Call) {
    recv M {
        Go { t } -> u256 uses (mut a) {
            t.call(Other::Echo { a: 1 })
        }
    }
}
