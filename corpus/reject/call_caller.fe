// expect: T001 17:13
// fe: accepts
// Only a `Ctx` effect has `caller()`, not a `Call` effect (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> Address,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> Address uses (call) {
            call.caller()
        }
    }
}
