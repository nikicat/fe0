// expect: T001 12:13
// Only a `Ctx` effect has `caller()`, not an `Address` (SPEC §6, "The caller").
msg M {
    #[selector = 1]
    Get -> Address,
}
contract C uses (ctx: Ctx) {
    mut owner: Address,

    recv M {
        Get {} -> Address uses (ctx, owner) {
            owner.caller()
        }
    }
}
