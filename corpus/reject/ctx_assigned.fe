// expect: N014 10:13
// A `Ctx` effect cannot be assigned, even when `uses` names it `mut` (SPEC §6, "The caller").
msg M {
    #[selector = 1]
    Get -> Address,
}
contract C uses (ctx: Ctx) {
    recv M {
        Get {} -> Address uses (mut ctx) {
            ctx = ctx
            Address::zero()
        }
    }
}
