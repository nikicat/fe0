// expect: T003 18:21
// fe: accepts
// A call of a variant without a return type has no value (SPEC §6, "Calls"), although Fe
// accepts it as the value of a `let`.
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 uses (mut call) {
            let x = t.call(Other::Store { a: 1 })
            0
        }
    }
}
