// expect: P002 8:10
// An attribute must end its line, so `#[event]` may not share a line with its struct
// (SPEC §3.1).
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event] struct E {
    n: u256,
}
contract C uses (log: mut Log) {
    recv M {
        Go { n } uses (mut log) {
            log.emit(E { n })
        }
    }
}
