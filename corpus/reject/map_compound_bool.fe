// expect: T001 14:13
// A compound assignment needs a `u256` entry (SPEC §6, "Maps"). Fe rejects it too
// (8-0016).
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    mut f: StorageMap<u256, bool>,
    recv M {
        Get { k, a } -> u256 uses (mut f) {
            f[k] += true
            0
        }
    }
}
