// expect: T001 13:20
// A value must have the map's value type (SPEC §6, "Maps").
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    mut f: StorageMap<u256, bool>,
    recv M {
        Get { k, a } -> u256 uses (mut f) {
            f[k] = 1
            0
        }
    }
}
