// expect: T001 18:21
// fe: accepts
// In Fe0, only a `Ctx` effect has `caller()` (SPEC §6, "Events"), although Fe accepts it on a
// `Log` effect.
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed]
    to: Address,
    n: u256,
}
contract C uses (log: mut Log) {
    recv M {
        Go { n } uses (mut log) {
            assert!(log.caller() == Address::zero())
        }
    }
}
