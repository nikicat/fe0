// expect: T001 17:21
// fe: accepts
// Only a `Ctx` effect has `caller()`, not a `Log` effect (SPEC §6, "Events").
msg M {
    #[selector = 1]
    Go { n: u256 },
}
#[event]
struct E {
    #[indexed]
    to: Address,
    n: u256,
}
contract C uses (log: mut Log) {
    recv M {
        Go { n } uses (mut log) {
            assert!(log.caller() == Address::zero())
        }
    }
}
