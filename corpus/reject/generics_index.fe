// expect: P011 14:18
// fe: accepts
// Fe0 reads `m[k]` after `<` as a generic argument, so it rejects `<` here (SPEC §3.2). Fe
// reads a comparison.
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            if k < m[k] >> 1 { 1 } else { 0 }
        }
    }
}
