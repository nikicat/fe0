// expect: N001 9:9
// A storage field may not take the name of a `Ctx` effect (SPEC §6, "The caller").
// Fe rejects this too.
msg M {
    #[selector = 1]
    Get -> Address,
}
contract C uses (ctx: Ctx) {
    mut ctx: Address,

    recv M {
        Get {} -> Address uses (ctx) {
            ctx.caller()
        }
    }
}
