// expect: P002 13:15
// fe: accepts
// Fe0 reads an entry only as `m[k]` (SPEC §3.3), although Fe also has `m.get(k)`.
msg M {
    #[selector = 1]
    Get { k: u256, a: Address } -> u256,
}
contract C {
    mut x: u256,
    mut m: StorageMap<u256, u256>,
    recv M {
        Get { k, a } -> u256 uses (m) {
            m.get(k)
        }
    }
}
