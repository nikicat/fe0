// expect: N018 17:15
// A bind may not take a function's name (SPEC §5.2).
// fe: accepts
msg M {
    #[selector = 1]
    Get -> u256,
    #[selector = 2]
    Set { a: u256 } -> u256,
}
fn g() -> u256 {
    1
}

contract C {
    recv M {
        Get {} -> u256 { g() }
        Set { a: g } -> u256 { g }
    }
}
