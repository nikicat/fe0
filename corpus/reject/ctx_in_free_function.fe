// expect: E116 8:5
// A free function has no `uses`, so it may not read the caller (SPEC §5.5).
msg M {
    #[selector = 1]
    Get -> Address,
}
fn who() -> Address {
    ctx.caller()
}

contract C uses (ctx: Ctx) {
    recv M {
        Get {} -> Address uses (ctx) {
            who()
        }
    }
}
