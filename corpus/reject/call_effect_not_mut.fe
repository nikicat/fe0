// expect: E004 17:13
// A body calls only through a `Call` effect declared `mut` (SPEC §6, "Calls"), even when its
// `uses` grants it `mut`.
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: Call) {
    recv M {
        Go { t } -> u256 uses (mut call) {
            t.call(Other::Echo { a: 1 })
        }
    }
}
