// expect: T001 16:42
// A call's value has the variant's return type (SPEC §6, "Calls"). A call of a variant
// without one cannot be the body's `u256` result.
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 uses (mut call) {
            t.call(Other::Store { a: 1 })
        }
    }
}
