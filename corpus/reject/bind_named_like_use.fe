// expect: N005 13:15
// A bind may not take the name of an entry of its arm's `uses` (SPEC §5.2).
msg M {
    #[selector = 1]
    Get -> u256,
    #[selector = 2]
    Set { n: u256 } -> u256,
}
contract C {
    mut n: u256,
    recv M {
        Get {} -> u256 uses (n) { n }
        Set { n } -> u256 uses (mut n) { n }
    }
}
