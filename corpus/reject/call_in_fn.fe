// expect: E116 14:5
// A free function has no effects, so it calls nothing (SPEC §6, "Calls").
msg Other {
    #[selector = 0x11]
    Echo { a: u256 } -> u256,
    #[selector = 0x12]
    Store { a: u256 },
}
msg M {
    #[selector = 1]
    Go { t: Address } -> u256,
}
fn f(_ t: Address) -> u256 {
    t.call(Other::Echo { a: 1 })
}
contract C uses (call: mut Call) {
    recv M {
        Go { t } -> u256 uses (mut call) {
            t.call(Other::Echo { a: 1 })
        }
    }
}
