// Two `Ctx` effects under names other than ctx, one declared `mut Ctx` and one granted `mut`
// (SPEC §6, "The caller").
msg TwoMsg {
    #[selector = 1]
    Touch -> bool,
    #[selector = 2]
    Last -> Address,
}

contract Two uses (a: Ctx, b: mut Ctx) {
    mut last: Address,

    recv TwoMsg {
        Touch {} -> bool uses (mut a, b, mut last) {
            last = b.caller()
            a.caller() == b.caller()
        }
        Last {} -> Address uses (last) {
            last
        }
    }
}
