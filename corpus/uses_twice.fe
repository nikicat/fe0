// A field listed twice in an arm's `uses`, with and without `mut` (SPEC §6, "Effects").
msg M {
    #[selector = 1]
    Get -> u256,
    #[selector = 2]
    Bump -> u256,
    #[selector = 3]
    BumpTwice -> u256,
}

contract C {
    mut n: u256,

    recv M {
        Get {} -> u256 uses (n, n) {
            n
        }
        Bump {} -> u256 uses (n, mut n) {
            n += 1
            n
        }
        BumpTwice {} -> u256 uses (mut n, mut n) {
            n += 2
            n
        }
    }
}
