// A constant-product pair of two tokens, shaped like a Uniswap v2 pair (ADR 0020). A trader or
// a liquidity provider first transfers tokens to the pair with each token's own Transfer, then
// calls the pair. The pair learns what it received from its balance of each token, less its
// reserve. It has no LP token: liquidity is counted per provider and cannot be transferred.
msg AmmMsg {
    #[selector = 1]
    Swap { amount0_out: u256, amount1_out: u256, to: Address },
    #[selector = 2]
    Quote { amount_in: u256, zero_for_one: bool } -> u256,
    #[selector = 3]
    Mint { to: Address } -> u256,
    #[selector = 4]
    Burn { amount: u256, to: Address } -> u256,
    #[selector = 5]
    Sync {},
    #[selector = 6]
    Reserve0 -> u256,
    #[selector = 7]
    Reserve1 -> u256,
    #[selector = 8]
    Supply -> u256,
    #[selector = 9]
    LiquidityOf { who: Address } -> u256,
}

// The variants of corpus/token.fe that the pair calls, with the selectors of ERC20.
msg Erc20 {
    #[selector = 0xa9059cbb]
    Transfer { to: Address, amount: u256 } -> bool,
    #[selector = 0x70a08231]
    BalanceOf { who: Address } -> u256,
}

// The reserves after each change, as a v2 pair's `Sync` event, with 256-bit reserves.
#[event]
struct Synced {
    reserve0: u256,
    reserve1: u256,
}

// The fee is 0.3%: a swap keeps FEE of every FEE_BASE parts of its input.
const FEE: u256 = 997
const FEE_BASE: u256 = 1000
// The liquidity that the first deposit locks for good, at the address 0.
const MINIMUM_LIQUIDITY: u256 = 1000

fn sqrt(_ x: u256) -> u256 {
    if x < 2 { return x }
    var r = x / 2 + 1
    var next = (r + x / r) / 2
    while next < r {
        r = next
        next = (r + x / r) / 2
    }
    r
}

fn min(_ a: u256, _ b: u256) -> u256 {
    if a < b { a } else { b }
}

// Returns what a swap of `amount_in` pays out of `reserve_out`, after the fee.
fn amount_out(_ amount_in: u256, _ reserve_in: u256, _ reserve_out: u256) -> u256 {
    assert!(amount_in > 0, "zero input")
    assert!(reserve_in > 0 && reserve_out > 0, "no liquidity")
    let with_fee = amount_in * FEE
    with_fee * reserve_out / (reserve_in * FEE_BASE + with_fee)
}

// Returns what a balance holds beyond `kept`, the part of the reserve left after a payout.
fn received(_ balance: u256, _ kept: u256) -> u256 {
    if balance > kept { balance - kept } else { 0 }
}

contract Amm uses (ctx: Ctx, call: mut Call, log: mut Log) {
    mut token0: Address,
    mut token1: Address,
    mut reserve0: u256,
    mut reserve1: u256,
    mut supply: u256,
    mut lp: StorageMap<Address, u256>,
    // Set while Swap, Mint, Burn or Sync runs, so that a token that calls back into the pair
    // then fails, as a v2 pair's `lock` does.
    mut locked: bool,

    init(t0: Address, t1: Address) uses (mut token0, mut token1) {
        assert!(t0 != t1, "same token")
        token0 = t0
        token1 = t1
    }

    recv AmmMsg {
        // Pays out first, then checks that what the trader sent makes up for it, after the fee.
        Swap { amount0_out, amount1_out, to } uses (
            ctx, mut call, mut log, token0, token1, mut reserve0, mut reserve1, mut locked,
        ) {
            assert!(!locked, "locked")
            locked = true
            assert!(amount0_out > 0 || amount1_out > 0, "zero output")
            assert!(amount0_out < reserve0 && amount1_out < reserve1, "no liquidity")
            if amount0_out > 0 {
                assert!(token0.call(Erc20::Transfer { to, amount: amount0_out }), "transfer failed")
            }
            if amount1_out > 0 {
                assert!(token1.call(Erc20::Transfer { to, amount: amount1_out }), "transfer failed")
            }
            let me = ctx.address()
            let balance0 = token0.call(Erc20::BalanceOf { who: me })
            let balance1 = token1.call(Erc20::BalanceOf { who: me })
            let in0 = received(balance0, reserve0 - amount0_out)
            let in1 = received(balance1, reserve1 - amount1_out)
            assert!(in0 > 0 || in1 > 0, "zero input")
            let adjusted0 = balance0 * FEE_BASE - in0 * (FEE_BASE - FEE)
            let adjusted1 = balance1 * FEE_BASE - in1 * (FEE_BASE - FEE)
            assert!(adjusted0 * adjusted1 >= reserve0 * reserve1 * FEE_BASE * FEE_BASE, "k")
            reserve0 = balance0
            reserve1 = balance1
            log.emit(Synced { reserve0, reserve1 })
            locked = false
        }
        Quote { amount_in, zero_for_one } -> u256 uses (reserve0, reserve1) {
            if zero_for_one {
                amount_out(amount_in, reserve0, reserve1)
            } else {
                amount_out(amount_in, reserve1, reserve0)
            }
        }
        // Gives `to` liquidity for what the provider sent. The first deposit sets the price.
        Mint { to } -> u256 uses (
            ctx, mut call, mut log, token0, token1, mut reserve0, mut reserve1, mut supply,
            mut lp, mut locked,
        ) {
            assert!(!locked, "locked")
            locked = true
            let me = ctx.address()
            let balance0 = token0.call(Erc20::BalanceOf { who: me })
            let balance1 = token1.call(Erc20::BalanceOf { who: me })
            let amount0 = received(balance0, reserve0)
            let amount1 = received(balance1, reserve1)
            var minted: u256 = 0
            if supply == 0 {
                minted = sqrt(amount0 * amount1)
                assert!(minted > MINIMUM_LIQUIDITY, "too little liquidity")
                minted -= MINIMUM_LIQUIDITY
                lp[Address::zero()] = MINIMUM_LIQUIDITY
                supply = MINIMUM_LIQUIDITY
            } else {
                minted = min(amount0 * supply / reserve0, amount1 * supply / reserve1)
            }
            assert!(minted > 0, "zero liquidity")
            lp[to] += minted
            supply += minted
            reserve0 = balance0
            reserve1 = balance1
            log.emit(Synced { reserve0, reserve1 })
            locked = false
            minted
        }
        // Burns `amount` of the caller's liquidity, and sends `to` its share of each token.
        // Returns the share of token 0.
        Burn { amount, to } -> u256 uses (
            ctx, mut call, mut log, token0, token1, mut reserve0, mut reserve1, mut supply,
            mut lp, mut locked,
        ) {
            assert!(!locked, "locked")
            locked = true
            let from = ctx.caller()
            assert!(amount <= lp[from], "too much liquidity")
            let me = ctx.address()
            let balance0 = token0.call(Erc20::BalanceOf { who: me })
            let balance1 = token1.call(Erc20::BalanceOf { who: me })
            let out0 = amount * balance0 / supply
            let out1 = amount * balance1 / supply
            assert!(out0 > 0 && out1 > 0, "zero output")
            lp[from] -= amount
            supply -= amount
            assert!(token0.call(Erc20::Transfer { to, amount: out0 }), "transfer failed")
            assert!(token1.call(Erc20::Transfer { to, amount: out1 }), "transfer failed")
            reserve0 = balance0 - out0
            reserve1 = balance1 - out1
            log.emit(Synced { reserve0, reserve1 })
            locked = false
            out0
        }
        // Sets the reserves to the balances, which takes in tokens sent without a call.
        Sync {} uses (
            ctx, mut call, mut log, token0, token1, mut reserve0, mut reserve1, mut locked,
        ) {
            assert!(!locked, "locked")
            locked = true
            let me = ctx.address()
            reserve0 = token0.call(Erc20::BalanceOf { who: me })
            reserve1 = token1.call(Erc20::BalanceOf { who: me })
            log.emit(Synced { reserve0, reserve1 })
            locked = false
        }
        Reserve0 {} -> u256 uses (reserve0) {
            reserve0
        }
        Reserve1 {} -> u256 uses (reserve1) {
            reserve1
        }
        Supply {} -> u256 uses (supply) {
            supply
        }
        LiquidityOf { who } -> u256 uses (lp) {
            lp[who]
        }
    }
}
