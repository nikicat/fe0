// Sums over ranges by loops, checked against their closed forms.
msg SumsMsg {
    #[selector = 1]
    Triangle { n: u256 } -> u256,
    #[selector = 2]
    Squares { n: u256 } -> u256,
    #[selector = 3]
    Check { n: u256 } -> bool,
    #[selector = 4]
    Table { n: u256 } -> u256,
}

fn triangle(_ n: u256) -> u256 {
    var s: u256 = 0
    var i: u256 = 1
    while i <= n {
        s += i
        i += 1
    }
    s
}

fn squares(_ n: u256) -> u256 {
    var s: u256 = 0
    var i: u256 = 1
    while i <= n {
        s += i * i
        i += 1
    }
    s
}

// The sum of i * j over a multiplication table of n by n, skipping the diagonal.
fn table(_ n: u256) -> u256 {
    var s: u256 = 0
    var i: u256 = 1
    while i <= n {
        var j: u256 = 0
        while true {
            j += 1
            if j > n { break }
            if i == j { continue }
            s += i * j
        }
        i += 1
    }
    s
}

contract Sums {
    recv SumsMsg {
        Triangle { n } -> u256 {
            triangle(n)
        }
        Squares { n } -> u256 {
            squares(n)
        }
        Check { n } -> bool {
            triangle(n) == n * (n + 1) / 2 && squares(n) == n * (n + 1) * (2 * n + 1) / 6
        }
        Table { n } -> u256 {
            table(n)
        }
    }
}
