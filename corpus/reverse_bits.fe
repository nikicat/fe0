// Bit and byte reversal of fixed widths.
msg ReverseBitsMsg {
    #[selector = 1]
    Bits { x: u256, width: u256 } -> u256,
    #[selector = 2]
    Bytes { x: u256 } -> u256,
}

// The low `width` bits of `x` in reverse order.
fn reverse_bits(_ x: u256, _ width: u256) -> u256 {
    assert!(width <= 256, "width")
    var r: u256 = 0
    var i: u256 = 0
    while i < width {
        r = r << 1 | (x >> i) & 1
        i += 1
    }
    r
}

fn reverse_bytes(_ x: u256) -> u256 {
    var r: u256 = 0
    var i: u256 = 0
    while i < 32 {
        r |= ((x >> (i * 8)) & 0xff) << ((31 - i) * 8)
        i += 1
    }
    r
}

contract ReverseBits {
    recv ReverseBitsMsg {
        Bits { x, width } -> u256 {
            reverse_bits(x, width)
        }
        Bytes { x } -> u256 {
            reverse_bytes(x)
        }
    }
}
