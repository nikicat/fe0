// Probe: keccak of data known only at run time, natively. With no arguments, the input is
// "answer()".
use std::env::Args
use std::io::Stdout

pub fn main() -> i32 uses (args: Args, stdout: mut Stdout) {
    var sig: [u8; 8] = [97, 110, 115, 119, 101, 114, 40, 41]
    sig[0] = (96 + args.count()).downcast_truncate()
    println!(core::text::hex(core::keccak(sig), 32))
    0
}
