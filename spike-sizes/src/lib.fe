// Probe contracts that measure the runtime bytecode size of fe0 up to each phase (task T0003).
// Each returns a count so that the phase is not optimized away.

use std::abi::{Bytes, sol}
use fe0::io::{Source, bytes}
use fe0::lexer::lex
use fe0::check::check
use fe0::codegen::compile
use fe0::parser::parse

pub msg ProbeMsg {
    #[selector = sol("run(bytes)")]
    Run { src: Bytes } -> u256,
}

pub contract LexProbe {
    recv ProbeMsg {
        Run { src } -> u256 {
            with (Source = bytes(src)) {
                lex().toks.len() as u256
            }
        }
    }
}

pub contract ParseProbe {
    recv ProbeMsg {
        Run { src } -> u256 {
            with (Source = bytes(src)) {
                parse().node_count() as u256
            }
        }
    }
}

pub contract EmptyProbe {
    recv ProbeMsg {
        Run { src } -> u256 {
            src.len() as u256
        }
    }
}

pub contract CheckProbe {
    recv ProbeMsg {
        Run { src } -> u256 {
            with (Source = bytes(src)) {
                check(parse()).node_count() as u256
            }
        }
    }
}

pub contract CompileProbe {
    recv ProbeMsg {
        Run { src } -> u256 {
            with (Source = bytes(src)) {
                compile().code.len() as u256
            }
        }
    }
}
