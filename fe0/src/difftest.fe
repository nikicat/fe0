// Support for differential tests, which build one program with Fe0 and with the official
// compiler and check that both builds behave the same. DESIGN.md §10 describes the harness.

use ingot::codegen::{Output, compile}
use ingot::diag::{Diag, E_NOT_IN_USES, diag}
use ingot::io::{Source, text}
use ingot::lexer::Pos
use std::abi::DynString
use std::evm::{Call, CallOutcome, Create, RawOps}

// The largest runtime code that a chain accepts (EIP-170). The test EVM does not enforce it.
const MAX_RUNTIME: u256 = 24576
// The largest create input (`Payload.initcode`) that a chain accepts (EIP-3860). The test EVM
// does not enforce this limit either.
const MAX_INITCODE: usize = 49152
// The gas for each call. Both builds get the same, so that only their code can differ.
const CALL_GAS: u256 = 10000000

// The panic codes below are a protocol with `Kind` in tools/fegen.py, which makes the case codes
// and decodes every code. Change both sides together.

// Added to a case code when Fe0's code is too large for a chain. It is `Kind.SIZE` less
// `Kind.CASE`.
const TOO_LARGE: u256 = 2 << 32
// The code of `rejects` when Fe0 accepts the program. It is `Kind.ACCEPTED`.
const ACCEPTED: u256 = 4 << 32
// The start of the panic codes of `same_code`. It is `Kind.CODE_DIFFERS`.
const CODE_DIFFERS: u256 = 5 << 32

// The panic code of one deployment or call of a differential test. tools/fegen.py makes it as
// `Kind.case_code`, in the CASE or the PROBE range.
pub struct CaseCode { code: u256 }

impl Copy for CaseCode {}

impl CaseCode {
    // Returns the case code `code`.
    pub fn new(_ code: u256) -> CaseCode {
        CaseCode { code }
    }

    // Returns the code for when a chain would not accept Fe0's build of this case.
    fn too_large(self) -> u256 {
        self.code + TOO_LARGE
    }
}

// Checks whether a chain accepts a create input of `initcode_len` bytes, and the runtime code
// that the create left at `runtime`.
fn fits_chain(initcode_len: usize, runtime: Address) -> bool uses (evm: Evm) {
    initcode_len <= MAX_INITCODE && evm.extcodesize(runtime) <= MAX_RUNTIME
}

// An error of Fe0 as one panic code: letter << 40 | number << 24 | offset. These are the ASCII
// code of the phase letter, the number within the phase and the byte offset, so E116 at offset 9
// is 0x45_0074_000009. `DiagWord` in tools/fegen.py packs and unpacks the same layout.
pub struct DiagWord { word: u256 }

impl Copy for DiagWord {}

impl core::ops::Eq for DiagWord {
    fn eq(self, _ other: DiagWord) -> bool {
        self.word == other.word
    }
}

impl DiagWord {
    // Returns the word that `DiagWord.pack` in tools/fegen.py gave as `word`.
    pub fn new(_ word: u256) -> DiagWord {
        DiagWord { word }
    }

    // Returns the word of `d`.
    pub fn of(_ d: Diag) -> DiagWord {
        let letter = d.code.letter() as u256
        let number = d.code.number() as u256
        DiagWord { word: letter << 40 | number << 24 | d.pos().offset() as u256 }
    }

    // Fails with Panic(`self`), which tools/fegen.py decodes as Fe0's error.
    pub fn fail(self) -> ! {
        core::panic_code(self.word)
    }
}

#[test]
fn diag_word_layout() {
    // The same example as `check_diag_word` in tools/fegen.py.
    let w = DiagWord::of(diag(E_NOT_IN_USES, Pos::at(9)))
    assert!(w == DiagWord::new(0x450074000009))
}

// Fe0's build of `s`.
pub fn compiled(_ s: own DynString) -> Output {
    with (Source = text(s)) {
        compile()
    }
}

// Fe0's deploy code for `s`. Fails with Panic(`DiagWord::of(d)`) when Fe0 rejects `s` with `d`.
pub fn ours(_ s: own DynString) -> MemVec<u8> {
    let out = compiled(s)
    match out.err {
        Option::Some(d) => DiagWord::of(d).fail(),
        Option::None => {},
    }
    out.code
}

// Checks that Fe0's deploy code for `s` is the code that `hex` spells in lowercase hex, as the
// native CLI prints it. Otherwise fails with Panic(`CODE_DIFFERS` plus the offset of the first
// byte that differs), or with Panic(`DiagWord`) when Fe0 rejects `s`.
pub fn same_code(_ s: own DynString, _ hex: DynString) {
    let code = ours(s)
    let want = core::text::decode_hex(hex).unwrap()
    var i: usize = 0
    while i < want.len() && i < code.len() {
        if code[i] != want.byte_at(i) {
            core::panic_code(CODE_DIFFERS + i as u256)
        }
        i += 1
    }
    if code.len() != want.len() {
        core::panic_code(CODE_DIFFERS + i as u256)
    }
}

// Checks that Fe0 rejects `s` with the error `expected`. Otherwise fails with Panic(`DiagWord`)
// of the error Fe0 gave, or Panic(`ACCEPTED`) when Fe0 accepted `s`.
pub fn rejects(_ s: own DynString, _ expected: DiagWord) {
    match compiled(s).err {
        Option::Some(d) => {
            let got = DiagWord::of(d)
            if got != expected {
                got.fail()
            }
        },
        Option::None => core::panic_code(ACCEPTED),
    }
}

// The official deploy code of a contract. It is the `len` bytes at `offset` in the code of the
// running test, as `C::init_code_offset()` and `C::init_code_len()` give them.
pub fn theirs(_ offset: u256, _ len: u256) -> MemVec<u8> uses (evm: mut Evm) {
    var buf = MemBuffer::new(len.downcast_unchecked())
    evm.codecopy(dest: mut buf, dest_offset: 0, src_offset: offset, len)
    var v: MemVec<u8> = MemVec::new()
    v.extend_from_slice(buf.span())
    v
}

// Bytes sent to a contract, as constructor arguments or as calldata, with a value in wei.
// `Payload.build` in tools/fegen.py writes the code that makes one.
pub struct Payload { data: MemVec<u8>, value: Wei }

impl Payload {
    // An empty payload that sends `value`.
    pub fn new(_ value: Wei) -> Payload {
        Payload { data: MemVec::new(), value }
    }

    pub fn push(mut self, _ b: u8) {
        self.data.push(b)
    }

    // Appends the 4-byte function selector `sel`.
    pub fn push_selector(mut self, _ sel: u32) {
        self.push_be(sel as u256, bytes: 4)
    }

    // Appends `w` as one 32-byte ABI word.
    pub fn push_word(mut self, _ w: u256) {
        self.push_be(w, bytes: 32)
    }

    // Appends the address of the test contract as one ABI word, in place of the address of a
    // node account (`fegen.Account`).
    pub fn push_sender(mut self) uses (evm: Evm) {
        self.push_word(evm.address().word())
    }

    // Appends the low `bytes` bytes of `x`, most significant first.
    fn push_be(mut self, _ x: u256, bytes: u256) {
        var i: u256 = 0
        while i < bytes {
            self.data.push(((x >> ((bytes - 1 - i) * 8)) & 0xff).downcast_truncate())
            i += 1
        }
    }

    // Returns the create input that deploys `code`, with these bytes as its constructor arguments.
    pub fn initcode(self, _ code: MemVec<u8>) -> MemArray<u8> {
        var v: MemVec<u8> = MemVec::new()
        v.extend_from_slice(code.as_slice())
        v.extend_from_slice(self.data.as_slice())
        v.into_array()
    }
}

// The deploy codes of one program from both compilers.
pub struct Builds { pub ours: MemVec<u8>, pub theirs: MemVec<u8> }

impl Builds {
    // Deploys both builds with the constructor arguments `args`. Fails with Panic(`case`) when
    // only one build creates a contract, and with Panic(`case.too_large()`) when a chain would
    // not accept Fe0's build (`fits_chain`).
    pub fn deploy(self, _ args: Payload, _ case: CaseCode) -> Deployed
    uses (evm: mut Evm)
    {
        let ours = args.initcode(self.ours)
        let theirs = args.initcode(self.theirs)
        let p = Deployed { ours: create(ours, args.value), theirs: create(theirs, args.value) }
        if (p.ours.word() == 0) != (p.theirs.word() == 0) {
            core::panic_code(case.code)
        }
        if !fits_chain(initcode_len: ours.len(), runtime: p.ours) {
            core::panic_code(case.too_large())
        }
        p
    }

    // Deploys both builds as `deploy` does. Also fails with Panic(`case`) when neither creates
    // a contract.
    pub fn deploy_main(self, _ args: Payload, _ case: CaseCode) -> Deployed
    uses (evm: mut Evm)
    {
        let p = self.deploy(args, case)
        if p.ours.word() == 0 {
            core::panic_code(case.code)
        }
        p
    }
}

// Creates a contract from the create input `initcode` and sends it `value`.
fn create(_ initcode: MemArray<u8>, _ value: Wei) -> Address
uses (evm: mut Evm)
{
    evm.create_raw(value, init_code: initcode.span())
}

// One program deployed from both builds.
pub struct Deployed { pub ours: Address, pub theirs: Address }

impl Deployed {
    // Calls both contracts with `calldata`. Fails with Panic(`case`) unless the success flags
    // and the return data are the same.
    pub fn call(self, _ calldata: own Payload, _ case: CaseCode) uses (evm: mut Evm) {
        let value = calldata.value
        let args = calldata.data.into_array()
        let a = evm.try_call_raw(addr: self.ours, gas: CALL_GAS, value, args: args.span())
        let b = evm.try_call_raw(addr: self.theirs, gas: CALL_GAS, value, args: args.span())
        if !same_outcome(a, b) {
            core::panic_code(case.code)
        }
    }
}

// Checks whether both calls succeeded or both failed, with the same return data.
fn same_outcome(_ a: CallOutcome, _ b: CallOutcome) -> bool {
    if a.success() != b.success() || a.returndata_len() != b.returndata_len() {
        return false
    }
    var i: usize = 0
    while i < a.returndata_len() {
        if a.returndata().byte_at(i) != b.returndata().byte_at(i) {
            return false
        }
        i += 1
    }
    true
}
