// The AST: an arena of nodes that refer to each other by index. ADR 0005 says why.
//
// A node is built by its kind's `Node::new_` constructor, or by `Node::leaf` for a kind with no
// slots. It is read through the accessors after `impl Node`. The comment on each kind below names
// the accessors that apply to it. A list is read with `Ast.list_len` and `Ast.list_at`.
//
// Some kinds are read through a typed view, such as `as_let()`. ADR 0005 says which.

use ingot::diag::Diag
use ingot::lexer::{
    ABI_ADDRESS,
    ABI_BOOL,
    ABI_UINT256,
    Pos,
    SOURCE_START,
    Span,
    Spelling,
    T_EOF,
    Text,
    Tok,
    Token,
}
use ingot::wire::{Reader, Wire, Writer}

// The kind of a node. The NODE_ constants below are its only values.
pub struct Kind { code: u8 }

impl Copy for Kind {}

impl core::ops::Eq for Kind {
    fn eq(self, _ other: Kind) -> bool {
        self.code == other.code
    }
}

impl Kind {
    // Returns the code that carries this kind across a phase boundary (`wire.fe`).
    pub fn wire(self) -> usize {
        self.code as usize
    }

    // Returns the kind whose `wire()` is `w`.
    pub fn from_wire(_ w: usize) -> Kind {
        Kind { code: w.downcast_truncate() }
    }

    // Whether nodes of this kind are expressions, which have a value.
    pub fn is_expr(self) -> bool {
        self.code >= NODE_INT.code
    }

    // Checks whether nodes of this kind can be assigned to (SPEC.md §3.1, rule `place`).
    pub fn is_place(self) -> bool {
        self == NODE_NAME || self == NODE_INDEX
    }
}

// The sentinel at index 0.
pub const NODE_NONE: Kind = Kind { code: 0 }

// Items and their parts.
// const: name, ty, value.
pub const NODE_CONST: Kind = Kind { code: 1 }
// fn: name, ty (the return type), list of PARAMs, body BLOCK.
pub const NODE_FN: Kind = Kind { code: 2 }
// param: name, ty, and `as_param()` for is_positional.
pub const NODE_PARAM: Kind = Kind { code: 3 }
// msg: name, list of VARIANTs.
pub const NODE_MSG: Kind = Kind { code: 4 }
// variant: name, ty (the return type), word (the selector), list of FIELDs.
pub const NODE_VARIANT: Kind = Kind { code: 5 }
// field of a variant, a contract or an event: name, ty, and `as_field()` for is_indexed. An
// effect of a contract, such as `ctx: Ctx`, is a contract field of an effect type (Ty.is_effect),
// so that `uses` grants it as it grants a storage field.
pub const NODE_FIELD: Kind = Kind { code: 6 }
// contract: name, list of FIELDs (its effects first), and `as_contract()` for init and recvs
// (a list of RECVs).
pub const NODE_CONTRACT: Kind = Kind { code: 7 }
// init: list of PARAMs, use_list (a list of USEs), body BLOCK.
pub const NODE_INIT: Kind = Kind { code: 8 }
// recv: name (of the msg), list of ARMs.
pub const NODE_RECV: Kind = Kind { code: 9 }
// arm: name (of the variant), ty (the return type), list of BINDs, use_list, body BLOCK.
pub const NODE_ARM: Kind = Kind { code: 10 }
// bind: name (of the field), local (the same sym as name when written `{ x }`).
pub const NODE_BIND: Kind = Kind { code: 11 }
// one entry of `uses (...)`: name (of the field), and `as_use()` for is_mut.
pub const NODE_USE: Kind = Kind { code: 12 }
// string literal: word (its bytes as a `StrValue.word`), and `as_str()` for its len.
pub const NODE_STR: Kind = Kind { code: 13 }
// `#[event] struct`: name, list of FIELDs.
pub const NODE_EVENT: Kind = Kind { code: 14 }

// Statements.
// let or var. One kind serves both (ADR 0013). Read it through `as_let()`.
pub const NODE_LET: Kind = Kind { code: 20 }
// while: cond, body BLOCK.
pub const NODE_WHILE: Kind = Kind { code: 21 }
// return: value or NO_NODE.
pub const NODE_RETURN: Kind = Kind { code: 22 }
pub const NODE_BREAK: Kind = Kind { code: 23 }
pub const NODE_CONTINUE: Kind = Kind { code: 24 }
// `x = e`, `x op= e`, `m[k] = e` or `m[k] op= e`: place (the target, a NAME or an INDEX), op
// (O_ASSIGN or an A_ kind), value.
pub const NODE_ASSIGN: Kind = Kind { code: 25 }

// Expressions. Any expression node may also appear in a statement list.
// Expressions are the last group of kinds, and is_expr relies on it.
// Give a new kind of any other group a code below NODE_INT.
// integer literal: word.
pub const NODE_INT: Kind = Kind { code: 40 }
// `true` or `false`: `as_bool()` for is_true.
pub const NODE_BOOL: Kind = Kind { code: 41 }
// a name of a local, parameter, constant or field: name.
pub const NODE_NAME: Kind = Kind { code: 42 }
// binary operator: op (an O_ kind), lhs, rhs.
pub const NODE_BINARY: Kind = Kind { code: 43 }
// `!`, `~` or `+`: op (O_BANG, O_TILDE or O_PLUS), operand.
pub const NODE_UNARY: Kind = Kind { code: 44 }
// call: name (of the callee), list of ARGs.
pub const NODE_CALL: Kind = Kind { code: 45 }
// argument: name (the label, or NO_SYM), value. Read it through `Ast.arg`.
pub const NODE_ARG: Kind = Kind { code: 46 }
// if: cond, body (the then BLOCK), otherwise (the else BLOCK, IF or NO_NODE).
pub const NODE_IF: Kind = Kind { code: 47 }
// block: list of statements, value (the tail expression, or NO_NODE).
pub const NODE_BLOCK: Kind = Kind { code: 48 }
// `assert!`: cond, message (a STR or NO_NODE).
pub const NODE_ASSERT: Kind = Kind { code: 49 }
// `ctx.m()`, a method of a Ctx effect: name (the effect), method (m).
pub const NODE_CTX_READ: Kind = Kind { code: 50 }
// `Address::zero()`, with no slots.
pub const NODE_ZERO_ADDRESS: Kind = Kind { code: 51 }
// an entry of a map, `m[k]`: name (the map), and `as_index()` for key.
pub const NODE_INDEX: Kind = Kind { code: 52 }
// `log.emit(E { f: e, … })`: name (the effect), event (the event's name), list of ARGs, each
// labelled with a field of the event.
pub const NODE_EMIT: Kind = Kind { code: 53 }
// `a.call(M::V { f: e, … })`: target (the NAME of the address), list of ARGs, each labelled with
// a field of the variant, and `as_msg_call()` for msg_name (M) and variant (V).
pub const NODE_MSG_CALL: Kind = Kind { code: 54 }
// A type. A node's ty() holds one written in the source, or TY_NONE when none is written.
// The checker also uses TY_UNIT, TY_NEVER and TY_INT.
pub struct Ty { code: u8 }

impl Copy for Ty {}

impl Wire for Ty {
    fn put(self, _ w: mut Writer) {
        self.wire().put(mut w)
    }

    fn take(_ r: mut Reader) -> Ty {
        Ty::from_wire(usize::take(mut r))
    }
}

impl core::ops::Eq for Ty {
    fn eq(self, _ other: Ty) -> bool {
        self.code == other.code
    }
}

pub const TY_NONE: Ty = Ty { code: 0 }
pub const TY_U256: Ty = Ty { code: 1 }
pub const TY_BOOL: Ty = Ty { code: 2 }
pub const TY_ADDRESS: Ty = Ty { code: 3 }
// The type of an expression that has no value.
pub const TY_UNIT: Ty = Ty { code: 4 }
// The type of an expression that never completes.
pub const TY_NEVER: Ty = Ty { code: 5 }
// The type of an integer expression made only of literals, operators, if-expressions and
// blocks, such as `1 + 2` or `{ 1 }`.
pub const TY_INT: Ty = Ty { code: 6 }

// The codes from TY_CTX on are the types of names that are not values, and is_value relies on
// it. Give a new value type a code below TY_CTX. The codes from TY_CTX up to MAP_BASE are the
// effect types, and is_effect relies on it.
// The types of a contract's effects, `Ctx`, `mut Log` and `mut Call`. Only an effect has one.
pub const TY_CTX: Ty = Ty { code: 7 }
pub const TY_LOG: Ty = Ty { code: 8 }
pub const TY_CALL: Ty = Ty { code: 9 }
// The code of the first map type. Its low four bits are zero, to hold the key and value codes.
const MAP_BASE: u8 = 16
// The shift of the key code within a map code.
const MAP_KEY_SHIFT: u8 = 2
// The mask of the key or value code, after the shift.
const MAP_PART: u8 = 3

impl Ty {
    // Returns the code that carries this type across a phase boundary (`wire.fe`).
    pub fn wire(self) -> usize {
        self.code as usize
    }

    // Returns the type whose `wire()` is `w`.
    pub fn from_wire(_ w: usize) -> Ty {
        Ty { code: w.downcast_truncate() }
    }

    // Whether an expression of this type may stand where `want` is expected.
    // TY_NEVER fits any type, and TY_INT fits TY_U256.
    pub fn fits(self, _ want: Ty) -> bool {
        self == want || self == TY_NEVER || (self == TY_INT && want == TY_U256)
    }

    // Returns this written type, or TY_UNIT when none is written.
    pub fn or_unit(self) -> Ty {
        if self == TY_NONE { TY_UNIT } else { self }
    }

    // Returns this type, or TY_U256 when it is TY_INT.
    pub fn or_u256(self) -> Ty {
        if self == TY_INT { TY_U256 } else { self }
    }

    // Returns the type `StorageMap<key, value>`. Each of `key` and `value` is TY_U256, TY_BOOL
    // or TY_ADDRESS, so its code fits in two bits.
    pub fn map(_ key: Ty, _ value: Ty) -> Ty {
        Ty { code: MAP_BASE | (key.code << MAP_KEY_SHIFT) | value.code }
    }

    // Checks whether this is a map type.
    pub fn is_map(self) -> bool {
        self.code >= MAP_BASE
    }

    // Returns the key type of map type `self`.
    pub fn map_key(self) -> Ty {
        Ty { code: (self.code >> MAP_KEY_SHIFT) & MAP_PART }
    }

    // Returns the value type of map type `self`.
    pub fn map_value(self) -> Ty {
        Ty { code: self.code & MAP_PART }
    }

    // Checks whether a name of this type is a value. An effect and a map are not, and neither is
    // a name with no type, such as a function's.
    pub fn is_value(self) -> bool {
        self != TY_NONE && self.code < TY_CTX.code
    }

    // Returns the Solidity name of value type `self`, such as `uint256` for TY_U256.
    pub fn abi_name(self) -> Spelling {
        if self == TY_U256 {
            return ABI_UINT256
        }
        if self == TY_BOOL {
            return ABI_BOOL
        }
        ABI_ADDRESS
    }

    // Checks whether this is the type of an effect of a contract, such as `Ctx` or `Log`.
    pub fn is_effect(self) -> bool {
        self.code >= TY_CTX.code && self.code < MAP_BASE
    }

    // Returns the number of bytes that a contract field of this type takes in storage (SPEC §6).
    // An effect takes none. A map takes a whole slot.
    pub fn storage_bytes(self) -> usize {
        if self.is_effect() {
            return 0
        }
        if self == TY_BOOL {
            return 1
        }
        if self == TY_ADDRESS {
            return 20
        }
        32
    }
}

// Each accessor reads one fixed slot, and no kind uses two accessors of the same slot. The
// slots stay private to this file. Only the constructors and `Ast.set_else` write them.
pub struct Node {
    pub kind: Kind,
    // A plain offset, not a Pos, because a nested struct field costs bytecode (argotorg/fe#1964,
    // see docs/WORKAROUNDS.md).
    pos_off: usize,
    op: Tok,
    ty: Ty,
    a: usize,
    b: usize,
    c: usize,
    d: usize,
}

impl Copy for Node {}

impl Wire for Node {
    fn put(self, _ w: mut Writer) {
        w.lanes(
            self.kind.wire(),
            self.pos_off,
            self.op.wire(),
            self.ty.wire(),
        )
        w.lanes(self.a, self.b, self.c, self.d)
    }

    fn take(_ r: mut Reader) -> Node {
        let h = r.lanes()
        let l = r.lanes()
        Node::new(
            Kind::from_wire(h.a()),
            Pos::at(h.b()),
            op: Tok::from_wire(h.c()),
            ty: Ty::from_wire(h.d()),
            a: l.a(),
            b: l.b(),
            c: l.c(),
            d: l.d(),
        )
    }
}

// Returns 1 for `true` and 0 for `false`, the value a flag slot, a wire lane or an EVM word holds.
// The node constructors take labeled `bool`s rather than a type per flag, because Fe makes each
// call spell the label and a flag type costs bytecode (ADR 0013).
pub fn flag<T: Bit>(_ b: bool) -> T {
    T::of(b)
}

pub trait Bit {
    fn of(_ b: bool) -> Self
}

impl Bit for usize {
    fn of(_ b: bool) -> usize {
        if b { 1 } else { 0 }
    }
}

impl Bit for u256 {
    fn of(_ b: bool) -> u256 {
        if b { 1 } else { 0 }
    }
}

// Returns the `bool` that `flag` turned into `v`.
pub fn is_flag(_ v: usize) -> bool {
    v == 1
}

impl Node {
    // smell: repeats the rule of `is_flag`. Kept, because calling it made the Checker 65 bytes
    // larger (Fe 26.7.0, -O s). Fix when a release inlines it.
    fn flag_set(self) -> bool {
        self.d == 1
    }

    // Returns a node of `kind` at `pos` with every other field empty: the sentinel, `break` and
    // `continue`.
    pub fn leaf(_ kind: Kind, _ pos: Pos) -> Node {
        Node::new(kind, pos, op: T_EOF, ty: TY_NONE, a: 0, b: 0, c: 0, d: 0)
    }

    fn make(_ kind: Kind, _ pos: Pos, a: usize, b: usize, c: usize, d: usize) -> Node {
        Node::new(kind, pos, op: T_EOF, ty: TY_NONE, a, b, c, d)
    }

    fn typed(_ kind: Kind, _ pos: Pos, ty: Ty, a: usize, b: usize, c: usize, d: usize) -> Node {
        Node::new(kind, pos, op: T_EOF, ty, a, b, c, d)
    }

    // Every other constructor ends here, so this is the one place that writes the struct.
    fn new(
        _ kind: Kind,
        _ pos: Pos,
        op: Tok,
        ty: Ty,
        a: usize,
        b: usize,
        c: usize,
        d: usize,
    ) -> Node {
        Node { kind, pos_off: pos.offset(), op, ty, a, b, c, d }
    }

    pub fn new_const(_ pos: Pos, name: Sym, ty: Ty, value: NodeId) -> Node {
        Node::typed(NODE_CONST, pos, ty, a: name.id, b: value.id, c: 0, d: 0)
    }

    pub fn new_fn(_ pos: Pos, name: Sym, params: ListId, ret: Ty, body: NodeId) -> Node {
        Node::typed(
            NODE_FN,
            pos,
            ty: ret,
            a: name.id,
            b: 0,
            c: params.id,
            d: body.id,
        )
    }

    pub fn new_param(_ pos: Pos, name: Sym, ty: Ty, positional: bool) -> Node {
        Node::typed(
            NODE_PARAM,
            pos,
            ty,
            a: name.id,
            b: 0,
            c: 0,
            d: flag(positional),
        )
    }

    pub fn new_msg(_ pos: Pos, name: Sym, variants: ListId) -> Node {
        Node::make(NODE_MSG, pos, a: name.id, b: 0, c: variants.id, d: 0)
    }

    pub fn new_variant(_ pos: Pos, name: Sym, selector: WordId, fields: ListId, ret: Ty) -> Node {
        Node::typed(
            NODE_VARIANT,
            pos,
            ty: ret,
            a: name.id,
            b: selector.id,
            c: fields.id,
            d: 0,
        )
    }

    pub fn new_field(_ pos: Pos, name: Sym, ty: Ty, indexed: bool) -> Node {
        Node::typed(
            NODE_FIELD,
            pos,
            ty,
            a: name.id,
            b: 0,
            c: 0,
            d: flag(indexed),
        )
    }

    pub fn new_event(_ pos: Pos, name: Sym, fields: ListId) -> Node {
        Node::make(NODE_EVENT, pos, a: name.id, b: 0, c: fields.id, d: 0)
    }

    pub fn new_contract(
        _ pos: Pos,
        name: Sym,
        fields: ListId,
        init: NodeId,
        recvs: ListId,
    ) -> Node {
        Node::make(
            NODE_CONTRACT,
            pos,
            a: name.id,
            b: recvs.id,
            c: fields.id,
            d: init.id,
        )
    }

    pub fn new_init(_ pos: Pos, params: ListId, use_list: ListId, body: NodeId) -> Node {
        Node::make(
            NODE_INIT,
            pos,
            a: 0,
            b: use_list.id,
            c: params.id,
            d: body.id,
        )
    }

    pub fn new_recv(_ pos: Pos, name: Sym, arms: ListId) -> Node {
        Node::make(NODE_RECV, pos, a: name.id, b: 0, c: arms.id, d: 0)
    }

    pub fn new_arm(
        _ pos: Pos,
        variant: Sym,
        binds: ListId,
        ret: Ty,
        use_list: ListId,
        body: NodeId,
    ) -> Node {
        Node::typed(
            NODE_ARM,
            pos,
            ty: ret,
            a: variant.id,
            b: use_list.id,
            c: binds.id,
            d: body.id,
        )
    }

    pub fn new_bind(_ pos: Pos, field: Sym, local: Sym) -> Node {
        Node::make(NODE_BIND, pos, a: field.id, b: local.id, c: 0, d: 0)
    }

    pub fn new_use(_ pos: Pos, field: Sym, mutable: bool) -> Node {
        Node::make(NODE_USE, pos, a: field.id, b: 0, c: 0, d: flag(mutable))
    }

    pub fn new_str(_ pos: Pos, word: WordId, len: usize) -> Node {
        Node::make(NODE_STR, pos, a: 0, b: word.id, c: 0, d: len)
    }

    pub fn new_let(_ pos: Pos, name: Sym, ty: Ty, value: NodeId, mutable: bool) -> Node {
        Node::typed(
            NODE_LET,
            pos,
            ty,
            a: name.id,
            b: value.id,
            c: 0,
            d: flag(mutable),
        )
    }

    pub fn new_while(_ pos: Pos, cond: NodeId, body: NodeId) -> Node {
        Node::make(NODE_WHILE, pos, a: cond.id, b: 0, c: 0, d: body.id)
    }

    pub fn new_return(_ pos: Pos, value: NodeId) -> Node {
        Node::make(NODE_RETURN, pos, a: 0, b: value.id, c: 0, d: 0)
    }

    pub fn new_assign(_ pos: Pos, place: NodeId, op: Tok, value: NodeId) -> Node {
        Node::new(
            NODE_ASSIGN,
            pos,
            op,
            ty: TY_NONE,
            a: place.id,
            b: value.id,
            c: 0,
            d: 0,
        )
    }

    pub fn new_int(_ pos: Pos, word: WordId) -> Node {
        Node::make(NODE_INT, pos, a: 0, b: word.id, c: 0, d: 0)
    }

    pub fn new_bool(_ pos: Pos, value: bool) -> Node {
        Node::make(NODE_BOOL, pos, a: 0, b: 0, c: 0, d: flag(value))
    }

    pub fn new_name(_ pos: Pos, name: Sym) -> Node {
        Node::make(NODE_NAME, pos, a: name.id, b: 0, c: 0, d: 0)
    }

    pub fn new_binary(_ pos: Pos, op: Tok, lhs: NodeId, rhs: NodeId) -> Node {
        Node::new(
            NODE_BINARY,
            pos,
            op,
            ty: TY_NONE,
            a: lhs.id,
            b: rhs.id,
            c: 0,
            d: 0,
        )
    }

    pub fn new_unary(_ pos: Pos, op: Tok, operand: NodeId) -> Node {
        Node::new(
            NODE_UNARY,
            pos,
            op,
            ty: TY_NONE,
            a: operand.id,
            b: 0,
            c: 0,
            d: 0,
        )
    }

    pub fn new_call(_ pos: Pos, name: Sym, args: ListId) -> Node {
        Node::make(NODE_CALL, pos, a: name.id, b: 0, c: args.id, d: 0)
    }

    pub fn new_arg(_ pos: Pos, label: Sym, value: NodeId) -> Node {
        Node::make(NODE_ARG, pos, a: label.id, b: value.id, c: 0, d: 0)
    }

    // An IF without its else branch, which `Ast.set_else` adds.
    pub fn new_if(_ pos: Pos, cond: NodeId, then: NodeId) -> Node {
        Node::make(NODE_IF, pos, a: cond.id, b: 0, c: 0, d: then.id)
    }

    pub fn new_block(_ pos: Pos, stmts: ListId, tail: NodeId) -> Node {
        Node::make(NODE_BLOCK, pos, a: 0, b: tail.id, c: stmts.id, d: 0)
    }

    pub fn new_assert(_ pos: Pos, cond: NodeId, message: NodeId) -> Node {
        Node::make(NODE_ASSERT, pos, a: cond.id, b: message.id, c: 0, d: 0)
    }

    pub fn new_ctx_read(_ pos: Pos, effect: Sym, method: Sym) -> Node {
        Node::make(NODE_CTX_READ, pos, a: effect.id, b: method.id, c: 0, d: 0)
    }

    pub fn new_zero_address(_ pos: Pos) -> Node {
        Node::make(NODE_ZERO_ADDRESS, pos, a: 0, b: 0, c: 0, d: 0)
    }

    pub fn new_index(_ pos: Pos, map: Sym, key: NodeId) -> Node {
        Node::make(NODE_INDEX, pos, a: map.id, b: 0, c: 0, d: key.id)
    }

    pub fn new_emit(_ pos: Pos, effect: Sym, event: Sym, args: ListId) -> Node {
        Node::make(
            NODE_EMIT,
            pos,
            a: effect.id,
            b: event.id,
            c: args.id,
            d: 0,
        )
    }

    pub fn new_msg_call(
        _ pos: Pos,
        target: NodeId,
        msg_name: Sym,
        variant: Sym,
        args: ListId,
    ) -> Node {
        Node::make(
            NODE_MSG_CALL,
            pos,
            a: target.id,
            b: msg_name.id,
            c: args.id,
            d: variant.id,
        )
    }

    // Returns the position of the token that diagnostics about the node point at.
    pub fn pos(self) -> Pos {
        Pos::at(self.pos_off)
    }

    pub fn op(self) -> Tok {
        self.op
    }
    pub fn ty(self) -> Ty {
        self.ty
    }

    pub fn name(self) -> Sym {
        Sym { id: self.a }
    }
    pub fn cond(self) -> NodeId {
        NodeId { id: self.a }
    }
    pub fn lhs(self) -> NodeId {
        NodeId { id: self.a }
    }
    pub fn operand(self) -> NodeId {
        NodeId { id: self.a }
    }
    pub fn place(self) -> NodeId {
        NodeId { id: self.a }
    }
    pub fn target(self) -> NodeId {
        NodeId { id: self.a }
    }

    pub fn value(self) -> NodeId {
        NodeId { id: self.b }
    }
    pub fn rhs(self) -> NodeId {
        NodeId { id: self.b }
    }
    pub fn word(self) -> WordId {
        WordId { id: self.b }
    }
    pub fn local(self) -> Sym {
        Sym { id: self.b }
    }
    pub fn event(self) -> Sym {
        Sym { id: self.b }
    }
    pub fn method(self) -> Sym {
        Sym { id: self.b }
    }
    pub fn use_list(self) -> ListId {
        ListId { id: self.b }
    }
    pub fn otherwise(self) -> NodeId {
        NodeId { id: self.b }
    }
    pub fn message(self) -> NodeId {
        NodeId { id: self.b }
    }

    pub fn list(self) -> ListId {
        ListId { id: self.c }
    }

    pub fn body(self) -> NodeId {
        NodeId { id: self.d }
    }
    // An `as_` view does not check the node's kind (ADR 0005). On a node of another kind, its
    // accessors return that kind's slot values.
    pub fn as_let(self) -> LetNode {
        LetNode { n: self }
    }
    pub fn as_param(self) -> ParamNode {
        ParamNode { n: self }
    }
    pub fn as_field(self) -> FieldNode {
        FieldNode { n: self }
    }
    pub fn as_use(self) -> UseNode {
        UseNode { n: self }
    }
    pub fn as_bool(self) -> BoolNode {
        BoolNode { n: self }
    }
    pub fn as_str(self) -> StrNode {
        StrNode { n: self }
    }
    pub fn as_contract(self) -> ContractNode {
        ContractNode { n: self }
    }
    pub fn as_index(self) -> IndexNode {
        IndexNode { n: self }
    }
    pub fn as_msg_call(self) -> MsgCallNode {
        MsgCallNode { n: self }
    }
}

pub struct LetNode { n: Node }

impl Copy for LetNode {}

impl LetNode {
    pub fn name(self) -> Sym {
        self.n.name()
    }
    pub fn ty(self) -> Ty {
        self.n.ty()
    }
    pub fn value(self) -> NodeId {
        self.n.value()
    }
    pub fn is_var(self) -> bool {
        self.n.flag_set()
    }
}

pub struct ParamNode { n: Node }

impl Copy for ParamNode {}

impl ParamNode {
    pub fn name(self) -> Sym {
        self.n.name()
    }
    pub fn ty(self) -> Ty {
        self.n.ty()
    }
    // Checks whether the parameter is written `_ name`, so that its argument takes no label
    // (SPEC §5.4).
    pub fn is_positional(self) -> bool {
        self.n.flag_set()
    }
}

pub struct FieldNode { n: Node }

impl Copy for FieldNode {}

impl FieldNode {
    // Checks whether the field is marked `#[indexed]`. Only an event's field can be (SPEC §3.1,
    // rule `efield`).
    pub fn is_indexed(self) -> bool {
        self.n.flag_set()
    }
}

pub struct UseNode { n: Node }

impl Copy for UseNode {}

impl UseNode {
    pub fn is_mut(self) -> bool {
        self.n.flag_set()
    }
}

pub struct BoolNode { n: Node }

impl Copy for BoolNode {}

impl BoolNode {
    pub fn is_true(self) -> bool {
        self.n.flag_set()
    }
    // Returns the literal as a word, 1 for `true` and 0 for `false` (SPEC §6).
    pub fn word(self) -> u256 {
        self.n.d as u256
    }
}

pub struct StrNode { n: Node }

impl Copy for StrNode {}

impl StrNode {
    // Returns the length of the string in bytes, after its escapes are decoded.
    pub fn len(self) -> usize {
        self.n.d
    }
}

pub struct ContractNode { n: Node }

impl Copy for ContractNode {}

impl ContractNode {
    // Returns the INIT node, or NO_NODE when the contract has none.
    pub fn init(self) -> NodeId {
        NodeId { id: self.n.d }
    }
    pub fn recvs(self) -> ListId {
        ListId { id: self.n.b }
    }
}

pub struct IndexNode { n: Node }

impl Copy for IndexNode {}

impl IndexNode {
    pub fn key(self) -> NodeId {
        NodeId { id: self.n.d }
    }
}

pub struct MsgCallNode { n: Node }

impl Copy for MsgCallNode {}

impl MsgCallNode {
    pub fn msg_name(self) -> Sym {
        Sym { id: self.n.b }
    }
    pub fn variant(self) -> Sym {
        Sym { id: self.n.d }
    }
}

// The typed view of an ARG node. It holds the node of the value too, because the label rule
// reads it (SPEC §5.4).
pub struct ArgNode { n: Node, value_node: Node }

impl Copy for ArgNode {}

impl ArgNode {
    pub fn value(self) -> NodeId {
        self.n.value()
    }

    // Returns the label. An argument without a label whose value is a name has that name as its
    // label, as `{ x }` stands for `{ x: x }`.
    pub fn label(self) -> Sym {
        if self.n.name() == NO_SYM && self.value_node.kind == NODE_NAME {
            return self.value_node.name()
        }
        self.n.name()
    }

    // Checks whether the argument has the label that parameter `param` asks for.
    pub fn fits(self, _ param: ParamNode) -> bool {
        if param.is_positional() {
            return self.n.name() == NO_SYM
        }
        self.label() == param.name()
    }
}

// An interned identifier: an index into `Ast.syms`. NO_SYM, index 0, is no name.
pub struct Sym { id: usize }

impl Copy for Sym {}

impl core::ops::Eq for Sym {
    fn eq(self, _ other: Sym) -> bool {
        self.id == other.id
    }
}

pub const NO_SYM: Sym = Sym { id: 0 }

// A node in `Ast.nodes`. NO_NODE, node 0, is the sentinel and stands for no node.
pub struct NodeId { id: usize }

impl Copy for NodeId {}

// An AST crosses without its source text. Ast::take_with gets the text back from its caller.
// Ast::take gives an AST with no source text.
impl Wire for Ast {
    fn put(self, _ w: mut Writer) {
        self.nodes.put(mut w)
        self.lists.put(mut w)
        self.syms.put(mut w)
        self.words.put(mut w)
        self.items.put(mut w)
    }

    fn take(_ r: mut Reader) -> Ast {
        Ast::take_with(Text::new(), mut r)
    }
}

impl Wire for NodeId {
    fn put(self, _ w: mut Writer) {
        self.id.put(mut w)
    }

    fn take(_ r: mut Reader) -> NodeId {
        NodeId { id: usize::take(mut r) }
    }
}

impl core::ops::Eq for NodeId {
    fn eq(self, _ other: NodeId) -> bool {
        self.id == other.id
    }
}

impl NodeId {
    // Checks whether this is NO_NODE.
    pub fn is_none(self) -> bool {
        self.id == 0
    }

    // Returns the index, for the side tables that keep one entry per node.
    pub fn index(self) -> usize {
        self.id
    }
}

pub const NO_NODE: NodeId = NodeId { id: 0 }

// A list of nodes in `Ast.lists`. EMPTY_LIST, list 0, has no elements.
pub struct ListId { id: usize }

impl Copy for ListId {}

impl Wire for ListId {
    fn put(self, _ w: mut Writer) {
        self.id.put(mut w)
    }

    fn take(_ r: mut Reader) -> ListId {
        ListId { id: usize::take(mut r) }
    }
}

pub const EMPTY_LIST: ListId = ListId { id: 0 }

// Where a list's elements begin on the parser's stack of pending elements.
pub struct ListMark { at: usize }

impl Copy for ListMark {}

impl ListMark {
    // Marks the end of `pending`: the elements pushed after this begin the next list.
    pub fn end_of(_ pending: MemVec<NodeId>) -> ListMark {
        ListMark { at: pending.len() }
    }
}

// An index into `Ast.words`.
pub struct WordId { id: usize }

impl Copy for WordId {}

impl WordId {
    // Returns word `index`. With `index()`, this lets a compact table keep a WordId as a plain
    // number.
    pub fn at(_ index: usize) -> WordId {
        WordId { id: index }
    }

    // Returns the index of the word.
    pub fn index(self) -> usize {
        self.id
    }
}

// The parsed program. On error, the arrays hold whatever was built before it. This is not a
// `Result`, because moving an `Ast` through one costs bytecode (ADR 0011).
pub struct Ast {
    pub text: Text,
    nodes: MemVec<Node>,
    // Each list as its length, then its NodeIds. Typed vectors cost 280 bytes (WORKAROUNDS.md).
    lists: MemVec<usize>,
    // The source span of each distinct identifier.
    pub syms: MemVec<Span>,
    // The 256-bit values that nodes refer to, each by its WordId. The checker adds constant values
    // and the topic 0 of each event.
    words: MemVec<u256>,
    // The list of items.
    pub items: ListId,
    // The lexer's or the parser's error.
    pub err: Option<Diag>,
}

impl Ast {
    // Returns an empty AST over `text`, with the sentinels at index 0 and the lexer's error `err`.
    pub fn new(_ text: own Text, _ err: Option<Diag>) -> Ast {
        var nodes: MemVec<Node> = MemVec::new()
        nodes.push(Node::leaf(NODE_NONE, SOURCE_START))
        var lists: MemVec<usize> = MemVec::new()
        lists.push(0)
        var syms: MemVec<Span> = MemVec::new()
        syms.push(Span { start: SOURCE_START, len: 0 })
        Ast { text, nodes, lists, syms, words: MemVec::new(), items: EMPTY_LIST, err }
    }

    pub fn list_len(self, _ l: ListId) -> usize {
        self.lists[l.id]
    }

    pub fn list_at(self, _ l: ListId, _ i: usize) -> NodeId {
        NodeId { id: self.lists[l.id + 1 + i] }
    }

    // Returns the word of INT, VARIANT or STR node `i`.
    pub fn word_value(self, _ i: NodeId) -> u256 {
        self.word(self.node(i).word())
    }

    pub fn word(self, _ w: WordId) -> u256 {
        self.words[w.id]
    }

    pub fn node(self, _ i: NodeId) -> Node {
        self.nodes[i.id]
    }

    // Returns the view of ARG node `i`. Like `Node.as_let`, it does not check the kind.
    pub fn arg(self, _ i: NodeId) -> ArgNode {
        let n = self.node(i)
        ArgNode { n, value_node: self.node(n.value()) }
    }

    // Returns the AST over `text` that `put` wrote to `r`.
    pub fn take_with(_ text: own Text, _ r: mut Reader) -> Ast {
        let nodes = Wire::take(mut r)
        let lists = Wire::take(mut r)
        let syms = Wire::take(mut r)
        let words = Wire::take(mut r)
        let items = ListId::take(mut r)
        Ast { text, nodes, lists, syms, words, items, err: Option::None }
    }

    // Returns the number of nodes, counting the sentinel.
    pub fn node_count(self) -> usize {
        self.nodes.len()
    }

    // Adds node `n` and returns its id.
    pub fn add_node(mut self, _ n: Node) -> NodeId {
        self.nodes.push(n)
        NodeId { id: self.nodes.len() - 1 }
    }

    // Sets the else branch of IF node `i`.
    pub fn set_else(mut self, _ i: NodeId, _ otherwise: NodeId) {
        var n = self.nodes[i.id]
        n.b = otherwise.id
        self.nodes.set(i.id, n)
    }

    // Adds `v` to `words` and returns its index.
    pub fn add_word(mut self, _ v: u256) -> WordId {
        self.words.push(v)
        WordId { id: self.words.len() - 1 }
    }

    // Adds the value of integer token `t` to `words` and returns its index. Errors as
    // `Text.int_value` does.
    pub fn add_int(mut self, _ t: Token) -> Result<Diag, WordId> {
        let v = self.text.int_value(t.span)?
        Result::Ok(self.add_word(v))
    }

    // Moves the elements of `pending` from `mark` on into a new list and returns it.
    pub fn add_list(mut self, _ pending: mut MemVec<NodeId>, _ mark: ListMark) -> ListId {
        if pending.len() == mark.at {
            return EMPTY_LIST
        }
        let l = self.lists.len()
        self.lists.push(pending.len() - mark.at)
        var i = mark.at
        while i < pending.len() {
            self.lists.push(pending[i].id)
            i += 1
        }
        pending.truncate(mark.at)
        ListId { id: l }
    }

    // Interns the identifier token `t` and returns its sym.
    // ponytail: linear scan, O(n²) in identifiers; hash if programs grow.
    pub fn intern(mut self, _ t: Token) -> Sym {
        var i: usize = 1
        while i < self.syms.len() {
            if self.text.same(self.syms[i], t.span) {
                return Sym { id: i }
            }
            i += 1
        }
        self.syms.push(t.span)
        Sym { id: self.syms.len() - 1 }
    }

    // Returns the source bytes of name `sym`.
    pub fn name_bytes(self, _ sym: Sym) -> ref MemSlice<u8> {
        self.text.span_bytes(self.syms[sym.id])
    }

    // Whether name `sym` starts with an uppercase letter.
    pub fn starts_upper(self, _ sym: Sym) -> bool {
        self.text.starts_upper(self.syms[sym.id])
    }

    pub fn spelling(self, _ sym: Sym) -> Spelling {
        self.text.packed(self.syms[sym.id])
    }
}
