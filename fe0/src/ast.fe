// The AST: an arena of nodes that refer to each other by index. ADR 0005 says why.
//
// Index 0 of `nodes`, `lists` and `syms` is a sentinel, so an index that is 0 means "none". A
// node is built by one `Node::new_` constructor per kind and read through the accessors after
// `impl Node`. The comment on each kind below names the accessors that apply to it:
// - a name is a sym, an index into `Ast.syms` (an interned identifier);
// - `list()` is an index into `Ast.lists`, read with `Ast.list_len` and `Ast.list_at`. List 0
//   is the empty list;
// - `ty()` is the type written in the source, or TY_NONE when none is;
// - `pos` is the byte offset of the token that diagnostics about the node point at.

use ingot::diag::Diag
use ingot::lexer::{Lexed, Span, T_EOF, Tok, Token}

// Kind of a node. The NODE_ constants below are its only values.
pub struct Kind { code: u8 }

impl Copy for Kind {}

impl core::ops::Eq for Kind {
    fn eq(self, _ other: Kind) -> bool {
        self.code == other.code
    }
}

impl Kind {
    // Whether nodes of this kind are expressions, which have a value.
    pub fn is_expr(self) -> bool {
        self.code >= NODE_INT.code && self.code <= NODE_ASSERT.code
    }
}

// The sentinel at index 0.
pub const NODE_NONE: Kind = Kind { code: 0 }

// Items and their parts.
// const: name, ty, value.
pub const NODE_CONST: Kind = Kind { code: 1 }
// fn: name, ty (the return type), list of PARAMs, body BLOCK.
pub const NODE_FN: Kind = Kind { code: 2 }
// param: name, ty, is_positional (written `_ name`).
pub const NODE_PARAM: Kind = Kind { code: 3 }
// msg: name, list of VARIANTs.
pub const NODE_MSG: Kind = Kind { code: 4 }
// variant: name, ty (the return type), word (the selector), list of FIELDs.
pub const NODE_VARIANT: Kind = Kind { code: 5 }
// field of a variant or a contract: name, ty.
pub const NODE_FIELD: Kind = Kind { code: 6 }
// contract: name, list of FIELDs, init (INIT or 0), recvs (a list of RECVs).
pub const NODE_CONTRACT: Kind = Kind { code: 7 }
// init: list of PARAMs, use_list (a list of USEs), body BLOCK.
pub const NODE_INIT: Kind = Kind { code: 8 }
// recv: name (of the msg), list of ARMs.
pub const NODE_RECV: Kind = Kind { code: 9 }
// arm: name (of the variant), ty (the return type), list of BINDs, use_list, body BLOCK.
pub const NODE_ARM: Kind = Kind { code: 10 }
// bind: name (of the field), local (the same sym as name when written `{ x }`).
pub const NODE_BIND: Kind = Kind { code: 11 }
// one entry of `uses (...)`: name (of the field), is_mut.
pub const NODE_USE: Kind = Kind { code: 12 }
// string literal: word (its bytes as a `StrValue.word`), str_len.
pub const NODE_STR: Kind = Kind { code: 13 }

// Statements.
// let or var: name, ty, value, is_var.
pub const NODE_LET: Kind = Kind { code: 20 }
// while: cond, body BLOCK.
pub const NODE_WHILE: Kind = Kind { code: 21 }
// return: value or 0.
pub const NODE_RETURN: Kind = Kind { code: 22 }
pub const NODE_BREAK: Kind = Kind { code: 23 }
pub const NODE_CONTINUE: Kind = Kind { code: 24 }
// `x = e` or `x op= e`: name (the target), op (O_ASSIGN or an A_ kind), value.
pub const NODE_ASSIGN: Kind = Kind { code: 25 }

// Expressions. Any expression node may also appear in a statement list.
// integer literal: word.
pub const NODE_INT: Kind = Kind { code: 40 }
// `true` or `false`: is_true.
pub const NODE_BOOL: Kind = Kind { code: 41 }
// a name of a local, parameter, constant or field: name.
pub const NODE_NAME: Kind = Kind { code: 42 }
// binary operator: op (an O_ kind), lhs, rhs.
pub const NODE_BINARY: Kind = Kind { code: 43 }
// `!` or `~`: op (O_BANG or O_TILDE), operand.
pub const NODE_UNARY: Kind = Kind { code: 44 }
// call: name (of the callee), list of ARGs.
pub const NODE_CALL: Kind = Kind { code: 45 }
// argument: name (the label, or 0), value.
pub const NODE_ARG: Kind = Kind { code: 46 }
// if: cond, body (the then BLOCK), otherwise (the else BLOCK, IF or 0).
pub const NODE_IF: Kind = Kind { code: 47 }
// block: list of statements, value (the tail expression, or 0).
pub const NODE_BLOCK: Kind = Kind { code: 48 }
// `assert!`: cond, message (a STR or 0).
pub const NODE_ASSERT: Kind = Kind { code: 49 }

// A type. A node's ty() holds one written in the source, or TY_NONE when none is written.
// The checker also uses TY_UNIT and TY_NEVER.
pub struct Ty { code: u8 }

impl Copy for Ty {}

impl core::ops::Eq for Ty {
    fn eq(self, _ other: Ty) -> bool {
        self.code == other.code
    }
}

pub const TY_NONE: Ty = Ty { code: 0 }
pub const TY_U256: Ty = Ty { code: 1 }
pub const TY_BOOL: Ty = Ty { code: 2 }
pub const TY_ADDRESS: Ty = Ty { code: 3 }
// The type of an expression that has no value.
pub const TY_UNIT: Ty = Ty { code: 4 }
// The type of an expression that never completes.
pub const TY_NEVER: Ty = Ty { code: 5 }

impl Ty {
    // Whether an expression of this type may stand where `want` is expected.
    // TY_NEVER fits any type.
    pub fn fits(self, _ want: Ty) -> bool {
        self == want || self == TY_NEVER
    }

    // Returns this written type, or TY_UNIT when none is written.
    pub fn or_unit(self) -> Ty {
        if self == TY_NONE { TY_UNIT } else { self }
    }
}

// Each accessor reads one fixed slot, and no kind uses two accessors of the same slot. The
// slots stay private to this file, so only the constructors write them.
pub struct Node {
    pub kind: Kind,
    pub pos: usize,
    op: Tok,
    ty: Ty,
    // name, cond, lhs or operand
    a: usize,
    // value, rhs, word, local, use_list, recvs, otherwise or message
    b: usize,
    // list
    c: usize,
    // body, init, str_len or a flag
    d: usize,
}

impl Copy for Node {}

fn flag(_ b: bool) -> usize {
    if b { 1 } else { 0 }
}

impl Node {
    // Returns a node of `kind` at `pos` with every other field empty: the sentinel, `break` and
    // `continue`.
    pub fn leaf(_ kind: Kind, _ pos: usize) -> Node {
        Node { kind, pos, op: T_EOF, ty: TY_NONE, a: 0, b: 0, c: 0, d: 0 }
    }

    fn make(_ kind: Kind, _ pos: usize, a: usize, b: usize, c: usize, d: usize) -> Node {
        Node { kind, pos, op: T_EOF, ty: TY_NONE, a, b, c, d }
    }

    fn typed(_ kind: Kind, _ pos: usize, ty: Ty, a: usize, b: usize, c: usize, d: usize) -> Node {
        Node { kind, pos, op: T_EOF, ty, a, b, c, d }
    }

    pub fn new_const(_ pos: usize, name: usize, ty: Ty, value: usize) -> Node {
        Node::typed(NODE_CONST, pos, ty, a: name, b: value, c: 0, d: 0)
    }

    pub fn new_fn(_ pos: usize, name: usize, params: usize, ret: Ty, body: usize) -> Node {
        Node::typed(NODE_FN, pos, ty: ret, a: name, b: 0, c: params, d: body)
    }

    pub fn new_param(_ pos: usize, name: usize, ty: Ty, positional: bool) -> Node {
        Node::typed(
            NODE_PARAM,
            pos,
            ty,
            a: name,
            b: 0,
            c: 0,
            d: flag(positional),
        )
    }

    pub fn new_msg(_ pos: usize, name: usize, variants: usize) -> Node {
        Node::make(NODE_MSG, pos, a: name, b: 0, c: variants, d: 0)
    }

    pub fn new_variant(_ pos: usize, name: usize, selector: usize, fields: usize, ret: Ty) -> Node {
        Node::typed(
            NODE_VARIANT,
            pos,
            ty: ret,
            a: name,
            b: selector,
            c: fields,
            d: 0,
        )
    }

    pub fn new_field(_ pos: usize, name: usize, ty: Ty) -> Node {
        Node::typed(NODE_FIELD, pos, ty, a: name, b: 0, c: 0, d: 0)
    }

    pub fn new_contract(
        _ pos: usize,
        name: usize,
        fields: usize,
        init: usize,
        recvs: usize,
    ) -> Node {
        Node::make(NODE_CONTRACT, pos, a: name, b: recvs, c: fields, d: init)
    }

    pub fn new_init(_ pos: usize, params: usize, use_list: usize, body: usize) -> Node {
        Node::make(NODE_INIT, pos, a: 0, b: use_list, c: params, d: body)
    }

    pub fn new_recv(_ pos: usize, name: usize, arms: usize) -> Node {
        Node::make(NODE_RECV, pos, a: name, b: 0, c: arms, d: 0)
    }

    pub fn new_arm(
        _ pos: usize,
        variant: usize,
        binds: usize,
        ret: Ty,
        use_list: usize,
        body: usize,
    ) -> Node {
        Node::typed(
            NODE_ARM,
            pos,
            ty: ret,
            a: variant,
            b: use_list,
            c: binds,
            d: body,
        )
    }

    pub fn new_bind(_ pos: usize, field: usize, local: usize) -> Node {
        Node::make(NODE_BIND, pos, a: field, b: local, c: 0, d: 0)
    }

    pub fn new_use(_ pos: usize, field: usize, mutable: bool) -> Node {
        Node::make(NODE_USE, pos, a: field, b: 0, c: 0, d: flag(mutable))
    }

    pub fn new_str(_ pos: usize, word: usize, len: usize) -> Node {
        Node::make(NODE_STR, pos, a: 0, b: word, c: 0, d: len)
    }

    pub fn new_let(_ pos: usize, name: usize, ty: Ty, value: usize, mutable: bool) -> Node {
        Node::typed(
            NODE_LET,
            pos,
            ty,
            a: name,
            b: value,
            c: 0,
            d: flag(mutable),
        )
    }

    pub fn new_while(_ pos: usize, cond: usize, body: usize) -> Node {
        Node::make(NODE_WHILE, pos, a: cond, b: 0, c: 0, d: body)
    }

    pub fn new_return(_ pos: usize, value: usize) -> Node {
        Node::make(NODE_RETURN, pos, a: 0, b: value, c: 0, d: 0)
    }

    pub fn new_assign(_ pos: usize, name: usize, op: Tok, value: usize) -> Node {
        Node { kind: NODE_ASSIGN, pos, op, ty: TY_NONE, a: name, b: value, c: 0, d: 0 }
    }

    pub fn new_int(_ pos: usize, word: usize) -> Node {
        Node::make(NODE_INT, pos, a: 0, b: word, c: 0, d: 0)
    }

    pub fn new_bool(_ pos: usize, value: bool) -> Node {
        Node::make(NODE_BOOL, pos, a: 0, b: 0, c: 0, d: flag(value))
    }

    pub fn new_name(_ pos: usize, name: usize) -> Node {
        Node::make(NODE_NAME, pos, a: name, b: 0, c: 0, d: 0)
    }

    pub fn new_binary(_ pos: usize, op: Tok, lhs: usize, rhs: usize) -> Node {
        Node { kind: NODE_BINARY, pos, op, ty: TY_NONE, a: lhs, b: rhs, c: 0, d: 0 }
    }

    pub fn new_unary(_ pos: usize, op: Tok, operand: usize) -> Node {
        Node { kind: NODE_UNARY, pos, op, ty: TY_NONE, a: operand, b: 0, c: 0, d: 0 }
    }

    pub fn new_call(_ pos: usize, name: usize, args: usize) -> Node {
        Node::make(NODE_CALL, pos, a: name, b: 0, c: args, d: 0)
    }

    pub fn new_arg(_ pos: usize, label: usize, value: usize) -> Node {
        Node::make(NODE_ARG, pos, a: label, b: value, c: 0, d: 0)
    }

    // An IF without its else branch, which `Ast.set_else` adds.
    pub fn new_if(_ pos: usize, cond: usize, then: usize) -> Node {
        Node::make(NODE_IF, pos, a: cond, b: 0, c: 0, d: then)
    }

    pub fn new_block(_ pos: usize, stmts: usize, tail: usize) -> Node {
        Node::make(NODE_BLOCK, pos, a: 0, b: tail, c: stmts, d: 0)
    }

    pub fn new_assert(_ pos: usize, cond: usize, message: usize) -> Node {
        Node::make(NODE_ASSERT, pos, a: cond, b: message, c: 0, d: 0)
    }

    pub fn op(self) -> Tok {
        self.op
    }
    pub fn ty(self) -> Ty {
        self.ty
    }

    pub fn name(self) -> usize {
        self.a
    }
    pub fn cond(self) -> usize {
        self.a
    }
    pub fn lhs(self) -> usize {
        self.a
    }
    pub fn operand(self) -> usize {
        self.a
    }

    pub fn value(self) -> usize {
        self.b
    }
    pub fn rhs(self) -> usize {
        self.b
    }
    pub fn word(self) -> usize {
        self.b
    }
    pub fn local(self) -> usize {
        self.b
    }
    pub fn use_list(self) -> usize {
        self.b
    }
    pub fn recvs(self) -> usize {
        self.b
    }
    pub fn otherwise(self) -> usize {
        self.b
    }
    pub fn message(self) -> usize {
        self.b
    }

    pub fn list(self) -> usize {
        self.c
    }

    pub fn body(self) -> usize {
        self.d
    }
    pub fn init(self) -> usize {
        self.d
    }
    pub fn str_len(self) -> usize {
        self.d
    }
    pub fn is_positional(self) -> bool {
        self.d == 1
    }
    pub fn is_mut(self) -> bool {
        self.d == 1
    }
    pub fn is_var(self) -> bool {
        self.d == 1
    }
    pub fn is_true(self) -> bool {
        self.d == 1
    }
}

// The parsed program. On error, the arrays hold whatever was built before it. This is not a
// `Result` for the same reason `Lexed` is not.
pub struct Ast {
    pub lexed: Lexed,
    pub nodes: MemVec<Node>,
    pub lists: MemVec<usize>,
    // The source span of each distinct identifier.
    pub syms: MemVec<Span>,
    // 256-bit values that nodes refer to: integer literals, selectors and the packed bytes of
    // `assert!` messages.
    pub words: MemVec<u256>,
    // The list of items.
    pub items: usize,
    // The lexer's or the parser's error.
    pub err: Option<Diag>,
}

impl Ast {
    // Returns an empty AST over `lexed`, with the sentinels at index 0 and the lexer's error.
    pub fn new(_ lexed: own Lexed) -> Ast {
        var nodes: MemVec<Node> = MemVec::new()
        nodes.push(Node::leaf(NODE_NONE, 0))
        var lists: MemVec<usize> = MemVec::new()
        lists.push(0)
        var syms: MemVec<Span> = MemVec::new()
        syms.push(Span { start: 0, len: 0 })
        let err = lexed.err
        Ast { lexed, nodes, lists, syms, words: MemVec::new(), items: 0, err }
    }

    pub fn list_len(self, _ l: usize) -> usize {
        self.lists[l]
    }

    pub fn list_at(self, _ l: usize, _ i: usize) -> usize {
        self.lists[l + 1 + i]
    }

    // Adds node `n` and returns its index.
    pub fn add_node(mut self, _ n: Node) -> usize {
        self.nodes.push(n)
        self.nodes.len() - 1
    }

    // Sets the else branch of IF node `i`.
    pub fn set_else(mut self, _ i: usize, _ otherwise: usize) {
        var n = self.nodes[i]
        n.b = otherwise
        self.nodes.set(i, n)
    }

    // Adds the value of integer token `t` to `words` and returns its index.
    pub fn add_int(mut self, _ t: Token) -> usize {
        self.add_word(self.lexed.text.int_value(t.span).unwrap())
    }

    // Adds `v` to `words` and returns its index.
    pub fn add_word(mut self, _ v: u256) -> usize {
        self.words.push(v)
        self.words.len() - 1
    }

    // Moves the elements of `pending` from `mark` on into a new list and returns it. A list is
    // stored as its length followed by its elements.
    pub fn add_list(mut self, _ pending: mut MemVec<usize>, _ mark: usize) -> usize {
        let n = pending.len() - mark
        if n == 0 { return 0 }
        let l = self.lists.len()
        self.lists.push(n)
        var i = mark
        while i < mark + n {
            self.lists.push(pending[i])
            i += 1
        }
        pending.truncate(mark)
        l
    }

    // Interns the identifier token `t` and returns its sym.
    // ponytail: linear scan, O(n²) in identifiers; hash if programs grow.
    pub fn intern(mut self, _ t: Token) -> usize {
        var i: usize = 1
        while i < self.syms.len() {
            if self.lexed.text.same(self.syms[i], t.span) {
                return i
            }
            i += 1
        }
        self.syms.push(t.span)
        self.syms.len() - 1
    }
}
