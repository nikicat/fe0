use ingot::ast::*
use ingot::diag::{
    Diag,
    DiagCode,
    L_INT_TOO_LARGE,
    L_RESERVED_WORD,
    P_CHAINED_COMPARISON,
    P_EXPECTED_END,
    P_EXPECTED_EXPR,
    P_EXPECTED_IDENT,
    P_EXPECTED_ITEM,
    P_EXPECTED_TOKEN,
    P_EXPECTED_TYPE,
    P_FIELD_NOT_MUT,
    P_GENERIC_ARGS,
    P_MESSAGE_TOO_LONG,
    P_RECORD_LITERAL,
    P_TOO_DEEP,
}
use ingot::io::{Byte, END, Source, text}
use ingot::lexer::{
    A_AMP,
    A_CARET,
    A_MINUS,
    A_PERCENT,
    A_PIPE,
    A_PLUS,
    A_SHL,
    A_SHR,
    A_SLASH,
    A_STAR,
    O_AMP,
    O_ANDAND,
    O_ASSIGN,
    O_BANG,
    O_CARET,
    O_EQ,
    O_GE,
    O_GT,
    O_LE,
    O_LT,
    O_MINUS,
    O_NE,
    O_OROR,
    O_PERCENT,
    O_PIPE,
    O_PLUS,
    O_SHL,
    O_SHR,
    O_SLASH,
    O_STAR,
    O_TILDE,
    P_COMMA,
    P_LPAREN,
    Pos,
    StrValue,
    T_IDENT,
    Tok,
}
use ingot::parser::{MAX_DEPTH, NOT_BINARY, binding_power, parse}
use std::abi::DynString

fn parsed(_ s: own DynString) -> Ast {
    with (Source = text(s)) {
        parse()
    }
}

fn parse_text(_ s: own DynString) -> Ast {
    let a = parsed(s)
    assert!(a.err.is_none())
    a
}

fn parse_err(_ s: own DynString) -> Diag {
    parsed(s).err.unwrap()
}

// Asserts that parsing `src` fails with `code` at byte `at`.
fn rejects(_ src: own DynString, _ code: DiagCode, _ at: usize) {
    let d = parse_err(src)
    assert!(d.code == code)
    assert!(d.pos() == Pos::at(at))
}

// Asserts that the first item of `src` prints as `want`.
fn item_is(_ src: own DynString, _ want: DynString) {
    let ast = parse_text(src)
    let i = ast.list_at(ast.items, 0)
    prints(ast, i, want)
}

// Asserts that the tail expression of the first item, a function, prints as `want`.
fn tail_is(_ src: own DynString, _ want: DynString) {
    let ast = parse_text(src)
    let f = ast.node(ast.list_at(ast.items, 0))
    let i = ast.node(f.body()).value()
    prints(ast, i, want)
}

// Asserts that node `i` of `ast` prints as `want`.
fn prints(_ ast: own Ast, _ i: NodeId, _ want: DynString) {
    var p = Printer { ast, out: MemVec::new() }
    p.node(i)
    assert!(p.out.as_slice() == want)
}

// Renders nodes as S-expressions: `(op a b)` for operators and items, `{s; s; tail}` for
// blocks, `name:type` for typed names, and `?` for a type that is not written.
struct Printer { ast: Ast, out: MemVec<u8> }

impl Printer {
    fn put<const N: usize>(mut self, _ w: String<N>) {
        let b = w.as_bytes()
        var i: usize = 0
        while i < N {
            self.out.push(b[i])
            i += 1
        }
    }

    // Writes byte `b`, escaped as the lexer reads it inside a string literal.
    fn escaped(mut self, _ b: u8) {
        let plain: String<5> = "\n\r\t\"\\"
        let letters: String<5> = "nrt\"\\"
        var i: usize = 0
        while i < plain.len() {
            if b == plain.as_bytes()[i] {
                self.put("\\")
                self.out.push(letters.as_bytes()[i])
                return
            }
            i += 1
        }
        self.out.push(b)
    }

    fn sym(mut self, _ s: Sym) {
        self.out.extend_from_slice(self.ast.name_bytes(s))
    }

    // The source spelling of operator `t`.
    fn op(mut self, _ t: Tok) {
        if t == O_PLUS {
            self.put("+")
        } else if t == O_MINUS {
            self.put("-")
        } else if t == O_STAR {
            self.put("*")
        } else if t == O_SLASH {
            self.put("/")
        } else if t == O_PERCENT {
            self.put("%")
        } else if t == O_TILDE {
            self.put("~")
        } else if t == O_BANG {
            self.put("!")
        } else if t == O_CARET {
            self.put("^")
        } else if t == O_AMP {
            self.put("&")
        } else if t == O_PIPE {
            self.put("|")
        } else if t == O_ANDAND {
            self.put("&&")
        } else if t == O_OROR {
            self.put("||")
        } else if t == O_LT {
            self.put("<")
        } else if t == O_GT {
            self.put(">")
        } else if t == O_ASSIGN {
            self.put("=")
        } else if t == O_EQ {
            self.put("==")
        } else if t == O_NE {
            self.put("!=")
        } else if t == O_LE {
            self.put("<=")
        } else if t == O_GE {
            self.put(">=")
        } else if t == O_SHL {
            self.put("<<")
        } else if t == O_SHR {
            self.put(">>")
        } else if t == A_PLUS {
            self.put("+=")
        } else if t == A_MINUS {
            self.put("-=")
        } else if t == A_STAR {
            self.put("*=")
        } else if t == A_SLASH {
            self.put("/=")
        } else if t == A_PERCENT {
            self.put("%=")
        } else if t == A_CARET {
            self.put("^=")
        } else if t == A_AMP {
            self.put("&=")
        } else if t == A_PIPE {
            self.put("|=")
        } else if t == A_SHL {
            self.put("<<=")
        } else if t == A_SHR {
            self.put(">>=")
        } else {
            self.put("<bad op>")
        }
    }

    fn ty(mut self, _ t: Ty) {
        if t == TY_U256 {
            self.put("u256")
        } else if t == TY_BOOL {
            self.put("bool")
        } else if t == TY_ADDRESS {
            self.put("Address")
        } else if t == TY_CTX {
            self.put("Ctx")
        } else if t == TY_LOG {
            self.put("mut Log")
        } else if t == TY_CALL {
            self.put("mut Call")
        } else if t.is_map() {
            self.put("StorageMap<")
            self.ty(t.map_key())
            self.put(",")
            self.ty(t.map_value())
            self.put(">")
        } else {
            self.put("?")
        }
    }

    fn typed(mut self, _ s: Sym, _ t: Ty) {
        self.sym(s)
        self.put(":")
        self.ty(t)
    }

    fn uint(mut self, _ v: u256) {
        let numerals: String<10> = "0123456789"
        var digits: MemVec<u8> = MemVec::new()
        var x = v
        while true {
            let d: usize = (x % 10).downcast_truncate()
            digits.push(numerals.as_bytes()[d])
            x = x / 10
            if x == 0 { break }
        }
        while digits.len() > 0 {
            self.out.push(digits.pop().unwrap())
        }
    }

    // ` (e e e)`, with a leading space.
    fn list(mut self, _ l: ListId) {
        self.put(" (")
        var i: usize = 0
        while i < self.ast.list_len(l) {
            if i > 0 { self.put(" ") }
            self.node(self.ast.list_at(l, i))
            i += 1
        }
        self.put(")")
    }

    // ` e`, or ` ?` for NO_NODE.
    fn opt(mut self, _ i: NodeId) {
        self.put(" ")
        if i.is_none() {
            self.put("?")
        } else {
            self.node(i)
        }
    }

    fn node(mut self, _ i: NodeId) {
        let n = self.ast.node(i)
        let k = n.kind
        if k == NODE_CONST {
            self.put("(const ")
            self.typed(n.name(), n.ty())
            self.opt(n.value())
            self.put(")")
        } else if k == NODE_FN {
            self.put("(fn ")
            self.sym(n.name())
            self.list(n.list())
            self.put(" ")
            self.ty(n.ty())
            self.opt(n.body())
            self.put(")")
        } else if k == NODE_PARAM {
            if n.is_positional() {
                self.put("_")
            }
            self.typed(n.name(), n.ty())
        } else if k == NODE_MSG {
            self.put("(msg ")
            self.sym(n.name())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_VARIANT {
            self.put("(")
            let v = self.ast.word(n.word())
            self.uint(v)
            self.put(" ")
            self.sym(n.name())
            self.list(n.list())
            self.put(" ")
            self.ty(n.ty())
            self.put(")")
        } else if k == NODE_FIELD {
            if n.is_indexed() {
                self.put("#")
            }
            self.typed(n.name(), n.ty())
        } else if k == NODE_EVENT {
            self.put("(event ")
            self.sym(n.name())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_CONTRACT {
            self.put("(contract ")
            self.sym(n.name())
            self.list(n.list())
            self.opt(n.init())
            self.list(n.recvs())
            self.put(")")
        } else if k == NODE_INIT {
            self.put("(init")
            self.list(n.list())
            self.list(n.use_list())
            self.opt(n.body())
            self.put(")")
        } else if k == NODE_RECV {
            self.put("(recv ")
            self.sym(n.name())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_ARM {
            self.put("(")
            self.sym(n.name())
            self.list(n.list())
            self.put(" ")
            self.ty(n.ty())
            self.list(n.use_list())
            self.opt(n.body())
            self.put(")")
        } else if k == NODE_BIND {
            self.sym(n.name())
            if n.local() != n.name() {
                self.put(":")
                self.sym(n.local())
            }
        } else if k == NODE_USE {
            if n.is_mut() {
                self.put("mut ")
            }
            self.sym(n.name())
        } else if k == NODE_LET {
            let l = n.as_let()
            if l.is_var() {
                self.put("(var ")
            } else {
                self.put("(let ")
            }
            self.typed(l.name(), l.ty())
            self.opt(l.value())
            self.put(")")
        } else if k == NODE_WHILE {
            self.put("(while")
            self.opt(n.cond())
            self.opt(n.body())
            self.put(")")
        } else if k == NODE_RETURN {
            self.put("(return")
            self.opt(n.value())
            self.put(")")
        } else if k == NODE_BREAK {
            self.put("break")
        } else if k == NODE_CONTINUE {
            self.put("continue")
        } else if k == NODE_ASSIGN {
            self.put("(")
            self.op(n.op())
            self.put(" ")
            self.node(n.place())
            self.opt(n.value())
            self.put(")")
        } else if k == NODE_INT {
            let v = self.ast.word(n.word())
            self.uint(v)
        } else if k == NODE_BOOL {
            if n.is_true() {
                self.put("true")
            } else {
                self.put("false")
            }
        } else if k == NODE_NAME {
            self.sym(n.name())
        } else if k == NODE_BINARY {
            self.put("(")
            self.op(n.op())
            self.opt(n.lhs())
            self.opt(n.rhs())
            self.put(")")
        } else if k == NODE_UNARY {
            self.put("(")
            self.op(n.op())
            self.opt(n.operand())
            self.put(")")
        } else if k == NODE_CALL {
            self.put("(call ")
            self.sym(n.name())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_ARG {
            if n.name() != NO_SYM {
                self.sym(n.name())
                self.put(":")
            }
            self.node(n.value())
        } else if k == NODE_IF {
            self.put("(if")
            self.opt(n.cond())
            self.opt(n.body())
            self.opt(n.otherwise())
            self.put(")")
        } else if k == NODE_BLOCK {
            self.put("{")
            var i: usize = 0
            while i < self.ast.list_len(n.list()) {
                self.node(self.ast.list_at(n.list(), i))
                self.put("; ")
                i += 1
            }
            if !n.value().is_none() {
                self.node(n.value())
            }
            self.put("}")
        } else if k == NODE_ASSERT {
            self.put("(assert")
            self.opt(n.cond())
            if !n.message().is_none() {
                self.put(" ")
                self.node(n.message())
            }
            self.put(")")
        } else if k == NODE_CALLER {
            self.put("(caller ")
            self.sym(n.name())
            self.put(")")
        } else if k == NODE_SELF_ADDRESS {
            self.put("(address ")
            self.sym(n.name())
            self.put(")")
        } else if k == NODE_EMIT {
            self.put("(emit ")
            self.sym(n.name())
            self.put(" ")
            self.sym(n.event())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_MSG_CALL {
            self.put("(msg-call ")
            self.node(n.target())
            self.put(" ")
            self.sym(n.msg_name())
            self.put("::")
            self.sym(n.variant())
            self.list(n.list())
            self.put(")")
        } else if k == NODE_ZERO_ADDRESS {
            self.put("(zero)")
        } else if k == NODE_INDEX {
            self.sym(n.name())
            self.put("[")
            self.node(n.key())
            self.put("]")
        } else if k == NODE_STR {
            self.put("\"")
            let v = StrValue { word: self.ast.word(n.word()), len: n.str_len() }
            var i: usize = 0
            while i < v.len {
                self.escaped(v.byte(i))
                i += 1
            }
            self.put("\"")
        } else {
            self.put("<bad node>")
        }
    }
}

// The deepest nesting the parser accepts. The function body and the outer expression take two
// levels, and each parenthesis one. Each block in a block takes two: the block and its tail.
pub const DEEPEST_PARENS: usize = MAX_DEPTH - 2
pub const DEEPEST_BLOCKS: usize = (MAX_DEPTH - 2) / 2

// A test `Source` of `head`, then the bytes of `body`, then `tail`. Tests build large programs
// with one, so that no test holds them as a literal.
pub struct Framed<B: Body> { head: String<31>, body: B, tail: String<31>, pos: usize }

// The middle of a `Framed` source, made byte by byte.
pub trait Body {
    // The number of bytes.
    fn len(self) -> usize

    // The byte at index `i`, which is below `len()`.
    fn at(self, _ i: usize) -> u8
}

pub fn framed<B: Body>(_ head: String<31>, _ body: own B, _ tail: String<31>) -> Framed<B> {
    Framed { head, body, tail, pos: 0 }
}

impl<B: Body> Source for Framed<B> {
    fn next_byte(mut self) -> Byte {
        let i = self.pos
        self.pos += 1
        if i < self.head.len() {
            return Byte::of(self.head.byte_at(i))
        }
        let j = i - self.head.len()
        if j < self.body.len() {
            return Byte::of(self.body.at(j))
        }
        let k = j - self.body.len()
        if k < self.tail.len() {
            return Byte::of(self.tail.byte_at(k))
        }
        END
    }
}

// `depth` opening brackets, a 1, and `depth` closing brackets.
pub struct Nested { pub brackets: String<2>, pub depth: usize }

impl Nested {
    // A `Source` of `fn f() -> u256 { (((1))) }` with these brackets around the 1.
    pub fn source(own self) -> Framed<Nested> {
        framed("fn f() -> u256 { ", self, " }")
    }
}

impl Body for Nested {
    fn len(self) -> usize {
        2 * self.depth + 1
    }

    fn at(self, _ i: usize) -> u8 {
        if i < self.depth {
            return self.brackets.byte_at(0)
        }
        if i == self.depth {
            return b'1'
        }
        self.brackets.byte_at(1)
    }
}

fn nested(_ brackets: String<2>, _ depth: usize) -> Option<Diag> {
    with (Source = Nested { brackets, depth }.source()) {
        parse().err
    }
}

// The lexer's `Tok.is_binary`, which decides where a line inside parentheses may end, names
// exactly the operators that the parser gives a binding power.
#[test]
fn binary_operators_have_a_binding_power() {
    let toks = [
        O_PLUS,
        O_MINUS,
        O_STAR,
        O_SLASH,
        O_PERCENT,
        O_TILDE,
        O_BANG,
        O_CARET,
        O_AMP,
        O_PIPE,
        O_ANDAND,
        O_OROR,
        O_LT,
        O_GT,
        O_ASSIGN,
        O_EQ,
        O_NE,
        O_LE,
        O_GE,
        O_SHL,
        O_SHR,
        A_PLUS,
        A_SHR,
        P_LPAREN,
        P_COMMA,
        T_IDENT,
    ]
    for t in toks {
        assert!(t.is_binary() == !(binding_power(t) == NOT_BINARY))
    }
}

#[test]
fn binary_precedence() {
    tail_is(
        "fn f() { a || b && c == d | e ^ f & g << h + i * j }",
        "(|| a (&& b (== c (| d (^ e (& f (<< g (+ h (* i j)))))))))",
    )
    tail_is(
        "fn f() { a * b + c << d & e ^ f | g != h && i || j }",
        "(|| (&& (!= (| (^ (& (<< (+ (* a b) c) d) e) f) g) h) i) j)",
    )
    tail_is("fn f() { a - b - c }", "(- (- a b) c)")
    tail_is("fn f() { a / (b % c) >> 2 }", "(>> (/ a (% b c)) 2)")
}

#[test]
fn unary_and_primaries() {
    tail_is("fn f() { !~a == !b }", "(== (! (~ a)) (! b))")
    tail_is("fn f() { 0x10 + 1_000 }", "(+ 16 1000)")
    tail_is("fn f() { true != false }", "(!= true false)")
    tail_is("fn f() { { 1 } }", "{1}")
    tail_is(
        "fn f() { g(x, y: 1 + 2, h()) }",
        "(call g (x y:(+ 1 2) (call h ())))",
    )
    tail_is(
        "fn f() { if a { 1 } else if b { 2 } else { 3 } }",
        "(if a {1} (if b {2} {3}))",
    )
    tail_is("fn f() { if a { g() } }", "(if a {(call g ())} ?)")
    tail_is(
        "fn f() { assert!(x == 1, \"no\\n\") }",
        "(assert (== x 1) \"no\\n\")",
    )
    tail_is(
        "fn f() { assert!(x, \"say \\\"hi\\\" \\\\ \\t\\r\") }",
        "(assert x \"say \\\"hi\\\" \\\\ \\t\\r\")",
    )
}

#[test]
fn fixed_forms() {
    // `ctx.caller()`, `ctx.address()` and `Address::zero()` are whole expressions (ADR 0017,
    // ADR 0020). Spaces may come between their tokens, except between the colons.
    tail_is(
        "fn f() { ctx.caller() == Address::zero() }",
        "(== (caller ctx) (zero))",
    )
    tail_is("fn f() { ctx . caller ( ) }", "(caller ctx)")
    tail_is("fn f() { ctx.address() }", "(address ctx)")
    rejects("fn f() { ctx.address }", P_EXPECTED_TOKEN, 21)
    tail_is("fn f() { Address :: zero() }", "(zero)")
    rejects("fn f() { Address: :zero() }", P_EXPECTED_TOKEN, 18)
    rejects("fn f() { ctx.origin() }", P_EXPECTED_TOKEN, 13)
    rejects("fn f() { ctx.caller(1) }", P_EXPECTED_TOKEN, 20)
    rejects("fn f() { Address::new() }", P_EXPECTED_TOKEN, 18)
    rejects("fn f() { ctx.caller }", P_EXPECTED_TOKEN, 20)
}

#[test]
fn maps() {
    // A contract field may have a map type, and `m[k]` reads or assigns an entry (ADR 0018).
    item_is(
        "contract C {\n    mut m: StorageMap<Address, u256>\n    mut f: StorageMap < bool , Address >\n}",
        "(contract C (m:StorageMap<Address,u256> f:StorageMap<bool,Address>) ? ())",
    )
    tail_is("fn f() { m[k + 1] * m[m[2]] }", "(* m[(+ k 1)] m[m[2]])")
    item_is(
        "fn f() {\n    m[k] = 1\n    m[g(k)] -= x\n}",
        "(fn f () ? {(= m[k] 1); (-= m[(call g (k))] x); })",
    )
    // A place may be in parentheses, as Fe allows.
    item_is("fn f() { (m[k]) += 1 }", "(fn f () ? {(+= m[k] 1); })")
    item_is("fn f() { ((x)) = 1 }", "(fn f () ? {(= x 1); })")
    // Anything else before `=` is not a place.
    rejects("fn f() { x + 1 = 2 }", P_EXPECTED_END, 15)
    rejects("fn f() { g() = 2 }", P_EXPECTED_END, 13)
    rejects("fn f() { (m)[k] = 2 }", P_EXPECTED_END, 12)
    // A map type is only a contract field's, with two of the three types as its arguments.
    rejects("fn f(m: StorageMap<u256, u256>) {}", P_EXPECTED_TYPE, 8)
    rejects(
        "msg M {\n    #[selector = 1]\n    A { m: StorageMap<u256, u256> }\n}",
        P_EXPECTED_TYPE,
        39,
    )
    rejects(
        "contract C {\n    mut m: StorageMap<u256, StorageMap<u256, u256>>\n}",
        P_EXPECTED_TYPE,
        41,
    )
    rejects(
        "contract C {\n    mut m: StorageMap<u256>\n}",
        P_EXPECTED_TOKEN,
        39,
    )
    rejects(
        "contract C {\n    mut m: Map<u256, u256>\n}",
        P_EXPECTED_TYPE,
        24,
    )
    // A newline may not come inside `[ ]`, and Fe rejects it too.
    rejects("fn f() { m[\nk] }", P_EXPECTED_EXPR, 11)
}

#[test]
fn events() {
    // An event is a struct with `#[event]`, whose fields may be `#[indexed]` (ADR 0019). Doc
    // comments may come before and after each attribute, and the struct may be `pub`.
    item_is(
        "#[event]\nstruct E {\n    #[indexed]\n    a: Address,\n    b: u256,\n}",
        "(event E (#a:Address b:u256))",
    )
    item_is(
        "/// e\n#[event]\n/// e\npub struct E {\n    /// a\n    #[indexed]\n    /// a\n    a: bool\n}",
        "(event E (#a:bool))",
    )
    item_is("#[event]\n\nstruct E {}", "(event E ())")
    item_is(
        "contract C uses (ctx: Ctx, log: mut Log) {\n}",
        "(contract C (ctx:Ctx log:mut Log) ? ())",
    )
    // `log.emit(E { … })` is a whole expression. A value without a label is a name that spells
    // its field, as in a call.
    tail_is(
        "fn f() { log.emit(E { a, b: x + 1 }) }",
        "(emit log E (a b:(+ x 1)))",
    )
    tail_is(
        "fn f() { log . emit ( E {\n    a,\n\n    b: 1,\n} ) }",
        "(emit log E (a b:1))",
    )
    // The attribute must end its line, and Fe rejects it too.
    rejects("#[event] struct E {}", P_EXPECTED_TOKEN, 9)
    rejects(
        "#[event]\nstruct E {\n    #[indexed] a: u256\n}",
        P_EXPECTED_TOKEN,
        35,
    )
    // Only `event` may name the struct's attribute, and a struct needs it.
    rejects("#[evnt]\nstruct E {}", P_EXPECTED_TOKEN, 2)
    rejects("struct E {}", P_EXPECTED_ITEM, 0)
    rejects("#[event]\nfn f() {}", P_EXPECTED_TOKEN, 9)
    // An event's field has one of the three types.
    rejects(
        "#[event]\nstruct E {\n    m: StorageMap<u256, u256>\n}",
        P_EXPECTED_TYPE,
        27,
    )
    // The event is written as a literal in place.
    rejects("fn f() { log.emit(e) }", P_EXPECTED_TOKEN, 19)
    rejects("fn f() { log.emit(E {}, 1) }", P_EXPECTED_TOKEN, 22)
}

#[test]
fn calls() {
    // A contract may have a `Call` effect, declared `mut` (ADR 0020).
    item_is(
        "contract C uses (call: mut Call) {\n}",
        "(contract C (call:mut Call) ? ())",
    )
    // `t.call(M::V { … })` is a whole expression. Its values are read as those of an emit.
    tail_is(
        "fn f() { t.call(M::V { a, b: x + 1 }) }",
        "(msg-call t M::V (a b:(+ x 1)))",
    )
    tail_is("fn f() { t . call ( M::V {} ) }", "(msg-call t M::V ())")
    // The colons of the path touch, the variant takes braces, and nothing follows them.
    rejects("fn f() { t.call(M: :V {}) }", P_EXPECTED_TOKEN, 19)
    rejects("fn f() { t.call(M::V) }", P_EXPECTED_TOKEN, 20)
    rejects("fn f() { t.call(V {}) }", P_EXPECTED_TOKEN, 18)
    rejects("fn f() { t.call(M::V {}, 1) }", P_EXPECTED_TOKEN, 23)
}

#[test]
fn statements() {
    item_is(
        "fn f(_ a: u256, b: bool) -> u256 {\n    let x = 1\n    var y: u256 = 2\n    y += x\n    while y < 9 { y = y + 1 }\n    if b { return y }\n    break\n    continue\n    return\n}",
        "(fn f (_a:u256 b:bool) u256 {(let x:? 1); (var y:u256 2); (+= y x); (while (< y 9) {(= y (+ y 1)); }); (if b {(return y); } ?); break; continue; (return ?); })",
    )
    item_is("fn f() { x = 1 }", "(fn f () ? {(= x 1); })")
}

#[test]
fn newlines() {
    // Inside parentheses, newlines are ignored.
    tail_is("fn f() {\n    (1 +\n    2)\n}", "(+ 1 2)")
    // A newline ends a statement, so `(a)` on the next line is not a call.
    item_is(
        "fn f() {\n    let x = a\n    (a)\n}",
        "(fn f () ? {(let x:? a); a})",
    )
    assert!(
        parse_err("fn f() { let x = 1 +\n 2 }").code == P_EXPECTED_EXPR,
    )
    assert!(parse_err("fn f() { a b }").code == P_EXPECTED_END)
    // `{` must be on the same line as the signature or condition.
    assert!(parse_err("fn f()\n{ }").code == P_EXPECTED_TOKEN)
    // `else` must follow `}` on the same line.
    assert!(
        parse_err("fn f() { if a { 1 }\n else { 2 } }").code == P_EXPECTED_EXPR,
    )
}

#[test]
fn items() {
    item_is("pub const N: u256 = 2 * 3\n", "(const N:u256 (* 2 3))")
    item_is(
        "msg M {\n    #[selector = 0xd09de08a]\n    Inc {},\n    #[selector = 1]\n    Set { a: u256, b: Address } -> bool\n}",
        "(msg M ((3500007562 Inc () ?) (1 Set (a:u256 b:Address) bool)))",
    )
    item_is(
        "contract C {\n    mut a: u256,\n    mut b: bool\n\n    init(x: u256) uses (mut a) {\n        a = x\n    }\n\n    recv M {\n        Inc {} uses (mut a) { a += 1 }\n        Set { a: v, b } -> bool uses (a, mut b,) {\n            b\n        }\n    }\n}",
        "(contract C (a:u256 b:bool) (init (x:u256) (mut a) {(= a x); }) ((recv M ((Inc () ? (mut a) {(+= a 1); }) (Set (a:v b) bool (a mut b) {b})))))",
    )
    item_is("contract E {}", "(contract E () ? ())")
    item_is(
        "contract C uses (ctx: Ctx, b: Ctx,) {\n    mut a: u256\n}",
        "(contract C (ctx:Ctx b:Ctx a:u256) ? ())",
    )
    item_is("contract C uses () {}", "(contract C () ? ())")
    // `mut Ctx` is the same effect as `Ctx` (SPEC §6, "The caller").
    item_is(
        "contract C uses (ctx: mut Ctx) {}",
        "(contract C (ctx:Ctx) ? ())",
    )
}

#[test]
fn item_lines() {
    // Two items may not share a line, but contract members and arms may (SPEC.md §3.1).
    rejects("fn f() {} fn g() {}", P_EXPECTED_END, 10)
    parse_text(
        "contract C { mut a: u256 init() {} recv M { A {} {} B {} {} } }",
    )
    // A selector must end its line.
    assert!(
        parse_err("msg M {\n    #[selector = 1] A\n}").code == P_EXPECTED_TOKEN,
    )
}

#[test]
fn doc_comments() {
    // A doc comment may come in each place that SPEC.md §1 lists.
    parse_text("/// a\n\n//// b\nfn f() {}\n/// c\nconst A: u256 = 1\n")
    parse_text(
        "contract C {\n    /// a\n    mut a: u256\n    /// b\n    init() {}\n    /// c\n    recv M {\n        /// d\n        A {} {}\n    }\n}",
    )
    parse_text(
        "msg M {\n    /// a\n    #[selector = 1]\n    /// b\n    A {\n        /// c\n        v: u256,\n    },\n}",
    )
    // At the end of a member's line or of an opening `{`, and with a plain comment after it.
    parse_text(
        "contract C { /// a\n    mut a: u256 /// b\n    mut b: u256\n    init() {} /// c\n    recv M { /// d\n        A {} {} /// e\n        /// f\n        // g\n        B {} {}\n    } /// h\n    recv N {}\n}",
    )
    parse_text(
        "msg M { /// a\n    #[selector = 1]\n    A {}, /// b\n    #[selector = 2]\n    B { /// c\n        v: u256, /// d\n        w: u256,\n    },\n}",
    )
    // Anywhere else, it is an error.
    assert!(
        parse_err("fn f() {\n    /// a\n    1\n}").code == P_EXPECTED_EXPR,
    )
    assert!(
        parse_err("fn f(x: u256, /// a\n) {}").code == P_EXPECTED_IDENT,
    )
    assert!(
        parse_err("fn f() {} /// a\nfn g() {}").code == P_EXPECTED_END,
    )
    // A doc comment must document something. The error points at the doc comment.
    rejects("fn f() {}\n/// a\n", P_EXPECTED_ITEM, 10)
    rejects(
        "msg M {\n    #[selector = 1]\n    A,\n    /// a\n}",
        P_EXPECTED_TOKEN,
        39,
    )
    assert!(
        parse_err("contract C {\n    /// a\n}").code == P_EXPECTED_TOKEN,
    )
    assert!(
        parse_err("contract C {\n    recv M {\n        /// a\n    }\n}").code == P_EXPECTED_IDENT,
    )
}

#[test]
fn errors() {
    assert!(parse_err("let x = 1").code == P_EXPECTED_ITEM)
    assert!(parse_err("fn (").code == P_EXPECTED_IDENT)
    assert!(parse_err("fn f(x: u8) {}").code == P_EXPECTED_TYPE)
    assert!(parse_err("fn f() { (1 }").code == P_EXPECTED_TOKEN)
    assert!(parse_err("fn f() { 1 + }").code == P_EXPECTED_EXPR)
    assert!(
        parse_err("contract C { x: u256 }").code == P_FIELD_NOT_MUT,
    )
    assert!(
        parse_err("msg M { #[slector = 1] A {} }").code == P_EXPECTED_TOKEN,
    )
    // A contract's effect must have type `Ctx`, or `Log` or `Call` written with `mut`.
    rejects("contract C uses (ctx: u256) {}", P_EXPECTED_TOKEN, 22)
    rejects("contract C uses (call: Call) {}", P_EXPECTED_TOKEN, 23)
    rejects("contract C uses (ctx: mut u256) {}", P_EXPECTED_TOKEN, 26)
    rejects("contract C uses (log: Log) {}", P_EXPECTED_TOKEN, 22)
    rejects("contract C uses (ctx) {}", P_EXPECTED_TOKEN, 20)
    // A lexer error stops the parse.
    assert!(
        parse_err("fn f() { let for = 1 }").code == L_RESERVED_WORD,
    )
    // The error points at the offending token.
    rejects("fn f() { a < b < c }", P_CHAINED_COMPARISON, 15)
}

#[test]
fn int_too_large() {
    // The error points at the literal, in an expression and in a selector.
    rejects(
        "fn f() { 115792089237316195423570985008687907853269984665640564039457584007913129639936 }",
        L_INT_TOO_LARGE,
        9,
    )
    rejects(
        "msg M {\n    #[selector = 0x1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff]\n    A\n}",
        L_INT_TOO_LARGE,
        25,
    )
    // The first error in source order wins.
    rejects(
        "fn f() { 0x1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff + }",
        L_INT_TOO_LARGE,
        9,
    )
    rejects(
        "fn f() { 1 + }\nfn g() { 0x1ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff }",
        P_EXPECTED_EXPR,
        13,
    )
}

#[test]
fn generic_arguments() {
    // Each of these `<` may start generic arguments (SPEC.md §3.2).
    rejects("fn f() { a < b >> c }", P_GENERIC_ARGS, 11)
    assert!(
        parse_err("fn f() { g(a < b, c >> d) }").code == P_GENERIC_ARGS,
    )
    assert!(
        parse_err("fn f() { a < h(b) >= c }").code == P_GENERIC_ARGS,
    )
    assert!(
        parse_err("fn f() { a < {b} >> c }").code == P_GENERIC_ARGS,
    )
    // None of these `<` may start generic arguments.
    parse_text("fn f() { a < b - 1 >> c }")
    parse_text("fn f() { (a) < b >> c }")
    parse_text("fn f() { g(a < b, a <= b, a > b) }")
    parse_text("fn f() { while a < b { c >> d } }")
    parse_text("fn f() { if a < b { b } else if a > c { c } }")
    parse_text("fn f() { a < b | c >> d }")
}

#[test]
fn record_literal() {
    // The record-literal rule of SPEC.md §3.4.
    rejects(
        "fn f() {\n    let a = b\n    { a }\n}",
        P_RECORD_LITERAL,
        27,
    )
    parse_text("fn f() {\n    let a = (b)\n    { a }\n}")
}

#[test]
fn assert_message_length() {
    // 31 bytes after decoding is the limit; `\n` counts as one.
    parse_text(
        "fn f() { assert!(true, \"01234567890123456789012345678\\n\\t\") }",
    )
    let d = parse_err(
        "fn f() { assert!(true, \"01234567890123456789012345678901\") }",
    )
    assert!(d.code == P_MESSAGE_TOO_LONG)
}

#[test]
fn deepest_nesting() {
    assert!(nested("()", DEEPEST_PARENS).is_none())
    assert!(
        nested("()", DEEPEST_PARENS + 1).unwrap().code == P_TOO_DEEP,
    )
    assert!(nested("{}", DEEPEST_BLOCKS).is_none())
    assert!(
        nested("{}", DEEPEST_BLOCKS + 1).unwrap().code == P_TOO_DEEP,
    )
}
