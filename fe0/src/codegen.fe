// Generates EVM deploy code from the checked AST, with no IR (ADR 0007). The design is in
// DESIGN.md §6: the memory layout, the calling convention, what each expression emits, the
// dispatcher and the deployment layout.

use ingot::asm::*
use ingot::ast::*
use ingot::check::{
    Callee,
    Checked,
    Field,
    FIRST_LOG_WORD,
    FrameSlot,
    Id,
    LogWord,
    StoragePlace,
    check,
}
use ingot::diag::*
use ingot::io::Source
use ingot::lexer::*
use ingot::parser::parse

// A number of bytes: of memory, of calldata, of code or of revert data.
struct Size { n: u256 }

impl Copy for Size {}

impl Size {
    fn word(self) -> u256 {
        self.n
    }

    fn plus(self, _ other: Size) -> Size {
        Size { n: self.n + other.n }
    }

    fn is_zero(self) -> bool {
        self.n == 0
    }
}

// An address in memory.
struct MemAddr { a: u256 }

impl Copy for MemAddr {}

impl MemAddr {
    fn word(self) -> u256 {
        self.a
    }

    // Returns the address `size` bytes after this one.
    fn after(self, _ size: Size) -> MemAddr {
        MemAddr { a: self.a + size.n }
    }

    // Returns the address of offset `off` in a frame that starts at this address.
    fn at(self, _ off: FrameOff) -> MemAddr {
        MemAddr { a: self.a + off.o }
    }
}

// An offset from the start of a frame, which FP points at.
struct FrameOff { o: u256 }

impl Copy for FrameOff {}

impl FrameOff {
    fn word(self) -> u256 {
        self.o
    }

    // Returns this offset in the frame that starts `size` bytes after the current one.
    fn past(self, _ size: Size) -> FrameOff {
        FrameOff { o: size.n + self.o }
    }
}

// An offset in calldata.
struct CalldataOff { o: u256 }

impl Copy for CalldataOff {}

impl CalldataOff {
    fn word(self) -> u256 {
        self.o
    }

    // Returns the offset `size` bytes after this one.
    fn after(self, _ size: Size) -> CalldataOff {
        CalldataOff { o: self.o + size.n }
    }
}

// The 4-byte selector that heads calldata and revert data.
struct Selector { v: u256 }

impl Copy for Selector {}

impl Selector {
    fn word(self) -> u256 {
        self.v
    }
}

// The code of a `Panic(code)` revert (SPEC §4).
struct PanicCode { c: u256 }

impl Copy for PanicCode {}

impl PanicCode {
    fn word(self) -> u256 {
        self.c
    }
}

// The memory layout (DESIGN.md §6.1). The table there says what each region holds.
const SCRATCH: MemAddr = MemAddr { a: 0 }
const FP: MemAddr = MemAddr { a: 0x40 }
const FRAMES: MemAddr = MemAddr { a: 0x80 }
const WORD: Size = Size { n: 32 }

// Offsets in a frame (DESIGN.md §6.1, "Frames").
const RET_ADDR: FrameOff = FrameOff { o: 32 }
const FRAME_HEAD: FrameOff = FrameOff { o: 64 }

// The first word of the revert data of `Panic(code)` and `Error(string)` (SPEC §4).
const PANIC_SELECTOR: Selector = Selector { v: 0x4e487b71 }
const ERROR_SELECTOR: Selector = Selector { v: 0x08c379a0 }

// The length of a selector, in calldata and in revert data.
const SELECTOR_BYTES: Size = Size { n: 4 }

// The bytes of a word before a selector that is stored in the word's low bytes.
const SELECTOR_PAD: Size = Size { n: WORD.n - SELECTOR_BYTES.n }

// The start of calldata, where the selector is.
const CALLDATA_START: CalldataOff = CalldataOff { o: 0 }

// The number of bits that moves a selector between the top of a word and its low bytes.
const SELECTOR_SHIFT_BITS: u256 = SELECTOR_PAD.n * 8

// What a stub reverts with.
enum StubRevert {
    Empty,
    Panic(PanicCode),
    // The return data of the external call that failed.
    ReturnData,
}

impl Copy for StubRevert {}

// The three places of the memory layout that take argument words. A call's parameters go in
// the callee's frame. An event's data and an external call's calldata go past the current
// frame (DESIGN.md §6.1 to §6.3).
enum ArgDest {
    // The parameters of a function, in the callee's frame. The size is where that frame starts
    // in this one.
    Params(ListId, Size),
    // The words of the log data, past the frame. Each argument is a field init of an event.
    LogWords,
    // The calldata of an external call, past the frame. Each argument is a field init of the
    // variant whose fields are the list.
    CallArgs(ListId),
}

impl Copy for ArgDest {}

// A shared block that reverts. `index` is its slot in `Refs.stubs`.
struct Stub { index: usize, revert: StubRevert }

impl Copy for Stub {}

const REVERT_EMPTY: Stub = Stub { index: 0, revert: StubRevert::Empty }
const PANIC_ASSERT: Stub = Stub { index: 1, revert: StubRevert::Panic(PanicCode { c: 0x01 }) }
const PANIC_OVERFLOW: Stub = Stub { index: 2, revert: StubRevert::Panic(PanicCode { c: 0x11 }) }
const PANIC_DIV_ZERO: Stub = Stub { index: 3, revert: StubRevert::Panic(PanicCode { c: 0x12 }) }
const REVERT_RETURNDATA: Stub = Stub { index: 4, revert: StubRevert::ReturnData }

// Every stub, at its index.
const ALL_STUBS: [Stub; 5] = [
    REVERT_EMPTY,
    PANIC_ASSERT,
    PANIC_OVERFLOW,
    PANIC_DIV_ZERO,
    REVERT_RETURNDATA,
]

// Warnings never stop the compile, so they come beside the result (DESIGN.md §9).
pub struct Compiled { pub out: Result<Diag, DeployCode>, pub warns: MemVec<Diag> }

// The kind of body being generated, which decides how it leaves.
enum BodyKind {
    Fn,
    // An INIT body jumps to this label when it ends.
    Init(Label),
    Arm,
}

impl Copy for BodyKind {}

// The body being generated: a FN, INIT or ARM.
struct Body {
    kind: BodyKind,
    // The type of the body's value, or TY_UNIT.
    ret: Ty,
    frame: Size,
    // The words that the body has on the stack. Code that leaves early pops them.
    depth: usize,
}

// An enclosing `while`, with the stack depth at its start.
struct Loop { top: Label, end: Label, depth: usize }

impl Copy for Loop {}

// An ARM of the dispatcher, with the label of its code.
struct Case { arm: NodeId, label: Label }

impl Copy for Case {}

// What emitted code leaves on the stack: a word for a value, or nothing for unit.
struct Leaves { word: bool }

impl Copy for Leaves {}

const LEAVES_WORD: Leaves = Leaves { word: true }
const LEAVES_NOTHING: Leaves = Leaves { word: false }

// The initcode and the runtime code each hold their own copy of the functions and stubs they
// jump to (DESIGN.md §6.2, §6.3, "Stubs").
struct Refs {
    // The label of each FN that the code calls, by node. Every other node's slot is empty.
    fn_labels: MemVec<LabelSlot>,
    // The FNs that the code calls and does not hold yet.
    todo: MemVec<Id<Callee>>,
    // The label of each Stub that the code uses, by index. The others' slots are empty.
    stubs: MemVec<LabelSlot>,
}

impl Refs {
    fn new(_ nodes: usize) -> Refs {
        Refs { fn_labels: no_labels(nodes), todo: MemVec::new(), stubs: no_labels(ALL_STUBS.len()) }
    }
}

struct Gen {
    c: Checked,
    // The piece of code being generated: the runtime code, then the initcode.
    asm: Asm,
    refs: Refs,
    body: Body,
    loops: MemVec<Loop>,
}

// Returns the size of `n` bytes.
fn bytes(_ n: usize) -> Size {
    Size { n: n as u256 }
}

// Returns the size of `n` words.
fn words(_ n: usize) -> Size {
    Size { n: WORD.n * (n as u256) }
}

// Returns the size of a selector followed by `n` words, as in calldata and in revert data.
fn selector_and_words(_ n: usize) -> Size {
    SELECTOR_BYTES.plus(words(n))
}

// Returns the address of word `k` of the revert data at SCRATCH, after its selector.
fn revert_word(_ k: usize) -> MemAddr {
    SCRATCH.after(selector_and_words(k))
}

// Returns the calldata offset of argument `k`, after the selector.
fn arg_offset(_ k: usize) -> CalldataOff {
    CALLDATA_START.after(selector_and_words(k))
}

// Returns a table of `n` empty label slots.
fn no_labels(_ n: usize) -> MemVec<LabelSlot> {
    var t: MemVec<LabelSlot> = MemVec::new()
    while t.len() < n {
        t.push(EMPTY_SLOT)
    }
    t
}

// The offset just past the first `n` slots of a frame.
fn past_slots(_ n: usize) -> FrameOff {
    FrameOff { o: FRAME_HEAD.o + words(n).n }
}

// The offset in a frame of slot `slot`.
fn slot_offset(_ slot: FrameSlot) -> FrameOff {
    past_slots(slot.number())
}

// The size of a frame of `slots` slots.
fn frame_size(_ slots: usize) -> Size {
    Size { n: past_slots(slots).word() }
}

impl Gen {
    fn new(_ c: own Checked) -> Gen {
        let nodes = c.ast.node_count()
        Gen {
            c,
            asm: Asm::new(),
            refs: Refs::new(nodes),
            body: Body { kind: BodyKind::Fn, ret: TY_UNIT, frame: bytes(0), depth: 0 },
            loops: MemVec::new(),
        }
    }

    fn node(self, _ i: NodeId) -> Node {
        self.c.ast.node(i)
    }

    fn len(self, _ l: ListId) -> usize {
        self.c.ast.list_len(l)
    }

    // The walks over a list are index loops (docs/WORKAROUNDS.md).
    fn elem(self, _ l: ListId, _ k: usize) -> NodeId {
        self.c.ast.list_at(l, k)
    }

    fn op(mut self, _ o: Op) {
        self.asm.op(o)
    }

    fn push(mut self, _ v: u256) {
        self.asm.push(v)
    }

    // Pops the top word into memory at `a`.
    fn store_at(mut self, _ a: MemAddr) {
        self.push(a.word())
        self.op(OP_MSTORE)
    }

    // Starts a new piece of code and returns the finished one before it.
    fn section(mut self) -> Asm {
        self.refs = Refs::new(self.c.ast.node_count())
        var done = core::mem::replace(mut self.asm, Asm::new())
        done.finish()
        done
    }

    // The label of `s` in the current piece of code. `stubs_end` emits the stub.
    fn stub(mut self, _ s: Stub) -> Label {
        if self.refs.stubs[s.index].is_empty() {
            self.refs.stubs.set(s.index, self.asm.label().slot())
        }
        self.refs.stubs[s.index].label()
    }

    // Jumps to the stub `s` when the word on top of the stack is not zero.
    fn jumpi_to(mut self, _ s: Stub) {
        let l = self.stub(s)
        self.asm.jumpi(l)
    }

    // Emits each stub that the code jumps to.
    fn stubs_end(mut self) {
        for s in ALL_STUBS {
            self.emit_stub(s)
        }
    }

    fn emit_stub(mut self, _ s: Stub) {
        let slot = self.refs.stubs[s.index]
        if slot.is_empty() { return }
        self.asm.bind(slot.label())
        match s.revert {
            StubRevert::Empty => self.revert(bytes(0)),
            StubRevert::Panic(code) => {
                self.selector_at_scratch(PANIC_SELECTOR)
                self.push(code.word())
                self.store_at(revert_word(0))
                self.revert(selector_and_words(1))
            },
            StubRevert::ReturnData => self.revert_returndata(),
        }
    }

    // Stores `selector` at SCRATCH, as the head of revert data.
    fn selector_at_scratch(mut self, _ selector: Selector) {
        self.push(selector.word())
        self.push(SELECTOR_SHIFT_BITS)
        self.op(OP_SHL)
        self.store_at(SCRATCH)
    }

    // Reverts with the first `size` bytes at SCRATCH.
    fn revert(mut self, _ size: Size) {
        self.on_scratch(OP_REVERT, size)
    }

    // Reverts with the return data of the last external call, copied to SCRATCH.
    fn revert_returndata(mut self) {
        self.op(OP_RETURNDATASIZE)
        self.push(0)
        self.push(SCRATCH.word())
        self.op(OP_RETURNDATACOPY)
        self.op(OP_RETURNDATASIZE)
        self.push(SCRATCH.word())
        self.op(OP_REVERT)
    }

    // Returns the first `size` bytes at SCRATCH.
    fn return_memory(mut self, _ size: Size) {
        self.on_scratch(OP_RETURN, size)
    }

    // Emits `o` over the first `size` bytes at SCRATCH.
    fn on_scratch(mut self, _ o: Op, _ size: Size) {
        self.push(size.word())
        self.push(SCRATCH.word())
        self.op(o)
    }

    // The label of FN `f` in the current piece of code. `functions` emits the FN.
    fn fn_label(mut self, _ f: Id<Callee>) -> Label {
        let k = f.node_id().index()
        if self.refs.fn_labels[k].is_empty() {
            self.refs.fn_labels.set(k, self.asm.label().slot())
            self.refs.todo.push(f)
        }
        self.refs.fn_labels[k].label()
    }

    // Emits each FN that the code calls, and each FN that those call.
    fn functions(mut self) {
        while self.refs.todo.len() > 0 {
            let f = self.refs.todo.pop().unwrap().node_id()
            let n = self.node(f)
            self.asm.bind(self.refs.fn_labels[f.index()].label())
            self.begin(f, BodyKind::Fn)
            self.body_end(n.body())
        }
    }

    // Starts the body of FN, INIT or ARM `owner`. INIT and ARM bodies use the first frame
    // (DESIGN.md §6.1).
    fn begin(mut self, _ owner: NodeId, _ kind: BodyKind) {
        let n = self.node(owner)
        let frame = frame_size(self.c.frame_slots(owner))
        self.body = Body { kind, ret: n.ty().or_unit(), frame, depth: 0 }
        match kind {
            BodyKind::Fn => {},
            BodyKind::Init(_) | BodyKind::Arm => {
                self.push(FRAMES.word())
                self.store_at(FP)
            },
        }
    }

    // Emits BLOCK `b` as the whole body, then leaves the body with its value.
    fn body_end(mut self, _ b: NodeId) {
        if self.body.ret == TY_UNIT {
            self.discard(b)
        } else {
            self.value(b)
        }
        self.leave()
    }

    // Gives FP back to the caller and pushes the current frame's return address.
    fn unlink_frame(mut self) {
        self.fp()
        self.op(OP_DUP1)
        self.push(RET_ADDR.word())
        self.op(OP_ADD)
        self.op(OP_MLOAD)
        self.op(OP_SWAP1)
        self.op(OP_MLOAD)
        self.store_at(FP)
    }

    // Leaves the body. Its value, if it has one, is on top of the stack.
    fn leave(mut self) {
        let value = self.body.ret != TY_UNIT
        match self.body.kind {
            BodyKind::Fn => {
                // The caller expects only the value, so drop the words under it.
                var k: usize = if value { 1 } else { 0 }
                while k < self.body.depth {
                    if value { self.op(OP_SWAP1) }
                    self.op(OP_POP)
                    k += 1
                }
                self.unlink_frame()
                self.op(OP_JUMP)
            },
            BodyKind::Arm => {
                if value {
                    self.store_at(SCRATCH)
                    self.return_memory(WORD)
                } else {
                    self.op(OP_STOP)
                }
            },
            BodyKind::Init(exit) => self.asm.jump(exit),
        }
    }

    // Pushes FP.
    fn fp(mut self) {
        self.push(FP.word())
        self.op(OP_MLOAD)
    }

    // Pushes FP + `off`.
    fn fp_plus(mut self, _ off: FrameOff) {
        self.fp()
        self.push(off.word())
        self.op(OP_ADD)
    }

    // The offset in the frame of local, parameter or bind `d`.
    fn local_offset(self, _ d: NodeId) -> FrameOff {
        slot_offset(self.c.frame_slot(d))
    }

    // Pops the top word into the variable that node `d` declares: a local or a contract field.
    fn store(mut self, _ d: NodeId) {
        match self.c.narrow<Field>(d) {
            Option::Some(f) => self.store_field(self.c.storage_place(f)),
            Option::None => {
                self.fp_plus(self.local_offset(d))
                self.op(OP_MSTORE)
            },
        }
        self.body.depth -= 1
    }

    // Pops the top word into the field at `p`. A field that shares its slot replaces only its
    // own bytes of the slot.
    fn store_field(mut self, _ p: StoragePlace) {
        if !p.whole() {
            if p.shift() > 0 {
                self.push(p.shift())
                self.op(OP_SHL)
            }
            self.push(p.slot())
            self.op(OP_SLOAD)
            self.push(p.mask() << p.shift())
            self.op(OP_NOT)
            self.op(OP_AND)
            self.op(OP_OR)
        }
        self.push(p.slot())
        self.op(OP_SSTORE)
    }

    // Pushes the value of the field at `p`.
    fn load_field(mut self, _ p: StoragePlace) {
        self.push(p.slot())
        self.op(OP_SLOAD)
        if p.shift() > 0 {
            self.push(p.shift())
            self.op(OP_SHR)
        }
        if p.shared_above() {
            self.push(p.mask())
            self.op(OP_AND)
        }
    }

    // Pushes the value of the name that node `d` declares: a constant, a field or a local.
    fn load(mut self, _ d: NodeId) {
        if self.node(d).kind == NODE_CONST {
            self.push(self.c.word_of(d))
        } else {
            match self.c.narrow<Field>(d) {
                Option::Some(f) => self.load_field(self.c.storage_place(f)),
                Option::None => {
                    self.fp_plus(self.local_offset(d))
                    self.op(OP_MLOAD)
                },
            }
        }
        self.body.depth += 1
    }

    // Reverts with empty data unless the top word is a valid ABI word of type `ty` (SPEC §6).
    fn validate(mut self, _ ty: Ty) {
        if ty == TY_BOOL {
            self.op(OP_DUP1)
            self.push(1)
            self.op(OP_LT)
        } else if ty == TY_ADDRESS {
            self.op(OP_DUP1)
            self.push(160)
            self.op(OP_SHR)
        } else {
            return
        }
        self.jumpi_to(REVERT_EMPTY)
    }

    // Reverts with empty data when the call carries value.
    fn non_payable(mut self) {
        self.op(OP_CALLVALUE)
        self.jumpi_to(REVERT_EMPTY)
    }

    // Reverts with empty data unless calldata holds at least `size` bytes.
    fn require_calldata(mut self, _ size: Size) {
        self.push(size.word())
        self.op(OP_CALLDATASIZE)
        self.op(OP_LT)
        self.jumpi_to(REVERT_EMPTY)
    }

    // The runtime code: the dispatcher (DESIGN.md §6.4), the arms and what they call.
    fn runtime(mut self, _ c: NodeId) {
        self.non_payable()
        self.load_selector()
        let cases = self.cases(c)
        // ponytail: a linear chain of EQs; sort and bisect, like Fe, if gas matters.
        var i: usize = 0
        while i < cases.len() {
            let case = cases[i]
            self.op(OP_DUP1)
            self.push(self.selector_of(case.arm).word())
            self.op(OP_EQ)
            self.asm.jumpi(case.label)
            i += 1
        }
        self.asm.jump(self.stub(REVERT_EMPTY))
        i = 0
        while i < cases.len() {
            let case = cases[i]
            self.asm.bind(case.label)
            self.arm(case.arm)
            i += 1
        }
        self.functions()
        self.stubs_end()
    }

    // Pushes the call's selector, or reverts with empty data when calldata is too short for one.
    fn load_selector(mut self) {
        self.require_calldata(SELECTOR_BYTES)
        self.push(CALLDATA_START.word())
        self.op(OP_CALLDATALOAD)
        self.push(SELECTOR_SHIFT_BITS)
        self.op(OP_SHR)
    }

    // Returns the selector of the msg variant that ARM `arm` handles.
    fn selector_of(self, _ arm: NodeId) -> Selector {
        Selector { v: self.c.selector(self.c.variant_of(arm)) }
    }

    // The ARMs of every RECV of contract `c`, in order, each with a new label.
    fn cases(mut self, _ c: NodeId) -> MemVec<Case> {
        var cases: MemVec<Case> = MemVec::new()
        let recvs = self.node(c).recvs()
        var r: usize = 0
        while r < self.len(recvs) {
            let l = self.node(self.elem(recvs, r)).list()
            var k: usize = 0
            while k < self.len(l) {
                cases.push(Case { arm: self.elem(l, k), label: self.asm.label() })
                k += 1
            }
            r += 1
        }
        cases
    }

    // Emits ARM `a`, which decodes its arguments into its frame and runs its body.
    fn arm(mut self, _ a: NodeId) {
        let n = self.node(a)
        let fields = self.c.variant_fields(self.c.variant_of(a))
        self.begin(a, BodyKind::Arm)
        self.require_calldata(selector_and_words(self.len(fields)))
        var k: usize = 0
        while k < self.len(n.list()) {
            let b = self.elem(n.list(), k)
            self.push(
                arg_offset(self.index_of(fields, self.c.field_of(b))).word(),
            )
            self.op(OP_CALLDATALOAD)
            self.body.depth += 1
            let ty = self.c.ty(b)
            self.validate(ty)
            self.store(b)
            k += 1
        }
        self.body_end(n.body())
    }

    // The position of node `i` in list `l`, which holds it.
    fn index_of(self, _ l: ListId, _ f: Id<Field>) -> usize {
        var k: usize = 0
        while self.elem(l, k) != f.node_id() {
            k += 1
        }
        k
    }

    // The initcode for a runtime of `rt` bytes: checks and copies the constructor arguments,
    // runs `init`, then returns the runtime code (DESIGN.md §6.5).
    fn initcode(mut self, _ c: NodeId, _ rt: Size) {
        // The end of the initcode, which is where the runtime code starts.
        let end = self.asm.label()
        self.non_payable()
        let init = self.node(c).init()
        if !init.is_none() {
            self.init_args(init, rt, end)
            let exit = self.asm.label()
            self.begin(init, BodyKind::Init(exit))
            self.body_end(self.node(init).body())
            self.asm.bind(exit)
        }
        self.push(rt.word())
        self.asm.push_label(end)
        self.push(SCRATCH.word())
        self.op(OP_CODECOPY)
        self.return_memory(rt)
        self.functions()
        self.stubs_end()
        self.asm.mark(end)
    }

    // Checks the arguments of INIT `init`, copies them from the code into its frame and
    // validates them. They follow the `rt` bytes of runtime code, which start at `end`.
    fn init_args(mut self, _ init: NodeId, _ rt: Size, _ end: Label) {
        let params = self.node(init).list()
        let args = words(self.len(params))
        // Extra bytes after the arguments are ignored.
        self.push(rt.plus(args).word())
        self.asm.push_label(end)
        self.op(OP_ADD)
        self.op(OP_CODESIZE)
        self.op(OP_LT)
        self.jumpi_to(REVERT_EMPTY)
        self.push(args.word())
        self.push(rt.word())
        self.asm.push_label(end)
        self.op(OP_ADD)
        self.push(FRAMES.at(FRAME_HEAD).word())
        self.op(OP_CODECOPY)
        var k: usize = 0
        while k < self.len(params) {
            let param = self.elem(params, k)
            self.push(FRAMES.at(self.local_offset(param)).word())
            self.op(OP_MLOAD)
            self.validate(self.node(param).ty())
            self.op(OP_POP)
            k += 1
        }
    }

    // Emits expression `i` and returns what it leaves on the stack. An expression of type
    // TY_NEVER may leave either, since no code runs after it.
    fn expr(mut self, _ i: NodeId) -> Leaves {
        let n = self.node(i)
        let k = n.kind
        if k == NODE_INT {
            self.push(self.c.ast.word_value(i))
        } else if k == NODE_BOOL {
            self.push(flag(n.is_true()))
        } else if k == NODE_NAME {
            let d = self.c.declaration(i).node_id()
            self.load(d)
            return LEAVES_WORD
        } else if k == NODE_BINARY {
            self.binary(i)
            return LEAVES_WORD
        } else if k == NODE_UNARY {
            self.value(n.operand())
            if n.op() != O_PLUS {
                self.op(if n.op() == O_BANG { OP_ISZERO } else { OP_NOT })
            }
            return LEAVES_WORD
        } else if k == NODE_CALL {
            return self.call(i)
        } else if k == NODE_IF {
            return self.if_expr(i)
        } else if k == NODE_BLOCK {
            return self.block(i)
        } else if k == NODE_CTX_READ {
            self.op(self.c.ctx_op(i))
        } else if k == NODE_ZERO_ADDRESS {
            self.push(0)
        } else if k == NODE_INDEX {
            self.entry_slot(i)
            self.op(OP_SLOAD)
            return LEAVES_WORD
        } else if k == NODE_EMIT {
            self.emit(i)
            return LEAVES_NOTHING
        } else if k == NODE_MSG_CALL {
            return self.msg_call(i)
        } else {
            // NODE_ASSERT, the only other kind of expression.
            self.assert(i)
            return LEAVES_NOTHING
        }
        self.body.depth += 1
        LEAVES_WORD
    }

    // Emits expression `i` so that it leaves one word.
    fn value(mut self, _ i: NodeId) {
        if !self.expr(i).word {
            // An expression of type TY_NEVER may leave no word. Count one anyway, because the
            // code after it expects one, and that code never runs.
            self.body.depth += 1
        }
    }

    // Emits expression `i` for its effects only.
    fn discard(mut self, _ i: NodeId) {
        if self.expr(i).word {
            self.op(OP_POP)
            self.body.depth -= 1
        }
    }

    fn binary(mut self, _ i: NodeId) {
        let n = self.node(i)
        let op = n.op()
        if op == O_ANDAND || op == O_OROR {
            self.short_circuit(i)
            return
        }
        self.value(n.lhs())
        self.value(n.rhs())
        self.apply(op)
    }

    // `a && b` or `a || b`: `b` runs only when `a` does not decide the result.
    fn short_circuit(mut self, _ i: NodeId) {
        let n = self.node(i)
        let end = self.asm.label()
        self.value(n.lhs())
        self.op(OP_DUP1)
        if n.op() == O_ANDAND {
            self.op(OP_ISZERO)
        }
        self.asm.jumpi(end)
        self.op(OP_POP)
        self.body.depth -= 1
        self.value(n.rhs())
        self.asm.bind(end)
    }

    // Replaces the top two words, `a` under `b`, with `a op b`, checked as SPEC §4 says.
    fn apply(mut self, _ op: Tok) {
        self.body.depth -= 1
        if op == O_PLUS {
            // Overflow iff the sum is less than `a`.
            self.op(OP_DUP2)
            self.op(OP_ADD)
            self.op(OP_DUP1)
            self.op(OP_SWAP2)
            self.op(OP_GT)
            self.jumpi_to(PANIC_OVERFLOW)
        } else if op == O_MINUS {
            self.op(OP_DUP2)
            self.op(OP_DUP2)
            self.op(OP_GT)
            self.jumpi_to(PANIC_OVERFLOW)
            self.op(OP_SWAP1)
            self.op(OP_SUB)
        } else if op == O_STAR {
            self.mul()
        } else if op == O_SLASH || op == O_PERCENT {
            self.op(OP_DUP1)
            self.op(OP_ISZERO)
            self.jumpi_to(PANIC_DIV_ZERO)
            self.op(OP_SWAP1)
            self.op(if op == O_SLASH { OP_DIV } else { OP_MOD })
        } else if op == O_LT {
            self.op(OP_GT)
        } else if op == O_GT {
            self.op(OP_LT)
        } else if op == O_LE {
            self.op(OP_LT)
            self.op(OP_ISZERO)
        } else if op == O_GE {
            self.op(OP_GT)
            self.op(OP_ISZERO)
        } else if op == O_EQ {
            self.op(OP_EQ)
        } else if op == O_NE {
            self.op(OP_EQ)
            self.op(OP_ISZERO)
        } else {
            self.op(bitwise(op))
        }
    }

    // Emits `a * b`. It overflows when `a` is not zero and `(a * b) / a` is not `b`.
    fn mul(mut self) {
        self.op(OP_DUP2)
        self.op(OP_DUP2)
        self.op(OP_MUL)
        // a b r
        self.op(OP_DUP3)
        self.op(OP_DUP2)
        self.op(OP_DIV)
        self.op(OP_DUP3)
        self.op(OP_EQ)
        self.op(OP_DUP4)
        self.op(OP_ISZERO)
        self.op(OP_OR)
        self.op(OP_ISZERO)
        self.jumpi_to(PANIC_OVERFLOW)
        self.op(OP_SWAP2)
        self.op(OP_POP)
        self.op(OP_POP)
    }

    // Pushes the value of each field init or argument of `l`, in order.
    fn values(mut self, _ l: ListId) {
        var k: usize = 0
        while k < self.len(l) {
            self.value(self.node(self.elem(l, k)).value())
            k += 1
        }
    }

    // The values are evaluated in the order written, not in field order (SPEC.md §4). A call in a
    // later value puts its frame past the current one, where these values go (DESIGN.md §6.1,
    // §6.2). So no value is stored until all of them are evaluated.
    fn store_args(mut self, _ args: ListId, _ dest: ArgDest) {
        self.values(args)
        var k = self.len(args)
        while k > 0 {
            k -= 1
            self.fp_plus(self.dest_offset(dest, self.elem(args, k), k))
            self.op(OP_MSTORE)
        }
        self.body.depth -= self.len(args)
    }

    fn dest_offset(self, _ dest: ArgDest, _ a: NodeId, _ k: usize) -> FrameOff {
        match dest {
            ArgDest::Params(params, next) => self.local_offset(self.elem(params, k)).past(next),
            ArgDest::LogWords => self.log_offset(self.c.log_word(self.c.field_of(a))),
            ArgDest::CallArgs(fields) => self.call_arg_offset(
                self.index_of(fields, self.c.field_of(a)),
            ),
        }
    }

    // Emits CALL `i`, by the calling convention of DESIGN.md §6.2.
    fn call(mut self, _ i: NodeId) -> Leaves {
        let f = self.c.callee(i)
        let callee = self.node(f.node_id())
        let args = self.node(i).list()
        let params = callee.list()
        // The callee's frame starts where this body's ends.
        let next = self.body.frame
        self.store_args(args, ArgDest::Params(params, next))
        let back = self.asm.label()
        self.asm.push_label(back)
        self.fp_plus(RET_ADDR.past(next))
        self.op(OP_MSTORE)
        self.link_frame(next)
        self.asm.jump(self.fn_label(f))
        self.asm.bind(back)
        if callee.ty() == TY_NONE {
            return LEAVES_NOTHING
        }
        self.body.depth += 1
        LEAVES_WORD
    }

    // Moves FP `next` bytes forward, to the callee's frame. The callee's frame keeps the old
    // FP in its first word, so that `unlink_frame` can give it back.
    fn link_frame(mut self, _ next: Size) {
        self.fp()
        self.op(OP_DUP1)
        self.push(next.word())
        self.op(OP_ADD)
        self.op(OP_DUP1)
        self.op(OP_SWAP2)
        self.op(OP_SWAP1)
        self.op(OP_MSTORE)
        self.store_at(FP)
    }

    // IF `i` and its `else if` chain, in a loop as the checker reads it.
    fn if_expr(mut self, _ i: NodeId) -> Leaves {
        let has_value = self.c.ty(i) != TY_UNIT
        let base = self.body.depth
        let end = self.asm.label()
        var at = i
        while true {
            let n = self.node(at)
            let next = self.asm.label()
            self.jump_unless(n.cond(), next)
            self.branch(n.body(), has_value)
            self.body.depth = base
            self.asm.jump(end)
            self.asm.bind(next)
            let e = n.otherwise()
            if e.is_none() { break }
            if self.node(e).kind != NODE_IF {
                self.branch(e, has_value)
                self.body.depth = base
                break
            }
            at = e
        }
        self.asm.bind(end)
        if !has_value {
            return LEAVES_NOTHING
        }
        self.body.depth = base + 1
        LEAVES_WORD
    }

    // Emits condition `cond` and jumps to `to` when it is false.
    fn jump_unless(mut self, _ cond: NodeId, _ to: Label) {
        self.value(cond)
        self.body.depth -= 1
        self.op(OP_ISZERO)
        self.asm.jumpi(to)
    }

    fn branch(mut self, _ b: NodeId, _ has_value: bool) {
        if has_value {
            self.value(b)
        } else {
            self.discard(b)
        }
    }

    fn block(mut self, _ i: NodeId) -> Leaves {
        let n = self.node(i)
        var k: usize = 0
        while k < self.len(n.list()) {
            self.stmt(self.elem(n.list(), k))
            k += 1
        }
        if n.value().is_none() {
            return LEAVES_NOTHING
        }
        self.expr(n.value())
    }

    fn stmt(mut self, _ i: NodeId) {
        let n = self.node(i)
        let k = n.kind
        if k == NODE_LET {
            self.value(n.as_let().value())
            self.store(i)
        } else if k == NODE_WHILE {
            self.while_stmt(i)
        } else if k == NODE_RETURN {
            self.return_stmt(i)
        } else if k == NODE_BREAK || k == NODE_CONTINUE {
            let l = self.loops[self.loops.len() - 1]
            self.drop_to(l.depth)
            self.asm.jump(if k == NODE_BREAK { l.end } else { l.top })
        } else if k == NODE_ASSIGN {
            if self.node(n.place()).kind == NODE_INDEX {
                self.assign_entry(i)
            } else {
                self.assign(i)
            }
        } else {
            self.discard(i)
        }
    }

    // Pops the words above stack depth `depth`, for code that leaves early. The words stay
    // counted, for the code after it, which never runs.
    fn drop_to(mut self, _ depth: usize) {
        var k = depth
        while k < self.body.depth {
            self.op(OP_POP)
            k += 1
        }
    }

    fn return_stmt(mut self, _ i: NodeId) {
        let v = self.node(i).value()
        let before = self.body.depth
        if self.body.ret == TY_UNIT {
            // A unit body may still return a unit expression, such as a call.
            if !v.is_none() {
                self.discard(v)
            }
        } else {
            self.value(v)
        }
        self.leave()
        self.body.depth = before
    }

    fn while_stmt(mut self, _ i: NodeId) {
        let n = self.node(i)
        let top = self.asm.label()
        let end = self.asm.label()
        self.asm.bind(top)
        self.jump_unless(n.cond(), end)
        self.loops.push(Loop { top, end, depth: self.body.depth })
        self.discard(n.body())
        let _ = self.loops.pop()
        self.asm.jump(top)
        self.asm.bind(end)
    }

    // `x = e` or `x op= e`.
    fn assign(mut self, _ i: NodeId) {
        let n = self.node(i)
        let d = self.c.declaration(n.place()).node_id()
        if n.op() == O_ASSIGN {
            self.value(n.value())
        } else {
            self.load(d)
            self.value(n.value())
            self.apply(n.op().plain_form())
        }
        self.store(d)
    }

    // `m[k] = e` or `m[k] op= e`. Fe evaluates `e` before `k` (SPEC §4).
    fn assign_entry(mut self, _ i: NodeId) {
        let n = self.node(i)
        self.value(n.value())
        self.entry_slot(n.place())
        if n.op() != O_ASSIGN {
            // e slot -> slot old e
            self.op(OP_SWAP1)
            self.op(OP_DUP2)
            self.op(OP_SLOAD)
            self.op(OP_SWAP1)
            self.body.depth += 1
            self.apply(n.op().plain_form())
            self.op(OP_SWAP1)
        }
        self.op(OP_SSTORE)
        self.body.depth -= 2
    }

    // Pushes the storage slot of the map entry that INDEX `i` names (SPEC §6, "Maps").
    fn entry_slot(mut self, _ i: NodeId) {
        self.value(self.node(i).key())
        self.store_at(SCRATCH)
        self.push(
            self.c
                .storage_place(
                    self.c.narrow<Field>(self.c.declaration(i).node_id()).unwrap(),
                )
                .slot(),
        )
        self.store_at(SCRATCH.after(WORD))
        self.on_scratch(OP_KECCAK256, words(2))
    }

    // Emits `log.emit(E { … })` as one LOGn (SPEC §6, "Events").
    fn emit(mut self, _ i: NodeId) {
        let e = self.c.event_of(i)
        let args = self.node(i).list()
        self.store_args(args, ArgDest::LogWords)
        // LOGn takes the offset on top, then the size, topic 0, topic 1 and the later topics.
        // So the last indexed field is pushed first.
        let data = self.c.data_words(e)
        var w = self.len(self.c.event_fields(e))
        let indexed = w - data
        while w > data {
            w -= 1
            self.fp_plus(self.log_offset(LogWord::at(w)))
            self.op(OP_MLOAD)
        }
        self.push(self.c.topic0(e))
        self.push(words(data).word())
        self.fp_plus(self.log_offset(FIRST_LOG_WORD))
        self.op(log_op(indexed + 1))
    }

    // The offset in the frame of word `w` of the log data, which starts where the frame ends.
    fn log_offset(self, _ w: LogWord) -> FrameOff {
        self.past_frame(words(w.number()))
    }

    // The offset `size` bytes past the end of the current frame.
    fn past_frame(self, _ size: Size) -> FrameOff {
        FrameOff { o: 0 }.past(self.body.frame.plus(size))
    }

    // The offset in the frame of the calldata of an external call, which is past the frame
    // (DESIGN.md §6.3).
    fn call_data(self) -> FrameOff {
        self.past_frame(SELECTOR_PAD)
    }

    // The offset in the frame of argument `k` of the calldata of an external call.
    fn call_arg_offset(self, _ k: usize) -> FrameOff {
        self.call_data().past(selector_and_words(k))
    }

    // Emits `a.call(M::V { … })` as one CALL (SPEC §6, "Calls"). The calldata layout is in
    // DESIGN.md §6.3.
    //
    // It stays one function. Moving the decoding of the return word into its own function made
    // Back 20 bytes larger. Moving the CALL as well made it 48 bytes larger (Fe 26.6.0, -O s,
    // Nov 14).
    fn msg_call(mut self, _ i: NodeId) -> Leaves {
        let n = self.node(i)
        let v = self.c.variant_of(i)
        let fields = self.c.variant_fields(v)
        let args = n.list()
        // The order of evaluation is in SPEC §4.
        self.value(n.target())
        self.store_args(args, ArgDest::CallArgs(fields))
        // The selector goes in the low bytes of the word where the frame ends.
        self.push(self.c.selector(v))
        self.fp_plus(self.past_frame(bytes(0)))
        self.op(OP_MSTORE)
        // CALL takes the gas on top, then the address, the value, the calldata's offset and size,
        // and the offset and size of the return data to copy, which is none.
        // a -> 0 0 size offset 0 a
        self.push(0)
        self.push(selector_and_words(self.len(fields)).word())
        self.fp_plus(self.call_data())
        self.push(0)
        self.push(0)
        self.op(OP_SWAP5)
        self.op(OP_GAS)
        self.op(OP_CALL)
        self.op(OP_ISZERO)
        self.jumpi_to(REVERT_RETURNDATA)
        self.body.depth -= 1
        let ty = self.c.ty(i)
        if ty == TY_UNIT {
            return LEAVES_NOTHING
        }
        // Decodes the return value as SPEC §6, "Calls" says.
        self.push(WORD.word())
        self.op(OP_RETURNDATASIZE)
        self.op(OP_LT)
        self.jumpi_to(REVERT_EMPTY)
        self.push(WORD.word())
        self.push(0)
        self.push(SCRATCH.word())
        self.op(OP_RETURNDATACOPY)
        self.push(SCRATCH.word())
        self.op(OP_MLOAD)
        self.body.depth += 1
        self.validate(ty)
        LEAVES_WORD
    }

    // `assert!(c)` reverts with Panic(0x01), and `assert!(c, "m")` with Error("m") (SPEC §4).
    fn assert(mut self, _ i: NodeId) {
        let n = self.node(i)
        if n.message().is_none() {
            self.jump_unless(n.cond(), self.stub(PANIC_ASSERT))
            return
        }
        self.value(n.cond())
        self.body.depth -= 1
        let ok = self.asm.label()
        self.asm.jumpi(ok)
        let m = self.node(n.message())
        // The ABI encoding of a string: its offset, its length, then its bytes padded to a word.
        // A message has at most 31 bytes, so they fit in one word (SPEC §1).
        self.selector_at_scratch(ERROR_SELECTOR)
        self.push(WORD.word())
        self.store_at(revert_word(0))
        let len = bytes(m.str_len())
        self.push(len.word())
        self.store_at(revert_word(1))
        var count: usize = 2
        if !len.is_zero() {
            self.push(self.c.ast.word_value(n.message()))
            self.store_at(revert_word(2))
            count = 3
        }
        self.revert(selector_and_words(count))
        self.asm.bind(ok)
    }
}

// The opcode of bitwise or shift operator `op`. The shift amount is on top, as SHL and SHR take
// it.
fn bitwise(_ op: Tok) -> Op {
    if op == O_AMP {
        OP_AND
    } else if op == O_PIPE {
        OP_OR
    } else if op == O_CARET {
        OP_XOR
    } else if op == O_SHL { OP_SHL } else { OP_SHR }
}

// Returns the deploy code of `c`. Errors with G_NO_CONTRACT when `c` has no contract, and with
// G_CODE_TOO_LARGE when the code is too big.
pub fn generate(_ c: own Checked) -> Result<Diag, DeployCode> {
    var g = Gen::new(c)
    let the_contract = g.c.the_contract
    if the_contract.is_none() {
        return Result::Err(diag(G_NO_CONTRACT, SOURCE_START))
    }
    g.runtime(the_contract)
    let runtime = g.section()
    g.initcode(the_contract, bytes(runtime.len()))
    let init = g.section()
    if runtime.too_large() || init.too_large() {
        return Result::Err(diag(G_CODE_TOO_LARGE, g.node(the_contract).pos()))
    }
    Result::Ok(DeployCode::of(init, runtime))
}

// Compiles the program that `input` holds.
pub fn compile() -> Compiled uses (input: mut Source) {
    let checked = check(parse())
    let out = match checked.err {
        Option::Some(d) => Result::Err(d),
        Option::None => generate(checked.program),
    }
    Compiled { out, warns: checked.warns }
}
