// Generates EVM deploy code from the checked AST, with no IR (ADR 0007). The design is in
// DESIGN.md §6: the memory layout, the calling convention, what each expression emits, the
// dispatcher and the deployment layout.

use ingot::asm::*
use ingot::ast::*
use ingot::check::{Checked, check}
use ingot::diag::*
use ingot::io::Source
use ingot::lexer::*
use ingot::parser::parse

// The memory layout (DESIGN.md §6.1): the frame pointer's address, and where frames start.
const FP: u256 = 0x40
const FRAMES: u256 = 0x80
const WORD: u256 = 32

// Offsets in a frame: the caller's FP is at 0, then the return address, then parameters and
// locals.
const RET_ADDR: u256 = 32
const FRAME_HEAD: u256 = 64

// The first word of the revert data of `Panic(code)` and `Error(string)` (SPEC §4).
const PANIC_SELECTOR: u256 = 0x4e487b71
const ERROR_SELECTOR: u256 = 0x08c379a0

// The length of a selector, in calldata and in revert data.
const SELECTOR_BYTES: u256 = 4

// The shift that moves a selector between the top of a word and its low bytes.
const SELECTOR_SHIFT: u256 = 224

// A shared block that reverts. `panic` is its Panic code, or 0 for a revert with empty data.
struct Stub { index: usize, panic: u256 }

impl Copy for Stub {}

const REVERT_EMPTY: Stub = Stub { index: 0, panic: 0 }
const PANIC_ASSERT: Stub = Stub { index: 1, panic: 0x01 }
const PANIC_OVERFLOW: Stub = Stub { index: 2, panic: 0x11 }
const PANIC_DIV_ZERO: Stub = Stub { index: 3, panic: 0x12 }

// Every stub, at its index.
const ALL_STUBS: [Stub; 4] = [REVERT_EMPTY, PANIC_ASSERT, PANIC_OVERFLOW, PANIC_DIV_ZERO]

// The deploy code of a program: the initcode, then the runtime code (DESIGN.md §6.5). On error,
// `err` holds the first error and `code` is empty.
pub struct Output {
    pub code: MemVec<u8>,
    pub err: Option<Diag>,
    // The checker's warnings.
    pub warns: MemVec<Diag>,
}

// The body being generated: a FN, INIT or ARM.
struct Body {
    kind: Kind,
    // The type of the body's value, or TY_UNIT.
    ret: Ty,
    // The size of the frame in bytes.
    frame: u256,
    // The words that the body has on the stack. Code that leaves early pops them.
    depth: usize,
    // Where an INIT body jumps when it ends. Empty for FN and ARM bodies, which leave without it.
    exit: LabelSlot,
}

// An enclosing `while`, with the stack depth at its start.
struct Loop { top: Label, end: Label, depth: usize }

impl Copy for Loop {}

// An ARM of the dispatcher, with the label of its code.
struct Case { arm: usize, label: Label }

impl Copy for Case {}

struct Gen {
    c: Checked,
    // The piece of code being generated: the runtime code, then the initcode.
    asm: Asm,
    // The label of each FN that `asm` calls, by node. Every other node's slot is empty.
    fn_labels: MemVec<LabelSlot>,
    // The FNs that `asm` calls and does not hold yet.
    todo: MemVec<usize>,
    // The label of each Stub that `asm` uses, by index. The others' slots are empty.
    stubs: MemVec<LabelSlot>,
    body: Body,
    loops: MemVec<Loop>,
}

fn words(_ n: usize) -> u256 {
    WORD * (n as u256)
}

// Returns a table of `n` empty label slots.
fn no_labels(_ n: usize) -> MemVec<LabelSlot> {
    var t: MemVec<LabelSlot> = MemVec::new()
    while t.len() < n {
        t.push(EMPTY_SLOT)
    }
    t
}

// The offset in a frame of slot `slot`. Parameters take the first slots, in order.
fn slot_offset(_ slot: usize) -> u256 {
    FRAME_HEAD + words(slot)
}

impl Gen {
    fn new(_ c: own Checked) -> Gen {
        let nodes = c.ast.nodes.len()
        Gen {
            c,
            asm: Asm::new(),
            fn_labels: no_labels(nodes),
            todo: MemVec::new(),
            stubs: no_labels(ALL_STUBS.len()),
            body: Body { kind: NODE_NONE, ret: TY_UNIT, frame: 0, depth: 0, exit: EMPTY_SLOT },
            loops: MemVec::new(),
        }
    }

    fn node(self, _ i: usize) -> Node {
        self.c.ast.nodes[i]
    }

    fn len(self, _ l: usize) -> usize {
        self.c.ast.list_len(l)
    }

    fn elem(self, _ l: usize, _ k: usize) -> usize {
        self.c.ast.list_at(l, k)
    }

    fn op(mut self, _ o: Op) {
        self.asm.op(o)
    }

    fn push(mut self, _ v: u256) {
        self.asm.push(v)
    }

    // Starts a new piece of code and returns the finished one before it.
    fn section(mut self) -> Asm {
        self.fn_labels = no_labels(self.fn_labels.len())
        self.stubs = no_labels(ALL_STUBS.len())
        var done = core::mem::replace(mut self.asm, Asm::new())
        done.finish()
        done
    }

    // The label of `s` in the current piece of code. `stubs_end` emits the stub.
    fn stub(mut self, _ s: Stub) -> Label {
        if self.stubs[s.index].is_empty() {
            self.stubs.set(s.index, self.asm.label().slot())
        }
        self.stubs[s.index].label()
    }

    // Emits each stub that the code jumps to.
    fn stubs_end(mut self) {
        for s in ALL_STUBS {
            self.emit_stub(s)
        }
    }

    fn emit_stub(mut self, _ s: Stub) {
        let slot = self.stubs[s.index]
        if slot.is_empty() { return }
        self.asm.bind(slot.label())
        if s.panic != 0 {
            self.selector_at_0(PANIC_SELECTOR)
            self.push(s.panic)
            self.push(SELECTOR_BYTES)
            self.op(OP_MSTORE)
            self.revert(SELECTOR_BYTES + WORD)
        } else {
            self.revert(0)
        }
    }

    // Stores the 4-byte `selector` at memory 0, as the head of revert data.
    fn selector_at_0(mut self, _ selector: u256) {
        self.push(selector)
        self.push(SELECTOR_SHIFT)
        self.op(OP_SHL)
        self.push(0)
        self.op(OP_MSTORE)
    }

    // Reverts with the first `size` bytes of memory.
    fn revert(mut self, _ size: u256) {
        self.push(size)
        self.push(0)
        self.op(OP_REVERT)
    }

    // Returns the first `size` bytes of memory.
    fn return_memory(mut self, _ size: u256) {
        self.push(size)
        self.push(0)
        self.op(OP_RETURN)
    }

    // The label of FN `f` in the current piece of code. `functions` emits the FN.
    fn fn_label(mut self, _ f: usize) -> Label {
        if self.fn_labels[f].is_empty() {
            self.fn_labels.set(f, self.asm.label().slot())
            self.todo.push(f)
        }
        self.fn_labels[f].label()
    }

    // Emits each FN that the code calls, and each FN that those call.
    fn functions(mut self) {
        while self.todo.len() > 0 {
            let f = self.todo.pop().unwrap()
            let n = self.node(f)
            self.asm.bind(self.fn_labels[f].label())
            self.begin(f)
            self.body_end(n.body())
        }
    }

    // Starts the body of FN, INIT or ARM `owner`. INIT and ARM bodies use the first frame
    // (DESIGN.md §6.1).
    fn begin(mut self, _ owner: usize) {
        let n = self.node(owner)
        let kind = n.kind
        let frame = slot_offset(self.c.slots[owner])
        self.body = Body { kind, ret: n.ty().or_unit(), frame, depth: 0, exit: EMPTY_SLOT }
        if kind != NODE_FN {
            self.push(FRAMES)
            self.push(FP)
            self.op(OP_MSTORE)
        }
    }

    // Emits BLOCK `b` as the whole body, then leaves the body with its value.
    fn body_end(mut self, _ b: usize) {
        if self.body.ret == TY_UNIT {
            self.discard(b)
        } else {
            self.value(b)
        }
        self.leave()
    }

    // Leaves the body. Its value, if it has one, is on top of the stack.
    fn leave(mut self) {
        let value = self.body.ret != TY_UNIT
        let kind = self.body.kind
        if kind == NODE_FN {
            // The caller expects only the value, so drop the words under it.
            var k: usize = if value { 1 } else { 0 }
            while k < self.body.depth {
                if value { self.op(OP_SWAP1) }
                self.op(OP_POP)
                k += 1
            }
            // Jump to the return address, with the caller's FP back.
            self.fp()
            self.op(OP_DUP1)
            self.push(RET_ADDR)
            self.op(OP_ADD)
            self.op(OP_MLOAD)
            self.op(OP_SWAP1)
            self.op(OP_MLOAD)
            self.push(FP)
            self.op(OP_MSTORE)
            self.op(OP_JUMP)
        } else if kind == NODE_ARM {
            if value {
                self.push(0)
                self.op(OP_MSTORE)
                self.return_memory(WORD)
            } else {
                self.op(OP_STOP)
            }
        } else {
            self.asm.jump(self.body.exit.label())
        }
    }

    // Pushes FP.
    fn fp(mut self) {
        self.push(FP)
        self.op(OP_MLOAD)
    }

    // Pushes FP + `off`.
    fn fp_plus(mut self, _ off: u256) {
        self.fp()
        self.push(off)
        self.op(OP_ADD)
    }

    // The offset in the frame of local, parameter or bind `d`.
    fn local_offset(self, _ d: usize) -> u256 {
        slot_offset(self.c.slots[d])
    }

    // Pops the top word into the variable that node `d` declares: a local or a contract field.
    fn store(mut self, _ d: usize) {
        if self.node(d).kind == NODE_FIELD {
            self.push(self.c.slots[d] as u256)
            self.op(OP_SSTORE)
        } else {
            self.fp_plus(self.local_offset(d))
            self.op(OP_MSTORE)
        }
        self.body.depth -= 1
    }

    // Pushes the value of the name that node `d` declares: a constant, a field or a local.
    fn load(mut self, _ d: usize) {
        let k = self.node(d).kind
        if k == NODE_CONST {
            let v = self.c.ast.words[self.c.slots[d]]
            self.push(v)
        } else if k == NODE_FIELD {
            self.push(self.c.slots[d] as u256)
            self.op(OP_SLOAD)
        } else {
            self.fp_plus(self.local_offset(d))
            self.op(OP_MLOAD)
        }
        self.body.depth += 1
    }

    // Reverts with empty data unless the top word is a valid ABI word of type `ty` (SPEC §6).
    fn validate(mut self, _ ty: Ty) {
        if ty == TY_BOOL {
            self.op(OP_DUP1)
            self.push(1)
            self.op(OP_LT)
        } else if ty == TY_ADDRESS {
            self.op(OP_DUP1)
            self.push(160)
            self.op(OP_SHR)
        } else {
            return
        }
        self.asm.jumpi(self.stub(REVERT_EMPTY))
    }

    // Reverts with empty data when the call carries value.
    fn non_payable(mut self) {
        self.op(OP_CALLVALUE)
        self.asm.jumpi(self.stub(REVERT_EMPTY))
    }

    // Reverts with empty data unless calldata holds at least `size` bytes.
    fn require_calldata(mut self, _ size: u256) {
        self.push(size)
        self.op(OP_CALLDATASIZE)
        self.op(OP_LT)
        self.asm.jumpi(self.stub(REVERT_EMPTY))
    }

    // The runtime code: the dispatcher (DESIGN.md §6.4), the arms and what they call.
    fn runtime(mut self, _ c: usize) {
        self.non_payable()
        self.load_selector()
        let cases = self.cases(c)
        // ponytail: a linear chain of EQs; sort and bisect, like Fe, if gas matters.
        var i: usize = 0
        while i < cases.len() {
            let case = cases[i]
            self.op(OP_DUP1)
            self.push(self.c.ast.word_value(self.c.res[case.arm]))
            self.op(OP_EQ)
            self.asm.jumpi(case.label)
            i += 1
        }
        self.asm.jump(self.stub(REVERT_EMPTY))
        i = 0
        while i < cases.len() {
            let case = cases[i]
            self.asm.bind(case.label)
            self.arm(case.arm)
            i += 1
        }
        self.functions()
        self.stubs_end()
    }

    // Pushes the call's selector, or reverts with empty data when calldata is too short for one.
    fn load_selector(mut self) {
        self.require_calldata(SELECTOR_BYTES)
        self.push(0)
        self.op(OP_CALLDATALOAD)
        self.push(SELECTOR_SHIFT)
        self.op(OP_SHR)
    }

    // The ARMs of every RECV of contract `c`, in order, each with a new label.
    fn cases(mut self, _ c: usize) -> MemVec<Case> {
        var cases: MemVec<Case> = MemVec::new()
        let recvs = self.node(c).recvs()
        var r: usize = 0
        while r < self.len(recvs) {
            let l = self.node(self.elem(recvs, r)).list()
            var k: usize = 0
            while k < self.len(l) {
                cases.push(Case { arm: self.elem(l, k), label: self.asm.label() })
                k += 1
            }
            r += 1
        }
        cases
    }

    // Emits ARM `a`, which decodes its arguments into its frame and runs its body.
    fn arm(mut self, _ a: usize) {
        let n = self.node(a)
        let fields = self.node(self.c.res[a]).list()
        self.begin(a)
        self.require_calldata(SELECTOR_BYTES + words(self.len(fields)))
        var k: usize = 0
        while k < self.len(n.list()) {
            let b = self.elem(n.list(), k)
            self.push(
                SELECTOR_BYTES + words(self.index_of(fields, self.c.res[b])),
            )
            self.op(OP_CALLDATALOAD)
            self.body.depth += 1
            let ty = self.c.types[b]
            self.validate(ty)
            self.store(b)
            k += 1
        }
        self.body_end(n.body())
    }

    // The position of node `i` in list `l`, which holds it.
    fn index_of(self, _ l: usize, _ i: usize) -> usize {
        var k: usize = 0
        while self.elem(l, k) != i {
            k += 1
        }
        k
    }

    // The initcode for a runtime of `rt_len` bytes: checks and copies the constructor arguments,
    // runs `init`, then returns the runtime code (DESIGN.md §6.5).
    fn initcode(mut self, _ c: usize, _ rt_len: usize) {
        // The end of the initcode, which is where the runtime code starts.
        let end = self.asm.label()
        let rt = rt_len as u256
        self.non_payable()
        let init = self.node(c).init()
        if init != 0 {
            self.init_args(init, rt, end)
            self.begin(init)
            self.body.exit = self.asm.label().slot()
            self.body_end(self.node(init).body())
            self.asm.bind(self.body.exit.label())
        }
        self.push(rt)
        self.asm.push_label(end)
        self.push(0)
        self.op(OP_CODECOPY)
        self.return_memory(rt)
        self.functions()
        self.stubs_end()
        self.asm.mark(end)
    }

    // Checks the arguments of INIT `init`, copies them from the code into its frame and
    // validates them. They follow the `rt` bytes of runtime code, which start at `end`.
    fn init_args(mut self, _ init: usize, _ rt: u256, _ end: Label) {
        let params = self.node(init).list()
        let args = words(self.len(params))
        // Extra bytes after the arguments are ignored.
        self.push(rt + args)
        self.asm.push_label(end)
        self.op(OP_ADD)
        self.op(OP_CODESIZE)
        self.op(OP_LT)
        self.asm.jumpi(self.stub(REVERT_EMPTY))
        self.push(args)
        self.push(rt)
        self.asm.push_label(end)
        self.op(OP_ADD)
        self.push(FRAMES + slot_offset(0))
        self.op(OP_CODECOPY)
        var k: usize = 0
        while k < self.len(params) {
            self.push(FRAMES + slot_offset(k))
            self.op(OP_MLOAD)
            self.validate(self.node(self.elem(params, k)).ty())
            self.op(OP_POP)
            k += 1
        }
    }

    // Emits expression `i` and returns how many words it leaves on the stack: 1 for a value, 0
    // for unit. An expression of type TY_NEVER may leave either, since no code runs after it.
    fn expr(mut self, _ i: usize) -> usize {
        let n = self.node(i)
        let k = n.kind
        if k == NODE_INT {
            self.push(self.c.ast.word_value(i))
        } else if k == NODE_BOOL {
            self.push(if n.is_true() { 1 } else { 0 })
        } else if k == NODE_NAME {
            let d = self.c.res[i]
            self.load(d)
            return 1
        } else if k == NODE_BINARY {
            self.binary(i)
            return 1
        } else if k == NODE_UNARY {
            self.value(n.operand())
            self.op(if n.op() == O_BANG { OP_ISZERO } else { OP_NOT })
            return 1
        } else if k == NODE_CALL {
            return self.call(i)
        } else if k == NODE_IF {
            return self.if_expr(i)
        } else if k == NODE_BLOCK {
            return self.block(i)
        } else {
            // NODE_ASSERT, the only other kind of expression.
            self.assert(i)
            return 0
        }
        self.body.depth += 1
        1
    }

    // Emits expression `i` so that it leaves one word.
    fn value(mut self, _ i: usize) {
        if self.expr(i) == 0 {
            // An expression of type TY_NEVER may leave no word. Count one anyway, because the
            // code after it expects one, and that code never runs.
            self.body.depth += 1
        }
    }

    // Emits expression `i` for its effects only.
    fn discard(mut self, _ i: usize) {
        if self.expr(i) == 1 {
            self.op(OP_POP)
            self.body.depth -= 1
        }
    }

    fn binary(mut self, _ i: usize) {
        let n = self.node(i)
        let op = n.op()
        if op == O_ANDAND || op == O_OROR {
            self.short_circuit(i)
            return
        }
        self.value(n.lhs())
        self.value(n.rhs())
        self.apply(op)
    }

    // `a && b` or `a || b`: `b` runs only when `a` does not decide the result.
    fn short_circuit(mut self, _ i: usize) {
        let n = self.node(i)
        let end = self.asm.label()
        self.value(n.lhs())
        self.op(OP_DUP1)
        if n.op() == O_ANDAND {
            self.op(OP_ISZERO)
        }
        self.asm.jumpi(end)
        self.op(OP_POP)
        self.body.depth -= 1
        self.value(n.rhs())
        self.asm.bind(end)
    }

    // Replaces the top two words, `a` under `b`, with `a op b`, checked as SPEC §4 says.
    fn apply(mut self, _ op: Tok) {
        self.body.depth -= 1
        if op == O_PLUS {
            // Overflow iff the sum is less than `a`.
            self.op(OP_DUP2)
            self.op(OP_ADD)
            self.op(OP_DUP1)
            self.op(OP_SWAP2)
            self.op(OP_GT)
            self.asm.jumpi(self.stub(PANIC_OVERFLOW))
        } else if op == O_MINUS {
            self.op(OP_DUP2)
            self.op(OP_DUP2)
            self.op(OP_GT)
            self.asm.jumpi(self.stub(PANIC_OVERFLOW))
            self.op(OP_SWAP1)
            self.op(OP_SUB)
        } else if op == O_STAR {
            self.mul()
        } else if op == O_SLASH || op == O_PERCENT {
            self.op(OP_DUP1)
            self.op(OP_ISZERO)
            self.asm.jumpi(self.stub(PANIC_DIV_ZERO))
            self.op(OP_SWAP1)
            self.op(if op == O_SLASH { OP_DIV } else { OP_MOD })
        } else if op == O_LT {
            self.op(OP_GT)
        } else if op == O_GT {
            self.op(OP_LT)
        } else if op == O_LE {
            self.op(OP_LT)
            self.op(OP_ISZERO)
        } else if op == O_GE {
            self.op(OP_GT)
            self.op(OP_ISZERO)
        } else if op == O_EQ {
            self.op(OP_EQ)
        } else if op == O_NE {
            self.op(OP_EQ)
            self.op(OP_ISZERO)
        } else {
            self.op(bitwise(op))
        }
    }

    // Emits `a * b`. It overflows when `a` is not zero and `(a * b) / a` is not `b`.
    fn mul(mut self) {
        self.op(OP_DUP2)
        self.op(OP_DUP2)
        self.op(OP_MUL)
        // a b r
        self.op(OP_DUP3)
        self.op(OP_DUP2)
        self.op(OP_DIV)
        self.op(OP_DUP3)
        self.op(OP_EQ)
        self.op(OP_DUP4)
        self.op(OP_ISZERO)
        self.op(OP_OR)
        self.op(OP_ISZERO)
        self.asm.jumpi(self.stub(PANIC_OVERFLOW))
        self.op(OP_SWAP2)
        self.op(OP_POP)
        self.op(OP_POP)
    }

    // Emits CALL `i`, by the calling convention of DESIGN.md §6.2.
    fn call(mut self, _ i: usize) -> usize {
        let f = self.c.res[i]
        let args = self.node(i).list()
        var k: usize = 0
        while k < self.len(args) {
            self.value(self.node(self.elem(args, k)).value())
            k += 1
        }
        // The callee's frame starts where this body's ends.
        let next = self.body.frame
        while k > 0 {
            k -= 1
            self.fp_plus(next + slot_offset(k))
            self.op(OP_MSTORE)
        }
        self.body.depth -= self.len(args)
        let back = self.asm.label()
        self.asm.push_label(back)
        self.fp_plus(next + RET_ADDR)
        self.op(OP_MSTORE)
        // [next] = FP, then FP = next.
        self.fp()
        self.op(OP_DUP1)
        self.push(next)
        self.op(OP_ADD)
        self.op(OP_DUP1)
        self.op(OP_SWAP2)
        self.op(OP_SWAP1)
        self.op(OP_MSTORE)
        self.push(FP)
        self.op(OP_MSTORE)
        self.asm.jump(self.fn_label(f))
        self.asm.bind(back)
        if self.node(f).ty() == TY_NONE {
            return 0
        }
        self.body.depth += 1
        1
    }

    // IF `i` and its `else if` chain, in a loop as the checker reads it.
    fn if_expr(mut self, _ i: usize) -> usize {
        let has_value = self.c.types[i] != TY_UNIT
        let base = self.body.depth
        let end = self.asm.label()
        var at = i
        while true {
            let n = self.node(at)
            let next = self.asm.label()
            self.jump_unless(n.cond(), next)
            self.branch(n.body(), has_value)
            self.body.depth = base
            self.asm.jump(end)
            self.asm.bind(next)
            let e = n.otherwise()
            if e == 0 { break }
            if self.node(e).kind != NODE_IF {
                self.branch(e, has_value)
                self.body.depth = base
                break
            }
            at = e
        }
        self.asm.bind(end)
        if !has_value { return 0 }
        self.body.depth = base + 1
        1
    }

    // Emits condition `cond` and jumps to `to` when it is false.
    fn jump_unless(mut self, _ cond: usize, _ to: Label) {
        self.value(cond)
        self.body.depth -= 1
        self.op(OP_ISZERO)
        self.asm.jumpi(to)
    }

    fn branch(mut self, _ b: usize, _ has_value: bool) {
        if has_value {
            self.value(b)
        } else {
            self.discard(b)
        }
    }

    fn block(mut self, _ i: usize) -> usize {
        let n = self.node(i)
        var k: usize = 0
        while k < self.len(n.list()) {
            self.stmt(self.elem(n.list(), k))
            k += 1
        }
        if n.value() == 0 { return 0 }
        self.expr(n.value())
    }

    fn stmt(mut self, _ i: usize) {
        let n = self.node(i)
        let k = n.kind
        if k == NODE_LET {
            self.value(n.value())
            self.store(i)
        } else if k == NODE_WHILE {
            self.while_stmt(i)
        } else if k == NODE_RETURN {
            self.return_stmt(i)
        } else if k == NODE_BREAK || k == NODE_CONTINUE {
            let l = self.loops[self.loops.len() - 1]
            self.drop_to(l.depth)
            self.asm.jump(if k == NODE_BREAK { l.end } else { l.top })
        } else if k == NODE_ASSIGN {
            self.assign(i)
        } else {
            self.discard(i)
        }
    }

    // Pops the words above stack depth `depth`, for code that leaves early. The words stay
    // counted, for the code after it, which never runs.
    fn drop_to(mut self, _ depth: usize) {
        var k = depth
        while k < self.body.depth {
            self.op(OP_POP)
            k += 1
        }
    }

    fn return_stmt(mut self, _ i: usize) {
        let v = self.node(i).value()
        let before = self.body.depth
        if self.body.ret == TY_UNIT {
            // A unit body may still return a unit expression, such as a call.
            if v != 0 { self.discard(v) }
        } else {
            self.value(v)
        }
        self.leave()
        self.body.depth = before
    }

    fn while_stmt(mut self, _ i: usize) {
        let n = self.node(i)
        let top = self.asm.label()
        let end = self.asm.label()
        self.asm.bind(top)
        self.jump_unless(n.cond(), end)
        self.loops.push(Loop { top, end, depth: self.body.depth })
        self.discard(n.body())
        let _ = self.loops.pop()
        self.asm.jump(top)
        self.asm.bind(end)
    }

    // `x = e` or `x op= e`.
    fn assign(mut self, _ i: usize) {
        let n = self.node(i)
        let d = self.c.res[i]
        if n.op() == O_ASSIGN {
            self.value(n.value())
        } else {
            self.load(d)
            self.value(n.value())
            self.apply(n.op().plain_form())
        }
        self.store(d)
    }

    // `assert!(c)` reverts with Panic(0x01), and `assert!(c, "m")` with Error("m") (SPEC §4).
    fn assert(mut self, _ i: usize) {
        let n = self.node(i)
        if n.message() == 0 {
            self.jump_unless(n.cond(), self.stub(PANIC_ASSERT))
            return
        }
        self.value(n.cond())
        self.body.depth -= 1
        let ok = self.asm.label()
        self.asm.jumpi(ok)
        let m = self.node(n.message())
        // The ABI encoding of a string: its offset, its length, then its bytes padded to a word.
        // A message has at most 31 bytes, so they fit in one word (SPEC §1).
        self.selector_at_0(ERROR_SELECTOR)
        self.push(WORD)
        self.push(SELECTOR_BYTES)
        self.op(OP_MSTORE)
        let len = m.str_len() as u256
        self.push(len)
        self.push(SELECTOR_BYTES + WORD)
        self.op(OP_MSTORE)
        var size = SELECTOR_BYTES + 2 * WORD
        if len > 0 {
            self.push(self.c.ast.word_value(n.message()))
            self.push(size)
            self.op(OP_MSTORE)
            size += WORD
        }
        self.revert(size)
        self.asm.bind(ok)
    }
}

// The opcode of bitwise or shift operator `op`. The shift amount is on top, as SHL and SHR take
// it.
fn bitwise(_ op: Tok) -> Op {
    if op == O_AMP {
        OP_AND
    } else if op == O_PIPE {
        OP_OR
    } else if op == O_CARET {
        OP_XOR
    } else if op == O_SHL { OP_SHL } else { OP_SHR }
}

// Generates the deploy code of `c`. An error in `c.err` is passed on.
pub fn generate(_ c: own Checked) -> Output {
    var g = Gen::new(c)
    let warns = core::mem::replace(mut g.c.warns, MemVec::new())
    var out = Output { code: MemVec::new(), err: g.c.err, warns }
    if out.err.is_some() {
        return out
    }
    let the_contract = g.c.the_contract
    if the_contract == 0 {
        out.err = Option::Some(diag(G_NO_CONTRACT, 0))
        return out
    }
    g.runtime(the_contract)
    let runtime = g.section()
    g.initcode(the_contract, runtime.len())
    let init = g.section()
    if runtime.too_large() || init.too_large() {
        out.err = Option::Some(diag(G_CODE_TOO_LARGE, g.node(the_contract).pos))
        return out
    }
    out.code = init.code
    var k: usize = 0
    while k < runtime.len() {
        out.code.push(runtime.code[k])
        k += 1
    }
    out
}

// Compiles the program that `input` holds.
pub fn compile() -> Output uses (input: mut Source) {
    generate(check(parse()))
}
