// Error codes and the `Diag` that every phase reports.

use ingot::lexer::Pos

// An error code. It is `phase * 1000 + n` and prints as the phase letter and three digits, so
// 6034 is `C034`. The phases, from 1 to 7, are lexer, parser, names, types, effects,
// constants and generation. A phase's letter is the first letter of its name. Codes are made
// only here, so every code has a known phase.
pub struct DiagCode { raw: u16 }

impl Copy for DiagCode {}

impl core::ops::Eq for DiagCode {
    fn eq(self, _ other: Self) -> bool {
        self.raw == other.raw
    }
}

const PHASE_LETTERS: String<7> = "LPNTECG"

impl DiagCode {
    // Returns the ASCII phase letter, such as `C` for 6034.
    pub fn letter(self) -> u8 {
        PHASE_LETTERS.as_bytes()[(self.raw / 1000 - 1) as usize]
    }

    // Returns the number within the phase, such as 34 for 6034. It prints as three digits.
    pub fn number(self) -> u16 {
        self.raw % 1000
    }
}

// An error, and where in the source it points.
pub struct Diag {
    pub code: DiagCode,
    // A plain offset, not a Pos, because a nested struct field costs bytecode (argotorg/fe#1964,
    // see docs/WORKAROUNDS.md).
    off: usize,
}

impl Copy for Diag {}

impl Diag {
    // Returns where in the source the error points.
    pub fn pos(self) -> Pos {
        Pos::at(self.off)
    }
}

// Lexer
pub const L_UNEXPECTED_CHAR: DiagCode = DiagCode { raw: 1001 }
pub const L_UNTERMINATED_STRING: DiagCode = DiagCode { raw: 1002 }
pub const L_BAD_ESCAPE: DiagCode = DiagCode { raw: 1003 }
// An integer literal over 256 bits. It keeps the lexer's letter, because the rule is about the
// literal itself.
pub const L_INT_TOO_LARGE: DiagCode = DiagCode { raw: 1004 }
pub const L_RESERVED_WORD: DiagCode = DiagCode { raw: 1005 }
pub const L_UNSUPPORTED_LITERAL: DiagCode = DiagCode { raw: 1006 }
pub const L_NON_ASCII: DiagCode = DiagCode { raw: 1007 }
pub const L_BAD_INT: DiagCode = DiagCode { raw: 1008 }
// A line break inside parentheses where Fe0 allows none (SPEC.md §3.4).
pub const L_LINE_BREAK: DiagCode = DiagCode { raw: 1009 }

// Parser
pub const P_EXPECTED_ITEM: DiagCode = DiagCode { raw: 2001 }
pub const P_EXPECTED_TOKEN: DiagCode = DiagCode { raw: 2002 }
pub const P_EXPECTED_IDENT: DiagCode = DiagCode { raw: 2003 }
pub const P_EXPECTED_TYPE: DiagCode = DiagCode { raw: 2004 }
pub const P_EXPECTED_EXPR: DiagCode = DiagCode { raw: 2005 }
// A statement or an item did not end where SPEC.md §3.4 says it must.
pub const P_EXPECTED_END: DiagCode = DiagCode { raw: 2006 }
pub const P_CHAINED_COMPARISON: DiagCode = DiagCode { raw: 2007 }
pub const P_TOO_DEEP: DiagCode = DiagCode { raw: 2008 }
pub const P_MESSAGE_TOO_LONG: DiagCode = DiagCode { raw: 2009 }
pub const P_FIELD_NOT_MUT: DiagCode = DiagCode { raw: 2010 }
// A `<` that may start generic arguments after a name (SPEC.md §3.2).
pub const P_GENERIC_ARGS: DiagCode = DiagCode { raw: 2011 }
// A `{` at the start of a line after a statement that ends with a name (SPEC.md §3.4).
pub const P_RECORD_LITERAL: DiagCode = DiagCode { raw: 2012 }

// Names

// Two declarations of one name: items and contract fields, or within one list of parameters,
// variants, fields, binds, arms or `recv` blocks. Also one event field given twice in an emit.
pub const N_DUPLICATE: DiagCode = DiagCode { raw: 3001 }
pub const N_UNKNOWN_NAME: DiagCode = DiagCode { raw: 3002 }
// A name used as a value when `Ty.is_value` says it is not one.
pub const N_NOT_A_VALUE: DiagCode = DiagCode { raw: 3003 }
pub const N_NOT_A_FUNCTION: DiagCode = DiagCode { raw: 3004 }
// A local or parameter named like a contract field (SPEC §5.2).
pub const N_SHADOWS_FIELD: DiagCode = DiagCode { raw: 3005 }
// A constant that refers to itself or to a later constant (SPEC §5.3).
pub const N_FORWARD_CONST: DiagCode = DiagCode { raw: 3006 }
pub const N_NOT_A_MSG: DiagCode = DiagCode { raw: 3007 }
pub const N_UNKNOWN_VARIANT: DiagCode = DiagCode { raw: 3008 }
pub const N_MISSING_ARM: DiagCode = DiagCode { raw: 3009 }
// A bind that names no field of its variant, or an emitted value that names no field of its
// event.
pub const N_UNKNOWN_FIELD: DiagCode = DiagCode { raw: 3010 }
pub const N_MISSING_BIND: DiagCode = DiagCode { raw: 3011 }
// A missing, extra or wrong argument label (SPEC §5.4).
pub const N_BAD_LABEL: DiagCode = DiagCode { raw: 3012 }
pub const N_OUTSIDE_LOOP: DiagCode = DiagCode { raw: 3013 }
// Assigning to a name that is neither a `var` local nor a storage field.
pub const N_ASSIGN_IMMUTABLE: DiagCode = DiagCode { raw: 3014 }
pub const N_TWO_CONTRACTS: DiagCode = DiagCode { raw: 3015 }
// Two variants with one selector, in one msg or in two msgs the contract receives (SPEC §6).
pub const N_DUPLICATE_SELECTOR: DiagCode = DiagCode { raw: 3016 }
// A local or parameter whose name starts with an uppercase letter (SPEC §5.2).
pub const N_UPPERCASE_LOCAL: DiagCode = DiagCode { raw: 3017 }
// A local or parameter named like an item (SPEC §5.2).
pub const N_SHADOWS_ITEM: DiagCode = DiagCode { raw: 3018 }
// An emitted event without a value for one of its fields (SPEC §6, "Events").
pub const N_MISSING_FIELD: DiagCode = DiagCode { raw: 3019 }

// Types
pub const T_MISMATCH: DiagCode = DiagCode { raw: 4001 }
pub const T_ARG_COUNT: DiagCode = DiagCode { raw: 4002 }
// An expression without a value where one is needed.
pub const T_NO_VALUE: DiagCode = DiagCode { raw: 4003 }
// A selector that does not fit in 32 bits (SPEC §6).
pub const T_SELECTOR_TOO_LARGE: DiagCode = DiagCode { raw: 4004 }
// An integer of type TY_INT where nothing gives it a type (SPEC §2).
pub const T_NEEDS_TYPE: DiagCode = DiagCode { raw: 4005 }
// An event with more than three indexed fields (SPEC §6, "Events").
pub const T_TOO_MANY_INDEXED: DiagCode = DiagCode { raw: 4006 }

// Effects

// Reading a field that `uses` does not list (SPEC §6).
pub const E_NOT_IN_USES: DiagCode = DiagCode { raw: 5116 }
// Assigning to a storage field that `uses` does not list as `mut` (SPEC §6).
pub const E_NOT_MUT: DiagCode = DiagCode { raw: 5018 }
// A `uses` entry that names no field of the contract (SPEC §6).
pub const E_UNKNOWN_FIELD: DiagCode = DiagCode { raw: 5051 }
pub const E_DUPLICATE_USE: DiagCode = DiagCode { raw: 5001 }
// More contract fields than a FieldSet holds (MAX_FIELDS in check.fe).
pub const E_TOO_MANY_FIELDS: DiagCode = DiagCode { raw: 5002 }
// A warning, not an error: a `uses` entry for a field that the body never reads or assigns. Fe
// accepts these (SPEC §6).
pub const E_UNUSED_USE: DiagCode = DiagCode { raw: 5003 }

// Constants

// A constant's value uses something other than literals, earlier constants and operators.
pub const C_NOT_CONST: DiagCode = DiagCode { raw: 6001 }
// Division or remainder by zero in a constant (SPEC §5.3).
pub const C_DIV_ZERO: DiagCode = DiagCode { raw: 6025 }
// Arithmetic overflow in a constant (SPEC §5.3).
pub const C_OVERFLOW: DiagCode = DiagCode { raw: 6034 }

// Generation

// A program with no contract, so nothing to deploy.
pub const G_NO_CONTRACT: DiagCode = DiagCode { raw: 7001 }
// Initcode or runtime code of `asm::MAX_CODE` bytes or more, which is too long for the assembler.
pub const G_CODE_TOO_LARGE: DiagCode = DiagCode { raw: 7002 }

pub fn diag(_ code: DiagCode, _ pos: Pos) -> Diag {
    Diag { code, off: pos.offset() }
}

#[test]
fn code_letter_and_number() {
    let lexer: String<1> = "L"
    let constants: String<1> = "C"
    assert!(L_INT_TOO_LARGE.letter() == lexer.as_bytes()[0])
    assert!(L_INT_TOO_LARGE.number() == 4)
    let c = DiagCode { raw: 6034 }
    assert!(c.letter() == constants.as_bytes()[0])
    assert!(c.number() == 34)
}
