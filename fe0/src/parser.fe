// Parses Fe0 source into the arena AST. The grammar is SPEC.md §3, and the design is in
// DESIGN.md §3–4. The first error stops the parse.

use ingot::ast::*
use ingot::diag::{
    Diag,
    DiagCode,
    diag,
    L_INT_TOO_LARGE,
    P_CHAINED_COMPARISON,
    P_EXPECTED_END,
    P_EXPECTED_EXPR,
    P_EXPECTED_IDENT,
    P_EXPECTED_ITEM,
    P_EXPECTED_TOKEN,
    P_EXPECTED_TYPE,
    P_FIELD_NOT_MUT,
    P_GENERIC_ARGS,
    P_MESSAGE_TOO_LONG,
    P_RECORD_LITERAL,
    P_TOO_DEEP,
}
use ingot::io::Source
use ingot::lexer::*

// Deepest nesting of blocks and binary expressions. The parser recurses at each level, and the
// EVM stack bounds that recursion. ADR 0012 gives the measurement behind this cap, and
// `parser_tests::deepest_nesting` checks it.
pub const MAX_DEPTH: usize = 20

// Bytes an `assert!` message may hold after decoding escapes (SPEC.md §1).
const MAX_MESSAGE: usize = 31

// How tightly a binary operator binds its operands, from 1 for `||` to 9 for `*`.
struct Power { level: usize }

impl Copy for Power {}

impl core::ops::Eq for Power {
    fn eq(self, _ other: Power) -> bool {
        self.level == other.level
    }
}

impl Power {
    // The power one step tighter, which the right operand of a left-associative operator needs.
    fn tighter(self) -> Power {
        Power { level: self.level + 1 }
    }

    // Checks whether an operator with this power binds at least as tightly as `min`.
    fn binds_at_least(self, _ min: Power) -> bool {
        self.level >= min.level
    }
}

// The power of a token that is not a binary operator.
const NOT_BINARY: Power = Power { level: 0 }

// The power of `||`, the loosest binary operator.
const LOOSEST: Power = Power { level: 1 }

// The power of the comparisons, which don't chain (SPEC.md §3.2).
const CMP_POWER: Power = Power { level: 3 }

// Returns the binding power of a token, or `NOT_BINARY` for a token that is not a binary operator.
fn binding_power(_ t: Tok) -> Power {
    if t == O_OROR {
        return LOOSEST
    }
    if t == O_ANDAND {
        return Power { level: 2 }
    }
    if t.is_comparison() {
        return CMP_POWER
    }
    if t == O_PIPE {
        return Power { level: 4 }
    }
    if t == O_CARET {
        return Power { level: 5 }
    }
    if t == O_AMP {
        return Power { level: 6 }
    }
    if t == O_SHL || t == O_SHR {
        return Power { level: 7 }
    }
    if t == O_PLUS || t == O_MINUS {
        return Power { level: 8 }
    }
    if t == O_STAR || t == O_SLASH || t == O_PERCENT {
        return Power { level: 9 }
    }
    NOT_BINARY
}

struct Parser {
    ast: Ast,
    // Index of the current token.
    at: usize,
    depth: usize,
    // Elements of the lists being built. `close_list` moves them into a list.
    pending: MemVec<NodeId>,
}

// The index of a token in `Ast.lexed.toks`, while the parser looks ahead.
struct TokIdx { i: usize }

impl Copy for TokIdx {}

impl TokIdx {
    fn next(self) -> TokIdx {
        TokIdx { i: self.i + 1 }
    }
}

impl Parser {
    // Token `i`.
    fn tok_at(self, _ i: usize) -> Token {
        self.ast.lexed.toks[i]
    }

    fn tok(self) -> Token {
        self.tok_at(self.at)
    }

    // Kind of token `i`.
    fn kind_at(self, _ i: usize) -> Tok {
        self.tok_at(i).kind
    }

    fn peek(self) -> Tok {
        self.kind_at(self.at)
    }

    // Kind of the token after the current one. The last token is T_EOF, so this stays in range.
    fn peek2(self) -> Tok {
        if self.peek() == T_EOF {
            return T_EOF
        }
        self.kind_at(self.at + 1)
    }

    fn bump(mut self) -> Token {
        let t = self.tok()
        if t.kind != T_EOF {
            self.at += 1
        }
        t
    }

    fn eat(mut self, _ kind: Tok) -> bool {
        if self.peek() == kind {
            self.at += 1
            return true
        }
        false
    }

    fn err(self, _ code: DiagCode) -> Diag {
        diag(code, self.tok().span.start)
    }

    fn expect(mut self, _ kind: Tok) -> Result<Diag, Token> {
        if self.peek() != kind {
            return Result::Err(self.err(P_EXPECTED_TOKEN))
        }
        Result::Ok(self.bump())
    }

    // Starts a list. Its elements are the nodes pushed on `pending` until `close_list`.
    fn open_list(self) -> ListMark {
        ListMark::end_of(self.pending)
    }

    // Moves the elements pushed since `mark` into a new list and returns it.
    fn close_list(mut self, _ mark: ListMark) -> ListId {
        self.ast.add_list(mut self.pending, mark)
    }

    // Adds the value of integer token `t` to the AST's words and returns its index. Errors with
    // L_INT_TOO_LARGE at the literal when the value does not fit in 256 bits.
    fn int_word(mut self, _ t: Token) -> Result<Diag, WordId> {
        match self.ast.lexed.text.int_value(t.span) {
            Option::Some(v) => Result::Ok(self.ast.add_word(v)),
            Option::None => Result::Err(diag(L_INT_TOO_LARGE, t.span.start)),
        }
    }

    fn skip_newlines(mut self) {
        while self.eat(T_NEWLINE) {}
    }

    // Skips newlines and doc comments. When `}` or the end of input follows, it skips none of
    // the doc comments, so the caller reports a syntax error at the first one.
    fn skip_docs(mut self) {
        let start = self.at
        while self.eat(T_NEWLINE) || self.eat(T_DOC) {}
        if self.peek() == P_RBRACE || self.peek() == T_EOF {
            // Returning an error here would cost bytecode at every caller, which would have to
            // pass it on.
            self.at = start
            self.skip_newlines()
        }
    }

    // Whether the current token ends a statement or an item (SPEC.md §3.4).
    fn at_stmt_end(self) -> bool {
        let k = self.peek()
        k == T_NEWLINE || k == P_RBRACE || k == T_EOF
    }

    // Kind of the token before the current one. The parser calls this only after it has read a
    // token.
    fn prev(self) -> Tok {
        self.kind_at(self.at - 1)
    }

    // Checks that the current token ends a statement or an item. Errors with P_EXPECTED_END or
    // P_RECORD_LITERAL when it does not.
    fn end_stmt(self) -> Result<Diag, ()> {
        if !self.at_stmt_end() {
            return Result::Err(self.err(P_EXPECTED_END))
        }
        if self.starts_record_literal() {
            let brace = self.tok_at(self.at + 1)
            return Result::Err(diag(P_RECORD_LITERAL, brace.span.start))
        }
        Result::Ok(())
    }

    // The rest of a comma-separated list, after its opening token, up to and including `close`.
    // Each element is a node of kind `elem`. A trailing comma and newlines around elements are
    // allowed. Variant lists and field lists also allow doc comments before each element
    // (SPEC.md §1). Returns the list.
    fn comma_list(mut self, _ close: Tok, _ elem: Kind) -> Result<Diag, ListId> {
        let mark = self.open_list()
        let docs = elem == NODE_VARIANT || elem == NODE_FIELD
        while true {
            if docs {
                self.skip_docs()
            } else {
                self.skip_newlines()
            }
            if self.eat(close) { break }
            let e = self.element(elem)?
            self.pending.push(e)
            self.skip_newlines()
            if !self.eat(P_COMMA) {
                self.expect(close)?
                break
            }
        }
        Result::Ok(self.close_list(mark))
    }

    // One element of a comma-separated list, parsed by the parser for its kind. Fe has no
    // closures, so `comma_list` names the element parser by the kind of node it builds.
    fn element(mut self, _ kind: Kind) -> Result<Diag, NodeId> {
        if kind == NODE_PARAM {
            return self.param()
        }
        if kind == NODE_VARIANT {
            return self.variant()
        }
        if kind == NODE_FIELD {
            return self.field()
        }
        if kind == NODE_BIND {
            return self.bind()
        }
        if kind == NODE_USE {
            return self.use_entry()
        }
        // The only kind left is NODE_ARG.
        self.arg()
    }

    fn enter(mut self) -> Result<Diag, ()> {
        self.depth += 1
        if self.depth > MAX_DEPTH {
            return Result::Err(self.err(P_TOO_DEEP))
        }
        Result::Ok(())
    }

    fn leave(mut self) {
        self.depth -= 1
    }

    fn ident(mut self) -> Result<Diag, Sym> {
        if self.peek() != T_IDENT {
            return Result::Err(self.err(P_EXPECTED_IDENT))
        }
        let t = self.bump()
        Result::Ok(self.ast.intern(t))
    }

    fn ty(mut self) -> Result<Diag, Ty> {
        let kind = self.peek()
        var ty = TY_NONE
        if kind == T_U256 {
            ty = TY_U256
        } else if kind == T_BOOL {
            ty = TY_BOOL
        } else if kind == T_ADDRESS {
            ty = TY_ADDRESS
        }
        if ty == TY_NONE {
            return Result::Err(self.err(P_EXPECTED_TYPE))
        }
        self.bump()
        Result::Ok(ty)
    }

    // `-> type`, or TY_NONE when there is no arrow.
    fn ret_ty(mut self) -> Result<Diag, Ty> {
        if self.eat(P_ARROW) {
            return self.ty()
        }
        Result::Ok(TY_NONE)
    }

    // program = { NL } { item TERM { NL } }
    fn program(mut self) -> Result<Diag, ListId> {
        let mark = self.open_list()
        self.skip_docs()
        while self.peek() != T_EOF {
            let item = self.item()?
            self.pending.push(item)
            // Two items may not share a line (SPEC.md §3.1).
            self.end_stmt()?
            self.skip_docs()
        }
        Result::Ok(self.close_list(mark))
    }

    fn item(mut self) -> Result<Diag, NodeId> {
        self.eat(K_PUB)
        let k = self.peek()
        if k == K_CONST {
            return self.const_item()
        }
        if k == K_FN {
            return self.fn_item()
        }
        if k == K_MSG {
            return self.msg_item()
        }
        if k == K_CONTRACT {
            return self.contract_item()
        }
        Result::Err(self.err(P_EXPECTED_ITEM))
    }

    // const = "const" IDENT ":" type "=" expr
    fn const_item(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let name = self.ident()?
        self.expect(P_COLON)?
        let ty = self.ty()?
        self.expect(O_ASSIGN)?
        let value = self.expr()?
        Result::Ok(self.ast.add_node(Node::new_const(pos, name, ty, value)))
    }

    // function = "fn" IDENT "(" [ params ] ")" [ "->" type ] block
    fn fn_item(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let name = self.ident()?
        let params = self.params()?
        let ret = self.ret_ty()?
        let body = self.block()?
        Result::Ok(
            self.ast.add_node(Node::new_fn(pos, name, params, ret, body)),
        )
    }

    // "(" [ params ] ")", where params = param { "," param } [ "," ]
    fn params(mut self) -> Result<Diag, ListId> {
        self.expect(P_LPAREN)?
        self.comma_list(P_RPAREN, NODE_PARAM)
    }

    // param = [ "_" ] IDENT ":" type
    fn param(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let positional = self.eat(T_UNDERSCORE)
        let name = self.ident()?
        self.expect(P_COLON)?
        let ty = self.ty()?
        Result::Ok(
            self.ast.add_node(Node::new_param(pos, name, ty, positional)),
        )
    }

    // msg = "msg" IDENT "{" [ variants ] "}"
    fn msg_item(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let name = self.ident()?
        self.expect(P_LBRACE)?
        let variants = self.comma_list(P_RBRACE, NODE_VARIANT)?
        Result::Ok(self.ast.add_node(Node::new_msg(pos, name, variants)))
    }

    // variant = selector NL IDENT [ "{" [ fields ] "}" ] [ "->" type ]
    // selector = "#" "[" "selector" "=" INT "]"
    fn variant(mut self) -> Result<Diag, NodeId> {
        let hash = self.expect(P_HASH)?
        self.expect(P_LBRACKET)?
        let word = self.tok()
        if word.kind != T_IDENT || !self.ast.lexed.text.spells(word.span, "selector") {
            return Result::Err(self.err(P_EXPECTED_TOKEN))
        }
        self.bump()
        self.expect(O_ASSIGN)?
        let selector = self.int_word(self.expect(T_INT)?)?
        self.expect(P_RBRACKET)?
        self.expect(T_NEWLINE)?
        self.skip_docs()
        let name = self.ident()?
        var fields = EMPTY_LIST
        if self.eat(P_LBRACE) {
            fields = self.comma_list(P_RBRACE, NODE_FIELD)?
        }
        let ret = self.ret_ty()?
        let n = Node::new_variant(hash.span.start, name, selector, fields, ret)
        Result::Ok(self.ast.add_node(n))
    }

    // field = IDENT ":" type
    fn field(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let name = self.ident()?
        self.expect(P_COLON)?
        let ty = self.ty()?
        Result::Ok(self.ast.add_node(Node::new_field(pos, name, ty)))
    }

    // contract = "contract" IDENT "{" { cfield } [ init ] { recv } "}"
    // cfield = "mut" IDENT ":" type [ "," ]
    fn contract_item(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let name = self.ident()?
        self.expect(P_LBRACE)?
        self.skip_docs()
        let field_mark = self.open_list()
        while self.peek() == K_MUT || self.peek() == T_IDENT {
            if !self.eat(K_MUT) {
                return Result::Err(self.err(P_FIELD_NOT_MUT))
            }
            let f = self.field()?
            self.pending.push(f)
            self.eat(P_COMMA)
            self.skip_docs()
        }
        let field_list = self.close_list(field_mark)
        var init = NO_NODE
        if self.peek() == K_INIT {
            init = self.init()?
            self.skip_docs()
        }
        let recv_mark = self.open_list()
        while self.peek() == K_RECV {
            let r = self.recv()?
            self.pending.push(r)
            self.skip_docs()
        }
        let recv_list = self.close_list(recv_mark)
        self.expect(P_RBRACE)?
        Result::Ok(
            self.ast
                .add_node(
                    Node::new_contract(pos, name, fields: field_list, init, recvs: recv_list),
                ),
        )
    }

    // init = "init" "(" [ params ] ")" [ uses ] block
    fn init(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let params = self.params()?
        let use_list = self.uses_clause()?
        let body = self.block()?
        Result::Ok(
            self.ast.add_node(Node::new_init(pos, params, use_list, body)),
        )
    }

    // recv = "recv" IDENT "{" { arm } "}"
    fn recv(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        let name = self.ident()?
        self.expect(P_LBRACE)?
        self.skip_docs()
        let mark = self.open_list()
        while !self.eat(P_RBRACE) {
            let arm = self.arm()?
            self.pending.push(arm)
            self.skip_docs()
        }
        let arms = self.close_list(mark)
        Result::Ok(self.ast.add_node(Node::new_recv(pos, name, arms)))
    }

    // arm = IDENT "{" [ binds ] "}" [ "->" type ] [ uses ] block
    fn arm(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let variant = self.ident()?
        self.expect(P_LBRACE)?
        let binds = self.comma_list(P_RBRACE, NODE_BIND)?
        let ret = self.ret_ty()?
        let use_list = self.uses_clause()?
        let body = self.block()?
        Result::Ok(
            self.ast.add_node(Node::new_arm(pos, variant, binds, ret, use_list, body)),
        )
    }

    // bind = IDENT [ ":" IDENT ]
    fn bind(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let field = self.ident()?
        var local = field
        if self.eat(P_COLON) {
            local = self.ident()?
        }
        Result::Ok(self.ast.add_node(Node::new_bind(pos, field, local)))
    }

    // [ "uses" "(" [ use { "," use } [ "," ] ] ")" ]
    fn uses_clause(mut self) -> Result<Diag, ListId> {
        if !self.eat(K_USES) {
            return Result::Ok(EMPTY_LIST)
        }
        self.expect(P_LPAREN)?
        self.comma_list(P_RPAREN, NODE_USE)
    }

    // use = [ "mut" ] IDENT
    fn use_entry(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let mutable = self.eat(K_MUT)
        let field = self.ident()?
        Result::Ok(self.ast.add_node(Node::new_use(pos, field, mutable)))
    }

    // block = "{" { NL } { stmt { NL } } [ expr { NL } ] "}"
    fn block(mut self) -> Result<Diag, NodeId> {
        let pos = self.expect(P_LBRACE)?.span.start
        self.enter()?
        var tail = NO_NODE
        let mark = self.open_list()
        self.skip_newlines()
        while !self.eat(P_RBRACE) {
            let s = self.stmt()?
            self.skip_newlines()
            if self.ast.node(s).kind.is_expr() && self.peek() == P_RBRACE {
                tail = s
            } else {
                self.pending.push(s)
            }
        }
        let stmts = self.close_list(mark)
        self.leave()
        Result::Ok(self.ast.add_node(Node::new_block(pos, stmts, tail)))
    }

    // A statement, ended as SPEC.md §3.4 says.
    fn stmt(mut self) -> Result<Diag, NodeId> {
        let k = self.peek()
        if k == K_LET || k == K_VAR {
            let pos = self.bump().span.start
            let name = self.ident()?
            var ty = TY_NONE
            if self.eat(P_COLON) {
                ty = self.ty()?
            }
            self.expect(O_ASSIGN)?
            let value = self.expr()?
            return self.finish_stmt(Node::new_let(pos, name, ty, value, mutable: k == K_VAR))
        }
        if k == K_WHILE {
            let pos = self.bump().span.start
            let cond = self.expr()?
            let body = self.block()?
            return self.finish_stmt(Node::new_while(pos, cond, body))
        }
        if k == K_RETURN {
            let pos = self.bump().span.start
            var value = NO_NODE
            if !self.at_stmt_end() {
                value = self.expr()?
            }
            return self.finish_stmt(Node::new_return(pos, value))
        }
        if k == K_BREAK {
            return self.finish_stmt(Node::leaf(NODE_BREAK, self.bump().span.start))
        }
        if k == K_CONTINUE {
            return self.finish_stmt(Node::leaf(NODE_CONTINUE, self.bump().span.start))
        }
        if k == T_IDENT && self.peek2().is_assign() {
            let pos = self.tok().span.start
            let name = self.ident()?
            let op = self.bump().kind
            let value = self.expr()?
            return self.finish_stmt(Node::new_assign(pos, name, op, value))
        }
        let e = self.expr()?
        self.end_stmt()?
        Result::Ok(e)
    }

    fn finish_stmt(mut self, _ n: Node) -> Result<Diag, NodeId> {
        self.end_stmt()?
        Result::Ok(self.ast.add_node(n))
    }

    fn expr(mut self) -> Result<Diag, NodeId> {
        // Passing the constant LOOSEST here instead costs about 650 bytes of bytecode
        // (argotorg/fe#1964, see docs/WORKAROUNDS.md).
        self.binary(NOT_BINARY.tighter())
    }

    // Precedence climbing over the operators that bind at least as tightly as `min`.
    fn binary(mut self, _ min: Power) -> Result<Diag, NodeId> {
        self.enter()?
        var lhs = self.unary()?
        while true {
            let power = binding_power(self.peek())
            if !power.binds_at_least(min) || power == NOT_BINARY {
                break
            }
            if self.reads_as_generics() {
                return Result::Err(self.err(P_GENERIC_ARGS))
            }
            let t = self.bump()
            let rhs = self.binary(power.tighter())?
            lhs = self.ast.add_node(Node::new_binary(t.span.start, op: t.kind, lhs, rhs))
            if power == CMP_POWER && binding_power(self.peek()) == CMP_POWER {
                return Result::Err(self.err(P_CHAINED_COMPARISON))
            }
        }
        self.leave()
        Result::Ok(lhs)
    }

    // Checks whether the current token is a `<` that may start generic arguments, by Fe0's rule
    // in SPEC.md §3.2. That rule is wider than Fe's, so this may return true where Fe reads a
    // comparison.
    fn reads_as_generics(self) -> bool {
        if self.peek() != O_LT || self.prev() != T_IDENT {
            return false
        }
        var i = TokIdx { i: self.at + 1 }
        // Whether the next token must start an argument.
        var arg = true
        while true {
            let k = self.kind_at(i.i)
            if k == P_LPAREN || k == P_LBRACKET || (arg && k == P_LBRACE) {
                i = self.after_group(i)
                arg = false
            } else if arg
                && (k == T_IDENT || k.is_type_name() || k == T_INT || k == K_TRUE || k == K_FALSE) {
                i = i.next()
                arg = false
            } else if !arg && (k == P_COMMA || k == O_LT) {
                i = i.next()
                arg = true
            } else {
                return !arg && (k == O_GT || k == O_SHR || k == O_GE || k == A_SHR)
            }
        }
        false
    }

    // Whether the next line starts with `{` after a statement that ends with a name (SPEC.md §3.4).
    fn starts_record_literal(self) -> bool {
        self.peek() == T_NEWLINE && self.prev() == T_IDENT && self.peek2() == P_LBRACE
    }

    // Index of the token after the bracket group that opens at token `start`, or of the T_EOF
    // token when the group does not close.
    fn after_group(self, _ start: TokIdx) -> TokIdx {
        var i = start
        var depth: usize = 0
        while true {
            let k = self.kind_at(i.i)
            if k == T_EOF { return i }
            i = i.next()
            if k == P_LPAREN || k == P_LBRACE || k == P_LBRACKET {
                depth += 1
            } else if k == P_RPAREN || k == P_RBRACE || k == P_RBRACKET {
                depth -= 1
                if depth == 0 { return i }
            }
        }
        i
    }

    // unary = ( "!" | "~" ) unary | primary. Written as a loop, so a run of operators does not
    // recurse. The operators are consecutive tokens, so the primary is wrapped in them from the
    // last back to the first.
    fn unary(mut self) -> Result<Diag, NodeId> {
        let first = self.at
        while self.peek() == O_BANG || self.peek() == O_TILDE {
            self.bump()
        }
        var op = self.at
        var e = self.primary()?
        while op > first {
            op -= 1
            let t = self.tok_at(op)
            e = self.ast.add_node(Node::new_unary(t.span.start, op: t.kind, operand: e))
        }
        Result::Ok(e)
    }

    // primary = INT | "true" | "false" | IDENT "(" [ args ] ")" | IDENT | "(" expr ")" | block | if
    //     | assert
    fn primary(mut self) -> Result<Diag, NodeId> {
        let t = self.tok()
        let k = t.kind
        if k == T_INT {
            self.bump()
            let word = self.int_word(t)?
            return Result::Ok(self.ast.add_node(Node::new_int(t.span.start, word)))
        }
        if k == K_TRUE || k == K_FALSE {
            self.bump()
            return Result::Ok(
                self.ast.add_node(Node::new_bool(t.span.start, value: k == K_TRUE)),
            )
        }
        if k == T_IDENT {
            if self.peek2() == P_LPAREN {
                return self.call()
            }
            let name = self.ident()?
            return Result::Ok(self.ast.add_node(Node::new_name(t.span.start, name)))
        }
        if k == P_LPAREN {
            self.bump()
            let e = self.expr()?
            self.expect(P_RPAREN)?
            return Result::Ok(e)
        }
        if k == P_LBRACE {
            return self.block()
        }
        if k == K_IF {
            return self.if_expr()
        }
        if k == K_ASSERT {
            return self.assert()
        }
        Result::Err(self.err(P_EXPECTED_EXPR))
    }

    // IDENT "(" [ args ] ")", where args = arg { "," arg } [ "," ]
    fn call(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        let name = self.ident()?
        self.expect(P_LPAREN)?
        let args = self.comma_list(P_RPAREN, NODE_ARG)?
        Result::Ok(self.ast.add_node(Node::new_call(pos, name, args)))
    }

    // arg = [ IDENT ":" ] expr
    fn arg(mut self) -> Result<Diag, NodeId> {
        let pos = self.tok().span.start
        var label = NO_SYM
        if self.peek() == T_IDENT && self.peek2() == P_COLON {
            label = self.ident()?
            self.bump()
        }
        let value = self.expr()?
        Result::Ok(self.ast.add_node(Node::new_arg(pos, label, value)))
    }

    // if = "if" expr block [ "else" ( if | block ) ]. An `else if` chain is read in a loop, each
    // IF linked to the next as it is read, so it does not recurse.
    fn if_expr(mut self) -> Result<Diag, NodeId> {
        var first = NO_NODE
        var prev = NO_NODE
        while true {
            let pos = self.expect(K_IF)?.span.start
            let cond = self.expr()?
            let then = self.block()?
            let i = self.ast.add_node(Node::new_if(pos, cond, then))
            if prev.is_none() {
                first = i
            } else {
                self.ast.set_else(prev, i)
            }
            prev = i
            if !self.eat(K_ELSE) { break }
            if self.peek() != K_IF {
                let otherwise = self.block()?
                self.ast.set_else(prev, otherwise)
                break
            }
        }
        Result::Ok(first)
    }

    // assert = "assert" "!" "(" expr [ "," STRING ] ")"
    fn assert(mut self) -> Result<Diag, NodeId> {
        let pos = self.bump().span.start
        self.expect(O_BANG)?
        self.expect(P_LPAREN)?
        let cond = self.expr()?
        var message = NO_NODE
        if self.eat(P_COMMA) {
            let s = self.expect(T_STR)?
            let v = self.ast.lexed.text.string_value(s.span)
            if v.len > MAX_MESSAGE {
                return Result::Err(diag(P_MESSAGE_TOO_LONG, s.span.start))
            }
            let word = self.ast.add_word(v.word)
            message = self.ast.add_node(Node::new_str(s.span.start, word, len: v.len))
        }
        self.expect(P_RPAREN)?
        Result::Ok(self.ast.add_node(Node::new_assert(pos, cond, message)))
    }
}

// Lexes and parses everything `Source` provides.
pub fn parse() -> Ast uses (input: mut Source) {
    var p = Parser { ast: Ast::new(lex()), at: 0, depth: 0, pending: MemVec::new() }
    if p.ast.err.is_none() {
        match p.program() {
            Result::Ok(items) => {
                p.ast.items = items
            },
            Result::Err(d) => {
                p.ast.err = Option::Some(d)
            },
        }
    }
    p.ast
}
