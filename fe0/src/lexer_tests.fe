use ingot::diag::{
    Diag,
    L_BAD_ESCAPE,
    L_BAD_INT,
    L_INT_TOO_LARGE,
    L_LINE_BREAK,
    L_NON_ASCII,
    L_RESERVED_WORD,
    L_UNEXPECTED_CHAR,
    L_UNSUPPORTED_LITERAL,
    L_UNTERMINATED_STRING,
}
use ingot::difftest::Rejected
use ingot::io::{Source, text}
use ingot::lexer::*
use std::abi::DynString
use std::evm::revert_error

fn lexed(_ s: own DynString) -> Lexed {
    with (Source = text(s)) {
        lex()
    }
}

fn lex_text(_ s: own DynString) -> Lexed {
    let l = lexed(s)
    assert!(l.err.is_none())
    l
}

fn lex_err(_ s: own DynString) -> Diag {
    lexed(s).err.unwrap()
}

fn kinds(_ l: Lexed) -> MemVec<Tok> {
    var v: MemVec<Tok> = MemVec::new()
    for ref t in l.toks {
        v.push(t.kind)
    }
    v
}

fn expect<const N: usize>(_ s: own DynString, _ want: [Tok; N]) {
    let k = kinds(lex_text(s))
    assert!(k.len() == N)
    var i: usize = 0
    while i < N {
        assert!(k[i] == want[i])
        i += 1
    }
}

#[test]
fn keywords_and_idents() {
    expect(
        "fn let var if else while return break continue",
        [K_FN, K_LET, K_VAR, K_IF, K_ELSE, K_WHILE, K_RETURN, K_BREAK, K_CONTINUE, T_EOF],
    )
    expect(
        "msg contract init recv uses mut const pub true false assert struct",
        [
            K_MSG,
            K_CONTRACT,
            K_INIT,
            K_RECV,
            K_USES,
            K_MUT,
            K_CONST,
            K_PUB,
            K_TRUE,
            K_FALSE,
            K_ASSERT,
            K_STRUCT,
            T_EOF,
        ],
    )
    expect(
        "x _y fnord u u2x Bool _",
        [T_IDENT, T_IDENT, T_IDENT, T_IDENT, T_IDENT, T_IDENT, T_UNDERSCORE, T_EOF],
    )
    expect(
        "u256 bool Address u8 i7 usize isize String",
        [T_U256, T_BOOL, T_ADDRESS, T_TYPE, T_TYPE, T_TYPE, T_TYPE, T_TYPE, T_EOF],
    )
}

fn expect_reserved(_ s: own DynString) {
    assert!(lex_err(s).code == L_RESERVED_WORD)
}

// Each word in `RESERVED` is an error. The test spells the words in plain text.
#[test]
fn reserved_words_are_errors() {
    expect_reserved("as")
    expect_reserved("mod")
    expect_reserved("static_assert")
    expect_reserved("match")
    expect_reserved("for")
    expect_reserved("loop")
    expect_reserved("in")
    expect_reserved("where")
    expect_reserved("yield")
    expect_reserved("self")
    expect_reserved("Self")
    expect_reserved("enum")
    expect_reserved("trait")
    expect_reserved("impl")
    expect_reserved("type")
    expect_reserved("ref")
    expect_reserved("own")
    expect_reserved("use")
    expect_reserved("extern")
    expect_reserved("unsafe")
    expect_reserved("ingot")
    expect_reserved("super")
    expect_reserved("with")
    expect_reserved("let for = 1")
    assert!(lex_err("let x = with").pos() == Pos::at(8))
}

// Each fixed spelling is what `Text.packed` makes of its word, and `push_bytes` gives the word
// back.
#[test]
fn word_spellings_round_trip() {
    let l = lex_text(
        "selector Ctx caller zero StorageMap event indexed Log emit Call call address uint256 bool address",
    )
    let words: [Spelling; 15] = [
        W_SELECTOR,
        W_CTX,
        W_CALLER,
        W_ZERO,
        W_STORAGE_MAP,
        W_EVENT,
        W_INDEXED,
        W_LOG,
        W_EMIT,
        W_CALL_EFFECT,
        W_CALL,
        W_ADDRESS,
        ABI_UINT256,
        ABI_BOOL,
        ABI_ADDRESS,
    ]
    var i: usize = 0
    while i < words.len() {
        let span = l.toks[i].span
        assert!(l.text.packed(span) == words[i])
        var out: MemVec<u8> = MemVec::new()
        words[i].push_bytes(mut out)
        assert!(out.as_slice() == l.text.span_bytes(span))
        i += 1
    }
}

#[test]
fn punctuation_and_operators() {
    expect(
        "( ) { } [ ] : , -> # .",
        [
            P_LPAREN,
            P_RPAREN,
            P_LBRACE,
            P_RBRACE,
            P_LBRACKET,
            P_RBRACKET,
            P_COLON,
            P_COMMA,
            P_ARROW,
            P_HASH,
            P_DOT,
            T_EOF,
        ],
    )
    expect(
        "+ - * / % ~ ! ^ & | && || < > = == != <= >= << >>",
        [
            O_PLUS,
            O_MINUS,
            O_STAR,
            O_SLASH,
            O_PERCENT,
            O_TILDE,
            O_BANG,
            O_CARET,
            O_AMP,
            O_PIPE,
            O_ANDAND,
            O_OROR,
            O_LT,
            O_GT,
            O_ASSIGN,
            O_EQ,
            O_NE,
            O_LE,
            O_GE,
            O_SHL,
            O_SHR,
            T_EOF,
        ],
    )
    expect(
        "+= -= *= /= %= ^= &= |= <<= >>=",
        [A_PLUS, A_MINUS, A_STAR, A_SLASH, A_PERCENT, A_CARET, A_AMP, A_PIPE, A_SHL, A_SHR, T_EOF],
    )
    // Compound operators must be written without spaces inside (SPEC §1).
    expect("a < = b", [T_IDENT, O_LT, O_ASSIGN, T_IDENT, T_EOF])
}

#[test]
fn newlines_collapse_and_vanish_where_parens_are_innermost() {
    expect("a\n\n  \n b", [T_IDENT, T_NEWLINE, T_IDENT, T_EOF])
    expect(
        "f(a,\n b)\nc",
        [T_IDENT, P_LPAREN, T_IDENT, P_COMMA, T_IDENT, P_RPAREN, T_NEWLINE, T_IDENT, T_EOF],
    )
    expect("{\n}", [P_LBRACE, T_NEWLINE, P_RBRACE, T_EOF])
    // Inside a block, a newline counts even when the block is in parentheses.
    expect(
        "({ a\n(b\n) }\n)",
        [
            P_LPAREN,
            P_LBRACE,
            T_IDENT,
            T_NEWLINE,
            P_LPAREN,
            T_IDENT,
            P_RPAREN,
            P_RBRACE,
            P_RPAREN,
            T_EOF,
        ],
    )
    expect("a // note\nb", [T_IDENT, T_NEWLINE, T_IDENT, T_EOF])
    // A newline before `/` is emitted before the `/` it had to read past.
    expect("a\n/ b", [T_IDENT, T_NEWLINE, O_SLASH, T_IDENT, T_EOF])
    expect("a\r\nb", [T_IDENT, T_NEWLINE, T_IDENT, T_EOF])
}

// Asserts that `s` fails with L_LINE_BREAK at the line break at byte `pos`.
fn bad_break(_ s: own DynString, _ pos: usize) {
    let d = lex_err(s)
    assert!(d.code == L_LINE_BREAK)
    assert!(d.pos() == Pos::at(pos))
}

#[test]
fn line_breaks_in_parens() {
    // A line may end with `(`, `,` or a binary operator, or before `)`. Blank lines and comments
    // after it don't matter.
    expect("(\na)", [P_LPAREN, T_IDENT, P_RPAREN, T_EOF])
    expect("(a\n)", [P_LPAREN, T_IDENT, P_RPAREN, T_EOF])
    expect(
        "f(a,\nb)",
        [T_IDENT, P_LPAREN, T_IDENT, P_COMMA, T_IDENT, P_RPAREN, T_EOF],
    )
    expect(
        "(a &&\n// c\n\nb)",
        [P_LPAREN, T_IDENT, O_ANDAND, T_IDENT, P_RPAREN, T_EOF],
    )
    expect(
        "(a /\nb)",
        [P_LPAREN, T_IDENT, O_SLASH, T_IDENT, P_RPAREN, T_EOF],
    )
    // Anywhere else, it is an error at the line break.
    bad_break("(a\n- b)", 2)
    bad_break("(a\n/ b)", 2)
    bad_break("(!\nc)", 2)
    bad_break("(~\na)", 2)
    bad_break("h(x:\na)", 4)
    bad_break("h(x\n: a)", 3)
    bad_break("(f\n(a))", 2)
    bad_break("((a)\nb)", 4)
    bad_break("(a // c\nb)", 7)
}

#[test]
fn doc_comments_are_tokens() {
    // `///` and longer runs of `/` start a doc comment, which is a token (SPEC.md §1).
    expect(
        "a /// note\n//// b\nc",
        [T_IDENT, T_DOC, T_NEWLINE, T_DOC, T_NEWLINE, T_IDENT, T_EOF],
    )
    expect(
        "(a /// note\n)",
        [P_LPAREN, T_IDENT, T_DOC, P_RPAREN, T_EOF],
    )
}

// Returns the value in `r`. Errors with `Rejected::of(d)` when `r` holds the error `d`.
// Core's `unwrap` cannot do this, because `Diag` is not revert data.
fn made(_ r: own Result<Diag, u256>) -> u256 {
    match r {
        Result::Ok(v) => v,
        Result::Err(d) => revert_error(Rejected::of(d)),
    }
}

#[test]
fn integers() {
    let l = lex_text("0 42 1_000_000 0xff")
    assert!(made(int_at(l, 0)) == 0)
    assert!(made(int_at(l, 1)) == 42)
    assert!(made(int_at(l, 2)) == 1000000)
    assert!(made(int_at(l, 3)) == 255)
    assert!(lex_err("0XDEAD_").code == L_BAD_INT)
    let max_dec = int_value_of(
        "115792089237316195423570985008687907853269984665640564039457584007913129639935",
    )
    assert!(
        made(max_dec) == 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
    )
    let max_hex = int_value_of(
        "0x00ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
    )
    assert!(
        made(max_hex) == 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
    )
    let too_large = int_value_of(
        "115792089237316195423570985008687907853269984665640564039457584007913129639936",
    )
    assert!(too_large.unwrap_err().code == L_INT_TOO_LARGE)
    assert!(lex_err("1__0").code == L_BAD_INT)
    assert!(lex_err("12ab").code == L_BAD_INT)
    assert!(lex_err("0x").code == L_BAD_INT)
    assert!(lex_err("0b101").code == L_UNSUPPORTED_LITERAL)
    assert!(lex_err("0o17").code == L_UNSUPPORTED_LITERAL)
}

#[test]
fn strings() {
    let l = lex_text("assert!(x, \"a \\\"b\\\" \\n\")")
    // assert ! ( x , "a \"b\" \n" ) EOF: the string token spans 12 source bytes.
    assert!(l.toks[5].kind == T_STR)
    assert!(l.toks[5].span.len == 12)
    // The decoded bytes read back in order.
    let v = l.text.string_value(l.toks[5].span)
    assert!(v.len == 7)
    assert!(v.byte(0) == 0x61)
    assert!(v.byte(2) == 0x22)
    assert!(v.byte(6) == 0x0a)
    assert!(lex_err("\"abc").code == L_UNTERMINATED_STRING)
    assert!(lex_err("\"ab\ncd\"").code == L_UNTERMINATED_STRING)
    assert!(lex_err("\"\\q\"").code == L_BAD_ESCAPE)
    let u = lex_text("assert!(x, \"é\")")
    assert!(u.toks[5].kind == T_STR)
    assert!(u.toks[5].span.len == 4)
}

#[test]
fn bad_characters() {
    let d = lex_err("let x = 1\nlet y = $")
    assert!(d.code == L_UNEXPECTED_CHAR)
    assert!(d.pos() == Pos::at(18))
    assert!(lex_err("a é").code == L_NON_ASCII)
    assert!(lex_err("a é").pos() == Pos::at(2))
    // The source holds a raw DEL byte (127), which is ASCII but no token.
    assert!(lex_err("a ").code == L_UNEXPECTED_CHAR)
    assert!(lex_err("x ? y").code == L_UNEXPECTED_CHAR)
    assert!(lex_err("a @ b").code == L_UNEXPECTED_CHAR)
    // A raw NUL byte (0), which no table of `punct` may match.
    assert!(lex_err("a ␀ b").code == L_UNEXPECTED_CHAR)
    // `;` is not a token in Fe0 (SPEC §1).
    assert!(lex_err("g();").code == L_UNEXPECTED_CHAR)
}

#[test]
fn token_spans() {
    let l = lex_text("let total = a1 + 0x10")
    assert!(l.toks[1].span.start == Pos::at(4))
    assert!(l.toks[1].span.len == 5)
    assert!(l.toks[5].span.start == Pos::at(17))
    assert!(l.toks[5].span.len == 4)
    assert!(l.toks[6].kind == T_EOF)
    assert!(l.toks[6].span.start == Pos::at(21))
}

#[test]
fn line_col() {
    let lf = line_col_of("let x = 1\nlet y = 2", 8)
    assert!(lf.line == 2)
    assert!(lf.col == 9)
    let cr = line_col_of("a\rb", 2)
    assert!(cr.line == 2)
    assert!(cr.col == 1)
    let crlf = line_col_of("a\r\nb", 2)
    assert!(crlf.line == 2)
    assert!(crlf.col == 1)
}

// Line and column where token `tok` of `s` starts.
fn line_col_of(_ s: own DynString, _ tok: usize) -> LineCol {
    let l = lex_text(s)
    l.text.line_col(l.toks[tok].span.start)
}

// Value of the first token of `s`. Errors as `Text.int_value` does.
fn int_value_of(_ s: own DynString) -> Result<Diag, u256> {
    int_at(lex_text(s), 0)
}

// Value of integer token `tok` of `l`.
fn int_at(_ l: Lexed, _ tok: usize) -> Result<Diag, u256> {
    l.text.int_value(l.toks[tok].span)
}
