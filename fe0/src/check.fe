// Checks names, types, constants and effects (SPEC §2 and §4–6), and records what code
// generation needs in side tables indexed by node. The design is in DESIGN.md §5.

use ingot::asm::{
    MAX_TOPICS,
    OP_ADDRESS,
    OP_BASEFEE,
    OP_BLOBBASEFEE,
    OP_CALLER,
    OP_CHAINID,
    OP_COINBASE,
    OP_GASLIMIT,
    OP_GASPRICE,
    OP_NUMBER,
    OP_ORIGIN,
    OP_PREVRANDAO,
    Op,
}
use ingot::ast::*
use ingot::diag::*
use ingot::lexer::*
use ingot::wire::{Reader, Wire, Writer}
use std::evm::crypto::keccak256

const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
const SELECTOR_MAX: u256 = 0xffffffff

// The most indexed fields an event may have (SPEC §6, "Events").
const MAX_INDEXED: usize = MAX_TOPICS - 1

// A set of contract fields with one bit per field, so it holds at most MAX_FIELDS fields.
struct FieldSet { bits: u256 }

impl Copy for FieldSet {}

pub const MAX_FIELDS: usize = 256
const NO_FIELDS: FieldSet = FieldSet { bits: 0 }

impl FieldSet {
    fn add(self, _ f: FieldIndex) -> FieldSet {
        FieldSet { bits: self.bits | f.bit() }
    }

    fn without(self, _ f: FieldIndex) -> FieldSet {
        FieldSet { bits: self.bits & ~f.bit() }
    }

    fn has(self, _ f: FieldIndex) -> bool {
        self.bits & f.bit() != 0
    }
}

// A contract field's position among the contract's fields, counted from 0.
struct FieldIndex { n: usize }

impl Copy for FieldIndex {}

impl FieldIndex {
    fn bit(self) -> u256 {
        1 << self.n as u256
    }
}

// A slot in a body's frame. Parameters take the first slots, in order, then locals.
pub struct FrameSlot { n: usize }

impl Copy for FrameSlot {}

impl FrameSlot {
    // Returns the slot's number, counted from the first slot of the frame.
    pub fn number(self) -> usize {
        self.n
    }
}

// A word of an event's log data, counted from the first. The data words (SPEC §6, "Events")
// come first, then one word for each indexed field, which LOGn takes as a topic.
pub struct LogWord { n: usize }

impl Copy for LogWord {}

// The first word of the log data.
pub const FIRST_LOG_WORD: LogWord = LogWord { n: 0 }

impl LogWord {
    // Returns word `n` of the log data.
    pub fn at(_ n: usize) -> LogWord {
        LogWord { n }
    }

    // Returns the word's number, counted from the first word of the log data.
    pub fn number(self) -> usize {
        self.n
    }
}

// What code generation needs to log an event: its topic 0, and the number of words of its log
// data that hold its data fields.
pub struct EventLog { topic0: WordId, data_words: usize }

impl Copy for EventLog {}

impl Wire for EventLog {
    fn put(self, _ w: mut Writer) {
        w.lanes(self.topic0.index(), self.data_words, 0, 0)
    }

    fn take(_ r: mut Reader) -> EventLog {
        let l = r.lanes()
        EventLog { topic0: WordId::at(l.a()), data_words: l.b() }
    }
}

const SLOT_BYTES: usize = 32

// Where a contract field lives in storage (SPEC §6): its slot, and its bytes in the slot,
// counted from the low end. Fields narrower than a slot share one, as in Fe 26.6.0.
pub struct StoragePlace { slot: usize, offset: usize, size: usize, ends_slot: bool }

impl Copy for StoragePlace {}

impl Wire for StoragePlace {
    fn put(self, _ w: mut Writer) {
        w.lanes(self.slot, self.offset, self.size, flag(self.ends_slot))
    }

    fn take(_ r: mut Reader) -> StoragePlace {
        let l = r.lanes()
        StoragePlace { slot: l.a(), offset: l.b(), size: l.c(), ends_slot: is_flag(l.d()) }
    }
}

// The place before the first field's, so that the first field starts slot 0.
const NO_PLACE: StoragePlace = StoragePlace { slot: 0, offset: 0, size: 0, ends_slot: false }

impl StoragePlace {
    // Returns the place of a field of `size` bytes declared right after the field at this
    // place: the bytes that follow, or the next slot when they do not fit.
    fn next(self, _ size: usize) -> StoragePlace {
        let end = self.offset + self.size
        if end + size <= SLOT_BYTES {
            StoragePlace { slot: self.slot, offset: end, size, ends_slot: false }
        } else {
            StoragePlace { slot: self.slot + 1, offset: 0, size, ends_slot: false }
        }
    }

    // Returns this place, marked as the last one in its slot.
    fn ended(self) -> StoragePlace {
        StoragePlace { slot: self.slot, offset: self.offset, size: self.size, ends_slot: true }
    }

    // Returns the slot, as the word that SLOAD and SSTORE take.
    pub fn slot(self) -> u256 {
        self.slot as u256
    }

    // Returns the number of bits below the field in its slot.
    pub fn shift(self) -> u256 {
        (self.offset * 8) as u256
    }

    // Checks whether the field has the slot to itself, so that it is read and written whole.
    pub fn whole(self) -> bool {
        self.offset == 0 && self.ends_slot
    }

    // Checks whether another field may hold bytes above this one in its slot.
    pub fn shared_above(self) -> bool {
        !self.ends_slot
    }

    // Returns a word with the field's bits set, at the low end. Only for a field narrower than
    // a slot.
    pub fn mask(self) -> u256 {
        (1 << (self.size * 8) as u256) - 1
    }
}

// What the `uses` list of the body being checked grants, and which granted fields the body has
// read or assigned so far.
struct Grant { list: ListId, read: FieldSet, write: FieldSet, used: FieldSet }

impl Copy for Grant {}

const NO_GRANT: Grant = Grant {
    list: EMPTY_LIST,
    read: NO_FIELDS,
    write: NO_FIELDS,
    used: NO_FIELDS,
}

// What `check` returns. On error, the program's side tables are partly filled.
// This is not a `Result` for the same reason `Ast` is not.
pub struct CheckOutput {
    pub program: Checked,
    pub err: Option<Diag>,
    // Warnings, in source order: unused `uses` entries (E_UNUSED_USE).
    pub warns: MemVec<Diag>,
}

// The spellings of the methods of `Ctx` that Fe0 supports (SPEC.md §6, "The caller").
const W_CALLER: Spelling = Spelling::of(0x63616c6c6572)
const W_ADDRESS: Spelling = ABI_ADDRESS
const W_ORIGIN: Spelling = Spelling::of(0x6f726967696e)
const W_COINBASE: Spelling = Spelling::of(0x636f696e62617365)
const W_GASPRICE: Spelling = Spelling::of(0x6761737072696365)
const W_BLOCK_NUMBER: Spelling = Spelling::of(0x626c6f636b5f6e756d626572)
const W_PREVRANDAO: Spelling = Spelling::of(0x7072657672616e64616f)
const W_GASLIMIT: Spelling = Spelling::of(0x6761736c696d6974)
const W_CHAINID: Spelling = Spelling::of(0x636861696e6964)
const W_BASEFEE: Spelling = Spelling::of(0x62617365666565)
const W_BLOBBASEFEE: Spelling = Spelling::of(0x626c6f6262617365666565)

struct CtxMethod { op: Op, ty: Ty }

impl Copy for CtxMethod {}

// Returns the method of `Ctx` spelled `name`, or None when Fe0 has no such method (SPEC.md §6,
// "The caller"). The methods are a chain of tests, not a table: a table made the Checker larger
// (docs/adr/0017-caller.md, update Nov 17).
fn ctx_method(_ name: Spelling) -> Option<CtxMethod> {
    if name == W_CALLER {
        return Option::Some(CtxMethod { op: OP_CALLER, ty: TY_ADDRESS })
    }
    if name == W_ADDRESS {
        return Option::Some(CtxMethod { op: OP_ADDRESS, ty: TY_ADDRESS })
    }
    if name == W_ORIGIN {
        return Option::Some(CtxMethod { op: OP_ORIGIN, ty: TY_ADDRESS })
    }
    if name == W_COINBASE {
        return Option::Some(CtxMethod { op: OP_COINBASE, ty: TY_ADDRESS })
    }
    if name == W_GASPRICE {
        return Option::Some(CtxMethod { op: OP_GASPRICE, ty: TY_U256 })
    }
    if name == W_BLOCK_NUMBER {
        return Option::Some(CtxMethod { op: OP_NUMBER, ty: TY_U256 })
    }
    if name == W_PREVRANDAO {
        return Option::Some(CtxMethod { op: OP_PREVRANDAO, ty: TY_U256 })
    }
    if name == W_GASLIMIT {
        return Option::Some(CtxMethod { op: OP_GASLIMIT, ty: TY_U256 })
    }
    if name == W_CHAINID {
        return Option::Some(CtxMethod { op: OP_CHAINID, ty: TY_U256 })
    }
    if name == W_BASEFEE {
        return Option::Some(CtxMethod { op: OP_BASEFEE, ty: TY_U256 })
    }
    if name == W_BLOBBASEFEE {
        return Option::Some(CtxMethod { op: OP_BLOBBASEFEE, ty: TY_U256 })
    }
    Option::None
}

// A node of the kind that `K` names. A slot of a node may hold a node of any kind, which is
// a convention and not a type (ADR 0005). So the side tables of `Checked` name the kind in
// the type (task T4qdcy).
pub struct Id<K> { n: NodeId }

impl<K> Copy for Id<K> {}

impl<K> Id<K> {
    pub fn node_id(self) -> NodeId {
        self.n
    }

    fn is_none(self) -> bool {
        self.n.is_none()
    }
}

// A node that declares a name: a PARAM, LET or BIND, a contract FIELD, or an item.
pub struct Decl {}

// A FIELD: a field of a variant, of an event or of the contract.
pub struct Field {}

// A VARIANT of a msg.
pub struct Variant {}

pub struct Event {}

pub struct Msg {}

// A FN.
pub struct Callee {}

trait Item {
    fn kind() -> Kind
}

impl Item for Event {
    fn kind() -> Kind {
        NODE_EVENT
    }
}

impl Item for Msg {
    fn kind() -> Kind {
        NODE_MSG
    }
}

// The FIELD list of a VARIANT, an EVENT or the contract. Lists mix kinds (ADR 0005), so this
// type is what makes a lookup in it return an `Id<Field>`.
struct Fields { l: ListId }

impl Copy for Fields {}

// The checked program: the AST and the side tables that code generation reads.
pub struct Checked {
    pub ast: Ast,
    // The type of every expression node, and of every node that declares a name: CONST, PARAM,
    // contract FIELD, LET and BIND.
    types: MemVec<Ty>,
    // The node that each node refers to, read through the methods below.
    res: MemVec<NodeId>,
    // One number per node, written and read through the methods below. It is one side table
    // indexed by node (DESIGN.md §3), so its meaning depends on the node's kind.
    slots: MemVec<usize>,
    // The storage place of each contract field, by FieldIndex.
    places: MemVec<StoragePlace>,
    // The EventLog of each event, by the EVENT's slot.
    events: MemVec<EventLog>,
    // The CONTRACT item, or NO_NODE.
    pub the_contract: NodeId,
}

impl Wire for Checked {
    fn put(self, _ w: mut Writer) {
        self.ast.put(mut w)
        self.types.put(mut w)
        self.res.put(mut w)
        self.slots.put(mut w)
        self.places.put(mut w)
        self.events.put(mut w)
        self.the_contract.put(mut w)
    }

    fn take(_ r: mut Reader) -> Checked {
        let ast = Ast::take(mut r)
        let types = Wire::take(mut r)
        let res = Wire::take(mut r)
        let slots = Wire::take(mut r)
        let places = Wire::take(mut r)
        let events = Wire::take(mut r)
        let the_contract = NodeId::take(mut r)
        Checked { ast, types, res, slots, places, events, the_contract }
    }
}

impl Checked {
    // Returns the number of nodes. Each side table has one entry per node.
    pub fn node_count(self) -> usize {
        self.types.len()
    }

    // Returns the type of node `i`.
    pub fn ty(self, _ i: NodeId) -> Ty {
        self.types[i.index()]
    }

    // Returns the node that declares the name of NAME or INDEX node `i`. For an INDEX it is a
    // contract FIELD, since only a contract field may be a map (SPEC §6, "Maps").
    pub fn declaration(self, _ i: NodeId) -> Id<Decl> {
        Id { n: self.res[i.index()] }
    }

    // Returns the FIELD that BIND, USE or ARG node `i` names.
    pub fn field_of(self, _ i: NodeId) -> Id<Field> {
        Id { n: self.res[i.index()] }
    }

    pub fn event_of(self, _ emit: NodeId) -> Id<Event> {
        Id { n: self.res[emit.index()] }
    }

    pub fn callee(self, _ call: NodeId) -> Id<Callee> {
        Id { n: self.res[call.index()] }
    }

    pub fn msg_of(self, _ recv: NodeId) -> Id<Msg> {
        Id { n: self.res[recv.index()] }
    }

    // Returns the VARIANT that ARM or MSG_CALL node `i` handles or calls.
    pub fn variant_of(self, _ i: NodeId) -> Id<Variant> {
        Id { n: self.res[i.index()] }
    }

    // Returns the value of CONST node `d`.
    pub fn word_of(self, _ d: NodeId) -> u256 {
        self.ast.word(WordId::at(self.slots[d.index()]))
    }

    fn set_word(mut self, _ d: NodeId, _ v: u256) {
        let w = self.ast.add_word(v)
        self.slots.set(d.index(), w.index())
    }

    // Returns the word of the log data that holds the value of an event's FIELD node `f`.
    pub fn log_word(self, _ f: NodeId) -> LogWord {
        LogWord { n: self.slots[f.index()] }
    }

    fn set_log_word(mut self, _ f: NodeId, _ w: LogWord) {
        self.slots.set(f.index(), w.n)
    }

    // Returns topic 0 of EVENT node `e`.
    pub fn topic0(self, _ e: NodeId) -> u256 {
        self.ast.word(self.event_log(e).topic0)
    }

    // Returns the number of words of EVENT node `e`'s log data that hold its data fields.
    pub fn data_words(self, _ e: NodeId) -> usize {
        self.event_log(e).data_words
    }

    fn event_log(self, _ e: NodeId) -> EventLog {
        self.events[self.slots[e.index()]]
    }

    fn set_event_log(mut self, _ e: NodeId, _ log: EventLog) {
        self.slots.set(e.index(), self.events.len())
        self.events.push(log)
    }

    // Returns the frame slot of LET, PARAM or BIND node `d`.
    pub fn frame_slot(self, _ d: NodeId) -> FrameSlot {
        FrameSlot { n: self.slots[d.index()] }
    }

    fn set_frame_slot(mut self, _ d: NodeId, _ slot: FrameSlot) {
        self.slots.set(d.index(), slot.n)
    }

    // Returns the number of frame slots that FN, INIT or ARM node `owner` uses.
    pub fn frame_slots(self, _ owner: NodeId) -> usize {
        self.slots[owner.index()]
    }

    fn set_frame_slots(mut self, _ owner: NodeId, _ count: usize) {
        self.slots.set(owner.index(), count)
    }

    fn field_index(self, _ f: NodeId) -> FieldIndex {
        FieldIndex { n: self.slots[f.index()] }
    }

    fn set_field_index(mut self, _ f: NodeId, _ i: FieldIndex) {
        self.slots.set(f.index(), i.n)
    }

    // Returns the instruction that reads the value of CTX_READ node `i`.
    pub fn ctx_op(self, _ i: NodeId) -> Op {
        Op::from_wire(self.slots[i.index()])
    }

    fn set_ctx_op(mut self, _ i: NodeId, _ op: Op) {
        self.slots.set(i.index(), op.wire())
    }

    // Returns the storage place of contract FIELD node `f`.
    pub fn storage_place(self, _ f: NodeId) -> StoragePlace {
        self.places[self.slots[f.index()]]
    }
}

// What makes two nodes of a list duplicates: the same name, or the same msg selector.
struct Key { selector: bool }

impl Copy for Key {}

const BY_NAME: Key = Key { selector: false }
const BY_SELECTOR: Key = Key { selector: true }

// A local declaration in scope.
struct Local { sym: Sym, decl: NodeId }

impl Copy for Local {}

// The result of evaluating a constant expression.
struct Val { v: u256, ty: Ty }

impl Copy for Val {}

struct Checker {
    c: Checked,
    warns: MemVec<Diag>,
    body: Body,
    // The contract's `Call` effect, or NO_NODE.
    call_effect: NodeId,
}

// The state of checking one FN, INIT or ARM body. `begin` replaces it for each body.
struct Body {
    // The locals in scope, innermost last.
    locals: MemVec<Local>,
    // Frame slots used so far.
    frame: usize,
    grant: Grant,
    // The type that `return` values and the body's value must have.
    ret: Ty,
    // How many `while` loops enclose the current statement.
    loops: usize,
}

// Returns the type of both the operand and the result of unary operator `op`.
fn unary_ty(_ op: Tok) -> Ty {
    if op == O_BANG { TY_BOOL } else { TY_U256 }
}

// Checks whether binary operator `op` is `==` or `!=`. The operands of these two operators may
// have any one type.
fn is_equality(_ op: Tok) -> bool {
    op == O_EQ || op == O_NE
}

// Returns the type of the operands of binary operator `op`, for any `op` other than `==` and
// `!=`.
fn operand_ty(_ op: Tok) -> Ty {
    if op == O_ANDAND || op == O_OROR {
        TY_BOOL
    } else {
        TY_U256
    }
}

fn result_ty(_ op: Tok) -> Ty {
    if op == O_ANDAND || op == O_OROR || op.is_comparison() {
        TY_BOOL
    } else {
        TY_U256
    }
}

impl Checker {
    fn node(self, _ i: NodeId) -> Node {
        self.c.ast.node(i)
    }

    fn at(self, _ code: DiagCode, _ i: NodeId) -> Diag {
        diag(code, self.node(i).pos())
    }

    fn len(self, _ l: ListId) -> usize {
        self.c.ast.list_len(l)
    }

    fn elem(self, _ l: ListId, _ k: usize) -> NodeId {
        self.c.ast.list_at(l, k)
    }

    fn set_ty(mut self, _ i: NodeId, _ t: Ty) {
        self.c.types.set(i.index(), t.or_u256())
    }

    // Records what node `i` refers to. The kind of `d` is the kind that a reader of `res`
    // returns for `i`. The body is not generic: a copy per kind made Checker 171 bytes larger
    // (Fe 26.6.0, -O s, Nov 19).
    fn set_res<K>(mut self, _ i: NodeId, _ d: Id<K>) {
        self.set_res_raw(i, d.n)
    }

    fn set_res_raw(mut self, _ i: NodeId, _ d: NodeId) {
        self.c.res.set(i.index(), d)
    }

    // Returns the node in list `l` named `sym`, or NO_NODE when no node has that name.
    fn find(self, _ l: ListId, _ sym: Sym) -> NodeId {
        var k: usize = 0
        while k < self.len(l) {
            let i = self.elem(l, k)
            if self.node(i).name() == sym {
                return i
            }
            k += 1
        }
        NO_NODE
    }

    // Errors with N_DUPLICATE at the first node in list `l` whose name an earlier node already has.
    fn unique(self, _ l: ListId) -> Result<Diag, ()> {
        var k: usize = 1
        while k < self.len(l) {
            let i = self.elem(l, k)
            if self.seen(i, l, k, BY_NAME) {
                return Result::Err(self.at(N_DUPLICATE, i))
            }
            k += 1
        }
        Result::Ok(())
    }

    // Checks whether one of the first `n` nodes in list `l` has the same key `by` as node `i`.
    // ponytail: every caller compares each node with all earlier ones. That is O(n²) in a list's
    // length, and O(n²) in all received variants across msgs. Lists and msgs are short.
    fn seen(self, _ i: NodeId, _ l: ListId, _ n: usize, _ by: Key) -> bool {
        var j: usize = 0
        while j < n {
            if self.same_key(self.elem(l, j), i, by) {
                return true
            }
            j += 1
        }
        false
    }

    // Checks whether one of the first `n` ARGs of list `l` names FIELD `f`.
    fn names_field(self, _ l: ListId, _ n: usize, _ f: Id<Field>) -> bool {
        var j: usize = 0
        while j < n {
            if self.c.field_of(self.elem(l, j)).n == f.n {
                return true
            }
            j += 1
        }
        false
    }

    // Checks whether nodes `a` and `b` have the same key `by`.
    fn same_key(self, _ a: NodeId, _ b: NodeId, _ by: Key) -> bool {
        if by.selector {
            return self.c.ast.word_value(a) == self.c.ast.word_value(b)
        }
        self.node(a).name() == self.node(b).name()
    }

    // Returns the contract FIELD named `sym`, or NO_NODE when no field has that name.
    fn field(self, _ sym: Sym) -> Id<Field> {
        if self.c.the_contract.is_none() {
            return Id { n: NO_NODE }
        }
        self.field_in(Fields { l: self.node(self.c.the_contract).list() }, sym)
    }

    // Returns the FIELD in `fields` named `sym`, or NO_NODE when no field has that name.
    fn field_in(self, _ fields: Fields, _ sym: Sym) -> Id<Field> {
        Id { n: self.find(fields.l, sym) }
    }

    fn variant_fields(self, _ v: Id<Variant>) -> Fields {
        Fields { l: self.node(v.n).list() }
    }

    fn event_fields(self, _ e: Id<Event>) -> Fields {
        Fields { l: self.node(e.n).list() }
    }

    fn variants(self, _ m: Id<Msg>) -> ListId {
        self.node(m.n).list()
    }

    // Returns the VARIANT of msg `m` named `sym`, or NO_NODE when no variant has that name.
    fn variant(self, _ m: Id<Msg>, _ sym: Sym) -> Id<Variant> {
        Id { n: self.find(self.variants(m), sym) }
    }

    // Returns the item named `sym`, or NO_NODE when no item has that name.
    fn item(self, _ sym: Sym) -> NodeId {
        self.find(self.c.ast.items, sym)
    }

    // Returns the item named `sym`, which node `i` uses as a `K`. Errors at `i` with
    // N_UNKNOWN_NAME when no item is named `sym`, and with `wrong` when it is of another kind.
    fn item_of<K: Item>(self, _ sym: Sym, _ i: NodeId, _ wrong: DiagCode) -> Result<Diag, Id<K>> {
        let d = self.item(sym)
        if d.is_none() {
            return Result::Err(self.at(N_UNKNOWN_NAME, i))
        }
        if self.node(d).kind != K::kind() {
            return Result::Err(self.at(wrong, i))
        }
        Result::Ok(Id { n: d })
    }

    fn local(self, _ sym: Sym) -> NodeId {
        var k = self.body.locals.len()
        while k > 0 {
            k -= 1
            if self.body.locals[k].sym == sym {
                return self.body.locals[k].decl
            }
        }
        NO_NODE
    }

    // Returns the node that declares `sym` where it is used, or NO_NODE when nothing does. The
    // node is a local, a field or an item.
    fn lookup(self, _ sym: Sym) -> NodeId {
        let l = self.local(sym)
        if !l.is_none() { return l }
        let f = self.field(sym)
        if !f.is_none() { return f.n }
        self.item(sym)
    }

    // Returns the node that declares the name of NAME, CALL, CTX_READ or INDEX `i`. Errors with
    // N_UNKNOWN_NAME when nothing declares it.
    fn resolve(self, _ i: NodeId) -> Result<Diag, Id<Decl>> {
        let d = self.lookup(self.node(i).name())
        if d.is_none() {
            return Result::Err(self.at(N_UNKNOWN_NAME, i))
        }
        Result::Ok(Id { n: d })
    }

    // Declares the parameter or local `sym` in the next frame slot. Errors with N_SHADOWS_FIELD,
    // N_SHADOWS_ITEM or N_UPPERCASE_LOCAL at `decl` when SPEC §5.2 does not allow the name.
    fn declare(mut self, _ sym: Sym, _ decl: NodeId, _ ty: Ty) -> Result<Diag, ()> {
        if !self.field(sym).is_none() {
            return Result::Err(self.at(N_SHADOWS_FIELD, decl))
        }
        if !self.item(sym).is_none() {
            return Result::Err(self.at(N_SHADOWS_ITEM, decl))
        }
        if self.node(decl).kind != NODE_PARAM && self.c.ast.starts_upper(sym) {
            return Result::Err(self.at(N_UPPERCASE_LOCAL, decl))
        }
        self.set_ty(decl, ty)
        self.c.set_frame_slot(decl, FrameSlot { n: self.body.frame })
        self.body.frame += 1
        self.body.locals.push(Local { sym, decl })
        Result::Ok(())
    }

    // Declares the PARAMs in list `l`.
    fn params(mut self, _ l: ListId) -> Result<Diag, ()> {
        self.unique(l)?
        var k: usize = 0
        while k < self.len(l) {
            let p = self.elem(l, k)
            self.declare(self.node(p).name(), p, self.node(p).ty())?
            k += 1
        }
        Result::Ok(())
    }

    // Starts a body that returns `ret`, with no locals and the fields that USE list `l` grants.
    // Errors as `grant` does.
    fn begin(mut self, _ ret: Ty, _ l: ListId) -> Result<Diag, ()> {
        let grant = self.grant(l)?
        // Reuses the locals vector, because EVM memory is never freed.
        var locals = self.body.locals
        locals.truncate(0)
        self.body = Body { locals, frame: 0, grant, ret: ret.or_unit(), loops: 0 }
        Result::Ok(())
    }

    // Returns the fields that USE list `l` grants, and records each entry's FIELD in `res`. A
    // field may be listed more than once, and its last entry decides whether it is `mut`, as in
    // Fe (SPEC §6). Errors with E_UNKNOWN_FIELD at an entry that names no field.
    fn grant(mut self, _ l: ListId) -> Result<Diag, Grant> {
        var read = NO_FIELDS
        var write = NO_FIELDS
        var k: usize = 0
        while k < self.len(l) {
            let u = self.elem(l, k)
            let f = self.field(self.node(u).name())
            if f.is_none() {
                return Result::Err(self.at(E_UNKNOWN_FIELD, u))
            }
            self.set_res(u, f)
            let i = self.c.field_index(f.n)
            read = read.add(i)
            write = if self.node(u).is_mut() {
                write.add(i)
            } else {
                write.without(i)
            }
            k += 1
        }
        Result::Ok(Grant { list: l, read, write, used: NO_FIELDS })
    }

    // Checks BLOCK `body` of FN, INIT or ARM `owner` once its parameters or binds are declared.
    // Records the body's frame size for `Checked.frame_slots`, and warns as `warn_unused` does.
    fn finish(mut self, _ owner: NodeId, _ body: NodeId) -> Result<Diag, ()> {
        self.want(body, self.body.ret)?
        self.c.set_frame_slots(owner, self.body.frame)
        self.warn_unused()
        Result::Ok(())
    }

    // Warns with E_UNUSED_USE at each USE entry whose field the body never read or assigned.
    fn warn_unused(mut self) {
        let l = self.body.grant.list
        var k: usize = 0
        while k < self.len(l) {
            let u = self.elem(l, k)
            if !self.body.grant.used.has(self.c.field_index(self.c.field_of(u).node_id())) {
                self.warns.push(self.at(E_UNUSED_USE, u))
            }
            k += 1
        }
    }

    // Records that the body uses FIELD `f`. Errors with `err` when `allowed` does not hold `f`.
    fn access(mut self, _ f: NodeId, _ allowed: FieldSet, _ err: Diag) -> Result<Diag, ()> {
        let i = self.c.field_index(f)
        if !allowed.has(i) {
            return Result::Err(err)
        }
        self.body.grant.used = self.body.grant.used.add(i)
        Result::Ok(())
    }

    // Returns the one CONTRACT item, or NO_NODE when the program has none. Errors with
    // N_TWO_CONTRACTS at the second one.
    fn find_contract(self) -> Result<Diag, NodeId> {
        let items = self.c.ast.items
        var found = NO_NODE
        var k: usize = 0
        while k < self.len(items) {
            let i = self.elem(items, k)
            if self.node(i).kind == NODE_CONTRACT {
                if !found.is_none() {
                    return Result::Err(self.at(N_TWO_CONTRACTS, i))
                }
                found = i
            }
            k += 1
        }
        Result::Ok(found)
    }

    fn program(mut self) -> Result<Diag, ()> {
        let items = self.c.ast.items
        self.unique(items)?
        self.c.the_contract = self.find_contract()?
        if !self.c.the_contract.is_none() {
            self.fields()?
        }
        // Constants first, in source order, so that bodies can use their values.
        var k: usize = 0
        while k < self.len(items) {
            let i = self.elem(items, k)
            if self.node(i).kind == NODE_CONST {
                self.constant(i)?
            }
            k += 1
        }
        k = 0
        while k < self.len(items) {
            let i = self.elem(items, k)
            let kind = self.node(i).kind
            if kind == NODE_FN {
                self.fn_item(i)?
            } else if kind == NODE_MSG {
                self.msg_item(i)?
            } else if kind == NODE_EVENT {
                self.event_item(i)?
            }
            k += 1
        }
        if !self.c.the_contract.is_none() {
            self.contract_item()?
        }
        Result::Ok(())
    }

    // Gives each contract field its index and storage place. Fields share the item namespace.
    // Errors with N_DUPLICATE at a field named like another field or an item, with
    // E_TOO_MANY_FIELDS at a field past MAX_FIELDS, and as `note_call_effect` does.
    fn fields(mut self) -> Result<Diag, ()> {
        let l = self.node(self.c.the_contract).list()
        self.unique(l)?
        var prev = NO_PLACE
        var k: usize = 0
        while k < self.len(l) {
            let f = self.elem(l, k)
            if k == MAX_FIELDS {
                return Result::Err(self.at(E_TOO_MANY_FIELDS, f))
            }
            if !self.item(self.node(f).name()).is_none() {
                return Result::Err(self.at(N_DUPLICATE, f))
            }
            let ty = self.node(f).ty()
            self.note_call_effect(f, ty)?
            self.set_ty(f, ty)
            self.c.set_field_index(f, FieldIndex { n: k })
            let place = prev.next(ty.storage_bytes())
            if k > 0 && place.slot != prev.slot {
                self.c.places.set(k - 1, prev.ended())
            }
            self.c.places.push(place)
            prev = place
            k += 1
        }
        if k > 0 {
            self.c.places.set(k - 1, prev.ended())
        }
        Result::Ok(())
    }

    // Keeps field `f` of type `ty` as the contract's `Call` effect when it is one. A call does not
    // name its effect, so a contract has at most one. Errors with N_DUPLICATE at a second one.
    fn note_call_effect(mut self, _ f: NodeId, _ ty: Ty) -> Result<Diag, ()> {
        if ty == TY_CALL {
            if !self.call_effect.is_none() {
                return Result::Err(self.at(N_DUPLICATE, f))
            }
            self.call_effect = f
        }
        Result::Ok(())
    }

    fn constant(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i)
        let v = self.eval(n.value())?
        if !v.ty.fits(n.ty()) {
            return Result::Err(self.at(T_MISMATCH, n.value()))
        }
        self.c.set_word(i, v.v)
        self.set_ty(i, n.ty())
        Result::Ok(())
    }

    // Evaluates constant expression `i` with the checked arithmetic of SPEC §4.
    fn eval(mut self, _ i: NodeId) -> Result<Diag, Val> {
        let n = self.node(i)
        let k = n.kind
        var v = Val { v: 0, ty: TY_INT }
        if k == NODE_INT {
            v.v = self.c.ast.word_value(i)
        } else if k == NODE_BOOL {
            v = Val { v: flag(n.is_true()), ty: TY_BOOL }
        } else if k == NODE_NAME {
            // This is item_of written out. Calling item_of here made Checker 79 bytes larger
            // (Fe 26.6.0, -O s, Nov 15).
            let d: Id<Decl> = Id { n: self.item(n.name()) }
            if d.is_none() {
                return Result::Err(self.at(N_UNKNOWN_NAME, i))
            }
            if self.node(d.n).kind != NODE_CONST {
                return Result::Err(self.at(C_NOT_CONST, i))
            }
            // Constants are evaluated in source order, so a later one has no type yet.
            if self.c.ty(d.n) == TY_NONE {
                return Result::Err(self.at(N_FORWARD_CONST, i))
            }
            self.set_res(i, d)
            v = Val { v: self.c.word_of(d.n), ty: self.c.ty(d.n) }
        } else if k == NODE_UNARY {
            let a = self.eval(n.operand())?
            v.ty = self.fit(n.operand(), a.ty, unary_ty(n.op()))?
            v.v = if n.op() == O_BANG {
                a.v ^ 1
            } else if n.op() == O_TILDE { ~a.v } else { a.v }
        } else if k == NODE_BINARY {
            v = self.eval_binary(i)?
        } else {
            return Result::Err(self.at(C_NOT_CONST, i))
        }
        self.set_ty(i, v.ty)
        Result::Ok(v)
    }

    // Evaluates BINARY `i`. Errors with C_OVERFLOW or C_DIV_ZERO when the operation overflows or
    // divides by zero.
    fn eval_binary(mut self, _ i: NodeId) -> Result<Diag, Val> {
        let n = self.node(i)
        let op = n.op()
        let a = self.eval(n.lhs())?
        let b = self.eval(n.rhs())?
        let ty = self.binary_ty(i, a.ty, b.ty)?
        if is_equality(op) {
            return Result::Ok(Val { v: flag((a.v == b.v) == (op == O_EQ)), ty })
        }
        let x = a.v
        let y = b.v
        var r: u256 = 0
        if op == O_PLUS {
            if x > U256_MAX - y {
                return Result::Err(self.at(C_OVERFLOW, i))
            }
            r = x + y
        } else if op == O_MINUS {
            if y > x {
                return Result::Err(self.at(C_OVERFLOW, i))
            }
            r = x - y
        } else if op == O_STAR {
            if x != 0 && y > U256_MAX / x {
                return Result::Err(self.at(C_OVERFLOW, i))
            }
            r = x * y
        } else if op == O_SLASH || op == O_PERCENT {
            if y == 0 {
                return Result::Err(self.at(C_DIV_ZERO, i))
            }
            r = if op == O_SLASH { x / y } else { x % y }
        } else if op == O_SHL || op == O_SHR {
            // As on the EVM, a shift by 256 or more gives 0.
            if y < 256 {
                r = if op == O_SHL { x << y } else { x >> y }
            }
        } else if op == O_AMP || op == O_ANDAND {
            // Both operands of `&&` and `||` were evaluated, so a constant whose right operand
            // would fail is rejected even when it is never reached. That is stricter than run
            // time, and the subset rule allows it.
            r = x & y
        } else if op == O_PIPE || op == O_OROR {
            r = x | y
        } else if op == O_CARET {
            r = x ^ y
        } else if op == O_LT {
            r = flag(x < y)
        } else if op == O_GT {
            r = flag(x > y)
        } else if op == O_LE {
            r = flag(x <= y)
        } else if op == O_GE {
            r = flag(x >= y)
        }
        Result::Ok(Val { v: r, ty })
    }

    fn fn_item(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i)
        // Free functions are pure, so they may touch no field. The FN's use_list is always
        // EMPTY_LIST. Passing the constant costs bytecode (argotorg/fe#1964, see
        // docs/WORKAROUNDS.md).
        self.begin(n.ty(), n.use_list())?
        self.params(n.list())?
        self.finish(i, n.body())
    }

    fn msg_item(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let variants = self.node(i).list()
        self.unique(variants)?
        var k: usize = 0
        while k < self.len(variants) {
            let v = self.elem(variants, k)
            self.unique(self.node(v).list())?
            if self.c.ast.word_value(v) > SELECTOR_MAX {
                return Result::Err(self.at(T_SELECTOR_TOO_LARGE, v))
            }
            if self.seen(v, variants, k, BY_SELECTOR) {
                return Result::Err(self.at(N_DUPLICATE_SELECTOR, v))
            }
            k += 1
        }
        Result::Ok(())
    }

    // Checks EVENT `e`, gives each of its fields its word of the log data, and records its
    // EventLog. Errors with T_TOO_MANY_INDEXED at a fourth indexed field.
    fn event_item(mut self, _ e: NodeId) -> Result<Diag, ()> {
        let l = self.node(e).list()
        self.unique(l)?
        var data: usize = 0
        var k: usize = 0
        while k < self.len(l) {
            if !self.node(self.elem(l, k)).is_indexed() {
                data += 1
            }
            k += 1
        }
        var data_word: usize = 0
        var indexed: usize = 0
        k = 0
        while k < self.len(l) {
            let f = self.elem(l, k)
            if !self.node(f).is_indexed() {
                self.c.set_log_word(f, LogWord { n: data_word })
                data_word += 1
            } else if indexed == MAX_INDEXED {
                return Result::Err(self.at(T_TOO_MANY_INDEXED, f))
            } else {
                self.c.set_log_word(f, LogWord { n: data + indexed })
                indexed += 1
            }
            k += 1
        }
        let topic0 = self.c.ast.add_word(self.topic0(e))
        self.c.set_event_log(e, EventLog { topic0, data_words: data })
        Result::Ok(())
    }

    // Returns topic 0 of EVENT `e` (SPEC §6, "Events"). It hashes a signature such as
    // `Moved(address,uint256)`.
    fn topic0(self, _ e: NodeId) -> u256 {
        let n = self.node(e)
        var sig: MemVec<u8> = MemVec::new()
        sig.extend_from_slice(self.c.ast.name_bytes(n.name()))
        sig.push(b'(')
        var k: usize = 0
        while k < self.len(n.list()) {
            if k > 0 { sig.push(b',') }
            self.node(self.elem(n.list(), k)).ty().abi_name().push_bytes(mut sig)
            k += 1
        }
        sig.push(b')')
        keccak256(sig.as_slice().as_bytes())
    }

    fn contract_item(mut self) -> Result<Diag, ()> {
        let n = self.node(self.c.the_contract)
        if !n.init().is_none() {
            let init = self.node(n.init())
            self.begin(TY_NONE, init.use_list())?
            self.params(init.list())?
            self.finish(n.init(), init.body())?
        }
        // Each RECV is named after its msg, so this rejects two blocks for one msg.
        self.unique(n.recvs())?
        var k: usize = 0
        while k < self.len(n.recvs()) {
            self.recv(self.elem(n.recvs(), k))?
            k += 1
        }
        self.distinct_received_selectors(n.recvs())
    }

    // Errors with N_DUPLICATE_SELECTOR when two msgs received in RECV list `l` share a selector, so
    // that the dispatcher could not tell their variants apart. Each msg's own selectors are
    // already distinct (`msg_item`).
    fn distinct_received_selectors(self, _ l: ListId) -> Result<Diag, ()> {
        var k: usize = 1
        while k < self.len(l) {
            let vs = self.received(self.elem(l, k))
            var i: usize = 0
            while i < self.len(vs) {
                self.distinct_received_selector(self.elem(vs, i), l, k)?
                i += 1
            }
            k += 1
        }
        Result::Ok(())
    }

    // Errors with N_DUPLICATE_SELECTOR at VARIANT `v` when a msg received by one of the first `k`
    // RECVs in list `l` has its selector.
    fn distinct_received_selector(self, _ v: NodeId, _ l: ListId, _ k: usize) -> Result<Diag, ()> {
        var j: usize = 0
        while j < k {
            let earlier = self.received(self.elem(l, j))
            if self.seen(v, earlier, self.len(earlier), BY_SELECTOR) {
                return Result::Err(self.at(N_DUPLICATE_SELECTOR, v))
            }
            j += 1
        }
        Result::Ok(())
    }

    // Returns the VARIANT list of the msg that checked RECV `r` receives.
    fn received(self, _ r: NodeId) -> ListId {
        self.variants(self.c.msg_of(r))
    }

    // Checks RECV `r` and each of its arms against the msg it names. Errors as `item_of` does,
    // with N_NOT_A_MSG when the name is not a msg, and with N_MISSING_ARM when a variant has no
    // arm.
    fn recv(mut self, _ r: NodeId) -> Result<Diag, ()> {
        let n = self.node(r)
        let m: Id<Msg> = self.item_of(n.name(), r, N_NOT_A_MSG)?
        self.set_res(r, m)
        let variants = self.variants(m)
        self.unique(n.list())?
        var k: usize = 0
        while k < self.len(n.list()) {
            let a = self.elem(n.list(), k)
            let v = self.variant(m, self.node(a).name())
            if v.is_none() {
                return Result::Err(self.at(N_UNKNOWN_VARIANT, a))
            }
            self.set_res(a, v)
            self.arm(a, v)?
            k += 1
        }
        // The arms are distinct variants, so equal counts mean every variant has one.
        if self.len(n.list()) != self.len(variants) {
            return Result::Err(self.at(N_MISSING_ARM, r))
        }
        Result::Ok(())
    }

    // Checks ARM `a` of VARIANT `v` (SPEC §6, "Messages and dispatch").
    fn arm(mut self, _ a: NodeId, _ v: Id<Variant>) -> Result<Diag, ()> {
        let n = self.node(a)
        if n.ty() != self.node(v.n).ty() {
            return Result::Err(self.at(T_MISMATCH, a))
        }
        let fields = self.variant_fields(v)
        self.unique(n.list())?
        self.begin(n.ty(), n.use_list())?
        var k: usize = 0
        while k < self.len(n.list()) {
            let b = self.elem(n.list(), k)
            let f = self.field_in(fields, self.node(b).name())
            if f.is_none() {
                return Result::Err(self.at(N_UNKNOWN_FIELD, b))
            }
            if !self.local(self.node(b).local()).is_none() {
                return Result::Err(self.at(N_DUPLICATE, b))
            }
            self.set_res(b, f)
            self.declare(self.node(b).local(), b, self.node(f.n).ty())?
            k += 1
        }
        if self.len(n.list()) != self.len(fields.l) {
            return Result::Err(self.at(N_MISSING_BIND, a))
        }
        self.finish(a, n.body())
    }

    // Checks that the type of expression `i` fits `ty`, and returns what fit returns for it.
    fn want(mut self, _ i: NodeId, _ ty: Ty) -> Result<Diag, Ty> {
        let t = self.expr(i)?
        self.fit(i, t, ty)
    }

    // Returns `want`, or TY_INT when `t`, the type of expression `i`, is TY_INT. Errors with
    // T_MISMATCH when `t` does not fit `want`.
    fn fit(self, _ i: NodeId, _ t: Ty, _ want: Ty) -> Result<Diag, Ty> {
        if !t.fits(want) {
            return Result::Err(self.at(T_MISMATCH, i))
        }
        Result::Ok(if t == TY_INT { TY_INT } else { want })
    }

    // Checks expression `i` and returns its type, which must not be unit.
    fn value(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let t = self.expr(i)?
        if t == TY_UNIT {
            return Result::Err(self.at(T_NO_VALUE, i))
        }
        Result::Ok(t)
    }

    // Checks expression `i` and returns its type.
    fn expr(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let n = self.node(i)
        let k = n.kind
        var t = TY_UNIT
        if k == NODE_INT {
            t = TY_INT
        } else if k == NODE_BOOL {
            t = TY_BOOL
        } else if k == NODE_NAME {
            t = self.name(i)?
        } else if k == NODE_BINARY {
            t = self.binary(i)?
        } else if k == NODE_UNARY {
            t = self.want(n.operand(), unary_ty(n.op()))?
        } else if k == NODE_CALL {
            t = self.call(i)?
        } else if k == NODE_IF {
            t = self.if_expr(i)?
        } else if k == NODE_BLOCK {
            t = self.block(i)?
        } else if k == NODE_ASSERT {
            let _ = self.want(n.cond(), TY_BOOL)?
        } else if k == NODE_CTX_READ {
            t = self.ctx_read(i)?
        } else if k == NODE_ZERO_ADDRESS {
            t = TY_ADDRESS
        } else if k == NODE_INDEX {
            let m = self.read(i)?
            t = self.entry(i, m)?
        } else if k == NODE_EMIT {
            self.emit(i)?
        } else if k == NODE_MSG_CALL {
            t = self.msg_call(i)?
        }
        self.set_ty(i, t)
        Result::Ok(t)
    }

    // Returns the node that declares the name of node `i`, as `resolve` finds it, and records it
    // as what `i` refers to. When that node is a FIELD, also records a read of the contract
    // field. Errors as `resolve` does, and with E_NOT_IN_USES when the body's `uses` does not
    // grant the field.
    fn read(mut self, _ i: NodeId) -> Result<Diag, Id<Decl>> {
        let d = self.resolve(i)?
        if self.node(d.n).kind == NODE_FIELD {
            self.access(d.n, self.body.grant.read, self.at(E_NOT_IN_USES, i))?
        }
        self.set_res(i, d)
        Result::Ok(d)
    }

    fn name(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let d = self.read(i)?
        if !self.c.ty(d.n).is_value() {
            return Result::Err(self.at(N_NOT_A_VALUE, i))
        }
        Result::Ok(self.c.ty(d.n))
    }

    // Returns the type of CTX_READ `i` and records the instruction that `Checked.ctx_op` returns.
    // Errors as `effect` does, and with N_UNKNOWN_NAME when `ctx_method` finds no method of that
    // name.
    fn ctx_read(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        self.effect(i, TY_CTX)?
        let m = match ctx_method(self.c.ast.spelling(self.node(i).method())) {
            Option::Some(m) => m,
            Option::None => {
                return Result::Err(self.at(N_UNKNOWN_NAME, i))
            },
        }
        self.c.set_ctx_op(i, m.op)
        Result::Ok(m.ty)
    }

    // Returns the declaration that the name of node `i` refers to. Errors as `read` does, and
    // with T_MISMATCH when that declaration is not an effect of type `want`.
    fn effect(mut self, _ i: NodeId, _ want: Ty) -> Result<Diag, NodeId> {
        let d = self.read(i)?
        if self.c.ty(d.n) != want {
            return Result::Err(self.at(T_MISMATCH, i))
        }
        Result::Ok(d.n)
    }

    // Checks the key of INDEX `i`, whose name `m` declares, and returns the type of the map's
    // values. Errors with T_MISMATCH when `m` is not a map or the key does not fit the map's key
    // type.
    fn entry(mut self, _ i: NodeId, _ m: Id<Decl>) -> Result<Diag, Ty> {
        let t = self.c.ty(m.n)
        if !t.is_map() {
            return Result::Err(self.at(T_MISMATCH, i))
        }
        self.want(self.node(i).key(), t.map_key())?
        Result::Ok(t.map_value())
    }

    // Checks EMIT `i` (SPEC §6, "Events"). Errors as `effect`, `item_of` and `labeled_args` do,
    // with E_NOT_MUT when the body may not write the `Log` effect, and with T_MISMATCH when the
    // event's name is not an event.
    fn emit(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i)
        let log = self.effect(i, TY_LOG)?
        self.access(log, self.body.grant.write, self.at(E_NOT_MUT, i))?
        let e: Id<Event> = self.item_of(n.event(), i, T_MISMATCH)?
        self.set_res(i, e)
        self.labeled_args(i, self.event_fields(e))
    }

    // Checks MSG_CALL `i` (SPEC §6, "Calls") and returns the variant's return type, or unit when
    // it has none. Errors as `use_call_effect`, `want`, `called_variant` and `labeled_args` do.
    fn msg_call(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        self.use_call_effect(i)?
        self.want(self.node(i).target(), TY_ADDRESS)?
        let v = self.called_variant(i)?
        self.set_res(i, v)
        self.labeled_args(i, self.variant_fields(v))?
        Result::Ok(self.node(v.n).ty().or_unit())
    }

    // Checks that the body of MSG_CALL `i` may write the contract's `Call` effect. Errors with
    // E_NOT_IN_USES when the body's `uses` does not grant it, and with E_NOT_MUT when it grants
    // it without `mut`.
    fn use_call_effect(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let call = self.call_effect
        if call.is_none() {
            return Result::Err(self.at(E_NOT_IN_USES, i))
        }
        self.access(call, self.body.grant.read, self.at(E_NOT_IN_USES, i))?
        self.access(call, self.body.grant.write, self.at(E_NOT_MUT, i))
    }

    // Returns the VARIANT that `M::V` of MSG_CALL `i` names. Errors as `item_of` does, with
    // N_NOT_A_MSG when `M` is not a msg, and with N_UNKNOWN_VARIANT when `M` has no variant `V`.
    fn called_variant(self, _ i: NodeId) -> Result<Diag, Id<Variant>> {
        let n = self.node(i)
        let m: Id<Msg> = self.item_of(n.msg_name(), i, N_NOT_A_MSG)?
        let v = self.variant(m, n.variant())
        if v.is_none() {
            return Result::Err(self.at(N_UNKNOWN_VARIANT, i))
        }
        Result::Ok(v)
    }

    // Records the FIELD of list `fields` that each labeled ARG of EMIT or MSG_CALL `i` names, and
    // checks the ARG's value against the field's type. Errors with N_UNKNOWN_FIELD or N_DUPLICATE
    // at a bad argument, as `want` does, and with N_MISSING_FIELD when a field has no value.
    fn labeled_args(mut self, _ i: NodeId, _ fields: Fields) -> Result<Diag, ()> {
        let args = self.node(i).list()
        var k: usize = 0
        while k < self.len(args) {
            let a = self.elem(args, k)
            let arg = self.c.ast.arg(a)
            let f = self.field_in(fields, arg.label())
            if f.is_none() {
                return Result::Err(self.at(N_UNKNOWN_FIELD, a))
            }
            if self.names_field(args, k, f) {
                return Result::Err(self.at(N_DUPLICATE, a))
            }
            self.set_res(a, f)
            self.want(arg.value(), self.node(f.n).ty())?
            k += 1
        }
        if k != self.len(fields.l) {
            return Result::Err(self.at(N_MISSING_FIELD, i))
        }
        Result::Ok(())
    }

    fn binary(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let n = self.node(i)
        let a = if is_equality(n.op()) {
            self.value(n.lhs())?
        } else {
            self.expr(n.lhs())?
        }
        let b = self.expr(n.rhs())?
        self.binary_ty(i, a, b)
    }

    // Returns the type of BINARY `i`, whose operands have types `a` and `b`. Errors when an
    // operand does not fit the operator, or when it compares two TY_INT operands.
    fn binary_ty(self, _ i: NodeId, _ a: Ty, _ b: Ty) -> Result<Diag, Ty> {
        let n = self.node(i)
        let op = n.op()
        let want = if is_equality(op) {
            a.or_u256()
        } else {
            operand_ty(op)
        }
        let lhs = self.fit(n.lhs(), a, want)?
        let rhs = self.fit(n.rhs(), b, lhs.or_u256())?
        if lhs != TY_INT || rhs != TY_INT {
            return Result::Ok(result_ty(op))
        }
        if result_ty(op) == TY_U256 {
            return Result::Ok(TY_INT)
        }
        // Nothing makes the operands of a comparison u256.
        Result::Err(self.at(T_NEEDS_TYPE, i))
    }

    // Checks the arguments of CALL `i` against the parameters of its function (SPEC §5.4).
    fn call(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let n = self.node(i)
        let d = self.resolve(i)?
        if self.node(d.n).kind != NODE_FN {
            return Result::Err(self.at(N_NOT_A_FUNCTION, i))
        }
        let f: Id<Callee> = Id { n: d.n }
        self.set_res(i, f)
        let params = self.node(f.n).list()
        let args = n.list()
        if self.len(args) != self.len(params) {
            return Result::Err(self.at(T_ARG_COUNT, i))
        }
        var k: usize = 0
        while k < self.len(args) {
            let a = self.c.ast.arg(self.elem(args, k))
            let p = self.node(self.elem(params, k))
            if !a.fits(p) {
                return Result::Err(self.at(N_BAD_LABEL, self.elem(args, k)))
            }
            self.want(a.value(), p.ty())?
            k += 1
        }
        Result::Ok(self.node(f.n).ty().or_unit())
    }

    // Checks IF `i` and its `else if` chain. Returns the type of the whole chain, which every IF
    // of the chain gets.
    fn if_expr(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        // The type of the branches so far.
        var ty = TY_NEVER
        var at = i
        // A loop, as the parser reads the chain, so that a long chain does not recurse.
        while true {
            let n = self.node(at)
            self.want(n.cond(), TY_BOOL)?
            ty = self.join(ty, n.body())?
            let e = n.otherwise()
            if e.is_none() {
                // Without `else`, the IF has no value, so neither may its branches.
                if !ty.fits(TY_UNIT) {
                    return Result::Err(self.at(T_MISMATCH, n.body()))
                }
                ty = TY_UNIT
                break
            }
            if self.node(e).kind != NODE_IF {
                ty = self.join(ty, e)?
                break
            }
            at = e
        }
        at = i
        while !at.is_none() && self.node(at).kind == NODE_IF {
            self.set_ty(at, ty)
            at = self.node(at).otherwise()
        }
        Result::Ok(ty)
    }

    // Checks branch `b` and joins its type with `ty`, the type of the branches before it.
    fn join(mut self, _ ty: Ty, _ b: NodeId) -> Result<Diag, Ty> {
        let t = self.expr(b)?
        if ty.fits(t) {
            return Result::Ok(t)
        }
        if !t.fits(ty) {
            return Result::Err(self.at(T_MISMATCH, b))
        }
        Result::Ok(ty)
    }

    // A block's type is its tail's, even after a statement that never completes (SPEC §5).
    // Without a tail, it is TY_NEVER if a statement never completes, else unit.
    fn block(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let n = self.node(i)
        let mark = self.body.locals.len()
        var t = TY_UNIT
        var k: usize = 0
        while k < self.len(n.list()) {
            if self.stmt(self.elem(n.list(), k))? == TY_NEVER {
                t = TY_NEVER
            }
            k += 1
        }
        if !n.value().is_none() {
            t = self.expr(n.value())?
        }
        self.body.locals.truncate(mark)
        Result::Ok(t)
    }

    // Checks statement `i`. Returns TY_NEVER if it never completes, else unit.
    fn stmt(mut self, _ i: NodeId) -> Result<Diag, Ty> {
        let n = self.node(i)
        let k = n.kind
        if k == NODE_LET {
            self.let_stmt(i)?
            return Result::Ok(TY_UNIT)
        }
        if k == NODE_WHILE {
            self.while_stmt(i)?
            return Result::Ok(TY_UNIT)
        }
        if k == NODE_RETURN {
            if !n.value().is_none() {
                let _ = self.want(n.value(), self.body.ret)?
            } else if self.body.ret != TY_UNIT {
                return Result::Err(self.at(T_MISMATCH, i))
            }
            return Result::Ok(TY_NEVER)
        }
        if k == NODE_BREAK || k == NODE_CONTINUE {
            if self.body.loops == 0 {
                return Result::Err(self.at(N_OUTSIDE_LOOP, i))
            }
            return Result::Ok(TY_NEVER)
        }
        if k == NODE_ASSIGN {
            self.assign(i)?
            return Result::Ok(TY_UNIT)
        }
        let t = self.expr(i)?
        if t == TY_INT {
            return Result::Err(self.at(T_NEEDS_TYPE, i))
        }
        Result::Ok(if t == TY_NEVER { TY_NEVER } else { TY_UNIT })
    }

    // Checks LET `i` and declares its local.
    fn let_stmt(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i).as_let()
        var t = self.value(n.value())?
        if n.ty() != TY_NONE {
            if !t.fits(n.ty()) {
                return Result::Err(self.at(T_MISMATCH, n.value()))
            }
            t = n.ty()
        } else if t == TY_NEVER {
            return Result::Err(self.at(T_NO_VALUE, n.value()))
        } else if t == TY_INT {
            return Result::Err(self.at(T_NEEDS_TYPE, n.value()))
        }
        // Declared after its value, so a local is not in scope in its own initializer.
        self.declare(n.name(), i, t)
    }

    fn while_stmt(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i)
        self.want(n.cond(), TY_BOOL)?
        self.body.loops += 1
        let body = self.expr(n.body())?
        self.body.loops -= 1
        if !body.fits(TY_UNIT) {
            return Result::Err(self.at(T_MISMATCH, n.body()))
        }
        Result::Ok(())
    }

    fn assign(mut self, _ i: NodeId) -> Result<Diag, ()> {
        let n = self.node(i)
        let p = n.place()
        let d = self.resolve(p)?
        let target = self.node(d.n)
        let t = if self.node(p).kind == NODE_INDEX {
            self.entry(p, d)?
        } else {
            self.c.ty(d.n)
        }
        if target.kind == NODE_FIELD && t.is_value() {
            self.access(d.n, self.body.grant.write, self.at(E_NOT_MUT, i))?
        } else if target.kind != NODE_LET || !target.as_let().is_var() {
            // An effect or a whole map is no more assignable than a `let`, even when `uses`
            // names it `mut`.
            return Result::Err(self.at(N_ASSIGN_IMMUTABLE, i))
        }
        self.set_res(p, d)
        // Every compound operator is arithmetic or bitwise on u256.
        if n.op() != O_ASSIGN && t != TY_U256 {
            return Result::Err(self.at(T_MISMATCH, i))
        }
        self.want(n.value(), t)?
        Result::Ok(())
    }
}

// Checks `ast`. A lexer or parser error in `ast.err` is passed on without checking.
pub fn check(_ ast: own Ast) -> CheckOutput {
    var types: MemVec<Ty> = MemVec::new()
    var res: MemVec<NodeId> = MemVec::new()
    var slots: MemVec<usize> = MemVec::new()
    var k: usize = 0
    while k < ast.node_count() {
        types.push(TY_NONE)
        res.push(NO_NODE)
        slots.push(0)
        k += 1
    }
    var err = ast.err
    var c = Checker {
        c: Checked {
            ast,
            types,
            res,
            slots,
            places: MemVec::new(),
            events: MemVec::new(),
            the_contract: NO_NODE,
        },
        warns: MemVec::new(),
        body: Body { locals: MemVec::new(), frame: 0, grant: NO_GRANT, ret: TY_UNIT, loops: 0 },
        call_effect: NO_NODE,
    }
    if err.is_none() {
        match c.program() {
            Result::Ok(_) => {},
            Result::Err(d) => {
                err = Option::Some(d)
            },
        }
    }
    CheckOutput { program: c.c, err, warns: c.warns }
}
