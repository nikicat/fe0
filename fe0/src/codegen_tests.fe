}

contract CgInit {
    mut a: u256,
    mut b: bool,
    mut c: Address,

    init(x: u256, y: bool, z: Address)
    uses (mut a, mut b, mut c)
    {
        a = x
        b = y
        c = z
    }

    recv CgInitMsg {
        Get {} -> u256 uses (a) {
            a
        }
        Flag {} -> bool uses (b) {
            b
        }
        Who {} -> Address uses (c) {
            c
        }
    }
}

msg CgMiscMsg {
    #[selector = 1]
    Unit { a: u256 } -> u256,
    #[selector = 2]
    Pending { a: u256 } -> u256,
    #[selector = 3]
    Deep { n: u256 } -> u256,
    #[selector = 4]
    Who { a: Address, b: Address } -> Address,
    #[selector = 5]
    Long { a: u256 },
    #[selector = 6]
    Shadow { a: u256 } -> u256,
    #[selector = 7]
    Flag {} -> bool,
}

const ON: bool = true
const BIG: u256 = 1 << 255

// A unit function that returns early, and one that returns a unit call.
fn bump(_ a: u256) {
    if a == 0 { return }
    assert!(a != 7)
}

fn bump_twice(_ a: u256) {
    bump(a)
    return bump(a + 1)
}

fn deep(_ n: u256) -> u256 {
    if n == 0 { 0 } else { 1 + deep(n - 1) }
}

fn pick(_ c: bool, _ a: Address, _ b: Address) -> Address {
    if c { a } else { b }
}

contract CgMisc {
    mut count: u256,

    recv CgMiscMsg {
        Unit { a } -> u256 uses (mut count) {
            bump_twice(a)
            count += 1
            count
        }
        Pending { a } -> u256 {
            var i: u256 = 0
            let r = 1
                + {
                    while true {
                        i += 1
                        if i >= a { break }
                        if i == 100 { return 7 }
                    }
                    i * 2
                }
            r + BIG / BIG
        }
        Deep { n: m } -> u256 {
            deep(m)
        }
        Who { a, b } -> Address {
            pick(ON, a, b) == pick(!ON, b, a)
            pick(a == b, a, b)
        }
        Long { a } {
            assert!(a == 0, "abcdefghijklmnopqrstuvwxyz01234")
        }
        Shadow { a } -> u256 {
            let x = a
            let y = {
                let x = x + 1
                x * 2
            }
            x + y
        }
        Flag {} -> bool {
            ON
        }
    }
}

