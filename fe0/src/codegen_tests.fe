pub fn run_init() uses (evm: mut Evm) {
    let b = difftest::Builds {
        ours: difftest::ours(
            "msg CgInitMsg {\n    #[selector = 1]\n    Get -> u256,\n    #[selector = 2]\n    Flag -> bool,\n    #[selector = 3]\n    Who -> Address,\n}\n\ncontract CgInit {\n    mut a: u256,\n    mut b: bool,\n    mut c: Address,\n\n    init(x: u256, y: bool, z: Address) uses (mut a, mut b, mut c) {\n        a = x\n        b = y\n        c = z\n    }\n\n    recv CgInitMsg {\n        Get {} -> u256 uses (a) {\n            a\n        }\n        Flag {} -> bool uses (b) {\n            b\n        }\n        Who {} -> Address uses (c) {\n            c\n        }\n    }\n}\n",
        ),
        theirs: difftest::theirs(CgInit::init_code_offset(), CgInit::init_code_len()),
    }
    {
        var a = difftest::Payload::new(Wei::zero())
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000001))
    }
    {
        var a = difftest::Payload::new(Wei::zero())
        a.push_word(0xaa)
        a.push_word(0x1)
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000002))
    }
    {
        var a = difftest::Payload::new(Wei::zero())
        a.push_word(0xaa)
        a.push_word(0x2)
        a.push_word(0xcc)
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000003))
    }
    {
        var a = difftest::Payload::new(Wei::zero())
        a.push_word(0xaa)
        a.push_word(0x1)
        a.push_word(0x1000000000000000000000000000000000000000000000000cc)
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000004))
    }
    {
        var a = difftest::Payload::new(Wei::zero())
        a.push_word(0xaa)
        a.push_word(0x1)
        a.push_word(0xcc)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000005))
    }
    {
        var a = difftest::Payload::new(std::evm::wei(5))
        a.push_word(0xaa)
        a.push_word(0x1)
        a.push_word(0xcc)
        let _ = b.deploy(a, difftest::CaseCode::new(0x100000006))
    }
    var a = difftest::Payload::new(Wei::zero())
    a.push_word(0xaa)
    a.push_word(0x1)
    a.push_word(0xcc)
    let p = b.deploy_main(a, difftest::CaseCode::new(0x100001000))
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x1)
        p.call(d, difftest::CaseCode::new(0x100001001))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x2)
        p.call(d, difftest::CaseCode::new(0x100001002))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x3)
        p.call(d, difftest::CaseCode::new(0x100001003))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        p.call(d, difftest::CaseCode::new(0x200000001))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push(0)
        d.push(0)
        d.push(1)
        p.call(d, difftest::CaseCode::new(0x200000002))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x7777)
        p.call(d, difftest::CaseCode::new(0x200000003))
    }
}

