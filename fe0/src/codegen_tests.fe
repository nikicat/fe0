#[test(balance = 1000)]
fn init() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours(
            "msg CgInitMsg {\n    #[selector = 1]\n    Get -> u256,\n    #[selector = 2]\n    Flag -> bool,\n    #[selector = 3]\n    Who -> Address,\n}\n\ncontract CgInit {\n    mut a: u256,\n    mut b: bool,\n    mut c: Address,\n\n    init(x: u256, y: bool, z: Address) uses (mut a, mut b, mut c) {\n        a = x\n        b = y\n        c = z\n    }\n\n    recv CgInitMsg {\n        Get {} -> u256 uses (a) {\n            a\n        }\n        Flag {} -> bool uses (b) {\n            b\n        }\n        Who {} -> Address uses (c) {\n            c\n        }\n    }\n}\n",
        ),
        theirs: theirs(CgInit::init_code_offset(), CgInit::init_code_len()),
    }
    {
        var a: MemVec<u8> = MemVec::new()
        let _ = b.deploy(a, Wei::zero(), 1)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0xaa, bytes: 32)
        push_be(mut a, 0x1, bytes: 32)
        let _ = b.deploy(a, Wei::zero(), 2)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0xaa, bytes: 32)
        push_be(mut a, 0x2, bytes: 32)
        push_be(mut a, 0xcc, bytes: 32)
        let _ = b.deploy(a, Wei::zero(), 3)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0xaa, bytes: 32)
        push_be(mut a, 0x1, bytes: 32)
        push_be(
            mut a,
            0x1000000000000000000000000000000000000000000000000cc,
            bytes: 32,
        )
        let _ = b.deploy(a, Wei::zero(), 4)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0xaa, bytes: 32)
        push_be(mut a, 0x1, bytes: 32)
        push_be(mut a, 0xcc, bytes: 32)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        a.push(0x99)
        let _ = b.deploy(a, Wei::zero(), 5)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0xaa, bytes: 32)
        push_be(mut a, 0x1, bytes: 32)
        push_be(mut a, 0xcc, bytes: 32)
        let _ = b.deploy(a, std::evm::wei(5), 6)
    }
    var a: MemVec<u8> = MemVec::new()
    push_be(mut a, 0xaa, bytes: 32)
    push_be(mut a, 0x1, bytes: 32)
    push_be(mut a, 0xcc, bytes: 32)
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        p.call(d, Wei::zero(), 1001)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x2, bytes: 4)
        p.call(d, Wei::zero(), 1002)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x3, bytes: 4)
        p.call(d, Wei::zero(), 1003)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        p.call(d, Wei::zero(), 1004)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        d.push(0)
        d.push(0)
        d.push(1)
        p.call(d, Wei::zero(), 1005)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x7777, bytes: 4)
        p.call(d, Wei::zero(), 1006)
    }
}

#[test(balance = 1000)]
fn misc() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours(
            "msg CgMiscMsg {\n    #[selector = 1]\n    Unit { a: u256 } -> u256,\n    #[selector = 2]\n    Pending { a: u256 } -> u256,\n    #[selector = 3]\n    Deep { n: u256 } -> u256,\n    #[selector = 4]\n    Who { a: Address, b: Address } -> Address,\n    #[selector = 5]\n    Long { a: u256 },\n    #[selector = 6]\n    Shadow { a: u256 } -> u256,\n    #[selector = 7]\n    Flag {} -> bool,\n}\n\nconst ON: bool = true\nconst BIG: u256 = 1 << 255\n\n// A unit function that returns early, and one that returns a unit call.\nfn bump(_ a: u256) {\n    if a == 0 { return }\n    assert!(a != 7)\n}\n\nfn bump_twice(_ a: u256) {\n    bump(a)\n    return bump(a + 1)\n}\n\nfn deep(_ n: u256) -> u256 {\n    if n == 0 { 0 } else { 1 + deep(n - 1) }\n}\n\nfn pick(_ c: bool, _ a: Address, _ b: Address) -> Address {\n    if c { a } else { b }\n}\n\ncontract CgMisc {\n    mut count: u256,\n\n    recv CgMiscMsg {\n        Unit { a } -> u256 uses (mut count) {\n            bump_twice(a)\n            count += 1\n            count\n        }\n        Pending { a } -> u256 {\n            var i: u256 = 0\n            let r = 1 + {\n                while true {\n                    i += 1\n                    if i >= a { break }\n                    if i == 100 { return 7 }\n                }\n                i * 2\n            }\n            r + BIG / BIG\n        }\n        Deep { n: m } -> u256 {\n            deep(m)\n        }\n        Who { a, b } -> Address {\n            pick(ON, a, b) == pick(!ON, b, a)\n            pick(a == b, a, b)\n        }\n        Long { a } {\n            assert!(a == 0, \"abcdefghijklmnopqrstuvwxyz01234\")\n        }\n        Shadow { a } -> u256 {\n            let x = a\n            let y = {\n                let x = x + 1\n                x * 2\n            }\n            x + y\n        }\n        Flag {} -> bool {\n            ON\n        }\n    }\n}\n",
        ),
        theirs: theirs(CgMisc::init_code_offset(), CgMisc::init_code_len()),
    }
    var a: MemVec<u8> = MemVec::new()
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        push_be(mut d, 0x0, bytes: 32)
        p.call(d, Wei::zero(), 1001)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        push_be(mut d, 0x1, bytes: 32)
        p.call(d, Wei::zero(), 1002)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        push_be(mut d, 0x6, bytes: 32)
        p.call(d, Wei::zero(), 1003)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        push_be(mut d, 0x7, bytes: 32)
        p.call(d, Wei::zero(), 1004)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        push_be(mut d, 0x9, bytes: 32)
        p.call(d, Wei::zero(), 1005)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x2, bytes: 4)
        push_be(mut d, 0x0, bytes: 32)
        p.call(d, Wei::zero(), 1006)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x2, bytes: 4)
        push_be(mut d, 0x5, bytes: 32)
        p.call(d, Wei::zero(), 1007)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x2, bytes: 4)
        push_be(mut d, 0x96, bytes: 32)
        p.call(d, Wei::zero(), 1008)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x3, bytes: 4)
        push_be(mut d, 0x0, bytes: 32)
        p.call(d, Wei::zero(), 1009)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x3, bytes: 4)
        push_be(mut d, 0x12c, bytes: 32)
        p.call(d, Wei::zero(), 1010)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x4, bytes: 4)
        push_be(mut d, 0xaa, bytes: 32)
        push_be(mut d, 0xbb, bytes: 32)
        p.call(d, Wei::zero(), 1011)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x4, bytes: 4)
        push_be(mut d, 0xaa, bytes: 32)
        push_be(mut d, 0xaa, bytes: 32)
        p.call(d, Wei::zero(), 1012)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x5, bytes: 4)
        push_be(mut d, 0x0, bytes: 32)
        p.call(d, Wei::zero(), 1013)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x5, bytes: 4)
        push_be(mut d, 0x1, bytes: 32)
        p.call(d, Wei::zero(), 1014)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x6, bytes: 4)
        push_be(mut d, 0x4, bytes: 32)
        p.call(d, Wei::zero(), 1015)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x7, bytes: 4)
        p.call(d, Wei::zero(), 1016)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        p.call(d, Wei::zero(), 1017)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        d.push(0)
        d.push(0)
        d.push(1)
        p.call(d, Wei::zero(), 1018)
