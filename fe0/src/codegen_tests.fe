#[test(balance = 1000)]
fn chain() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours(
            "msg CgChainMsg {\n    #[selector = 1]\n    Pick { a: u256 } -> u256,\n}\n\ncontract CgChain {\n    recv CgChainMsg {\n        Pick { a } -> u256 {\n            if a == 0 { 0 } else if a == 1 { 1 } else if a == 2 { 2 } else if a == 3 { 3 } else if a == 4 { 4 } else if a == 5 { 5 } else if a == 6 { 6 } else if a == 7 { 7 } else if a == 8 { 8 } else if a == 9 { 9 } else if a == 10 { 10 } else if a == 11 { 11 } else if a == 12 { 12 } else if a == 13 { 13 } else if a == 14 { 14 } else if a == 15 { 15 } else if a == 16 { 16 } else if a == 17 { 17 } else if a == 18 { 18 } else if a == 19 { 19 } else if a == 20 { 20 } else if a == 21 { 21 } else if a == 22 { 22 } else if a == 23 { 23 } else if a == 24 { 24 } else if a == 25 { 25 } else if a == 26 { 26 } else if a == 27 { 27 } else if a == 28 { 28 } else if a == 29 { 29 } else if a == 30 { 30 } else if a == 31 { 31 } else if a == 32 { 32 } else if a == 33 { 33 } else if a == 34 { 34 } else if a == 35 { 35 } else if a == 36 { 36 } else if a == 37 { 37 } else if a == 38 { 38 } else if a == 39 { 39 } else { ((((((((((((((((a)))))))))))))))) + { { { { { { { 1 } } } } } } } }\n        }\n    }\n}\n",
        ),
        theirs: theirs(CgChain::init_code_offset(), CgChain::init_code_len()),
    }
    var a: MemVec<u8> = MemVec::new()
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
