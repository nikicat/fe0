#[test(balance = 1000)]
fn no_recv() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours("contract CgNoRecv {\n    mut n: u256,\n}\n"),
        theirs: theirs(CgNoRecv::init_code_offset(), CgNoRecv::init_code_len()),
    }
    {
        var a: MemVec<u8> = MemVec::new()
        push_be(mut a, 0x5, bytes: 32)
        let _ = b.deploy(a, Wei::zero(), 1)
    }
    var a: MemVec<u8> = MemVec::new()
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x1, bytes: 4)
        p.call(d, Wei::zero(), 1001)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        p.call(d, Wei::zero(), 1002)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        d.push(0)
        d.push(0)
        d.push(1)
        p.call(d, Wei::zero(), 1003)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x7777, bytes: 4)
        p.call(d, Wei::zero(), 1004)
    }
}

fn fails(_ s: DynString) -> Diag {
    let out = with (Source = text(s)) {
        compile()
    }
    assert!(out.code.len() == 0)
    out.err.unwrap()
}

#[test]
fn errors() {
    let d = fails("fn f() -> u256 { 1 }")
    assert!(d.code == G_NO_CONTRACT)
    // An earlier phase's error is passed on.
    let d = fails("contract C {}\nfn f() -> u256 { true }")
    assert!(d.code == T_MISMATCH && d.pos == 29)
}
