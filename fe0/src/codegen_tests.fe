#[test(balance = 1000)]
fn counter() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours(
            "msg CgCounterMsg {\n    #[selector = 0xd09de08a]\n    Increment {},\n    #[selector = 0x6d4ce63c]\n    Get -> u256,\n}\n\ncontract CgCounter {\n    mut count: u256,\n\n    init() uses (mut count) {\n        count = 0\n    }\n\n    recv CgCounterMsg {\n        Increment {} uses (mut count) {\n            count += 1\n        }\n        Get {} -> u256 uses (count) {\n            count\n        }\n    }\n}\n",
        ),
        theirs: theirs(CgCounter::init_code_offset(), CgCounter::init_code_len()),
    }
    {
        var a: MemVec<u8> = MemVec::new()
        let _ = b.deploy(a, std::evm::wei(5), 1)
    }
    {
        var a: MemVec<u8> = MemVec::new()
        a.push(0x99)
        let _ = b.deploy(a, Wei::zero(), 2)
    }
    var a: MemVec<u8> = MemVec::new()
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x6d4ce63c, bytes: 4)
        p.call(d, Wei::zero(), 1001)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0xd09de08a, bytes: 4)
        p.call(d, Wei::zero(), 1002)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0xd09de08a, bytes: 4)
        p.call(d, Wei::zero(), 1003)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x6d4ce63c, bytes: 4)
        p.call(d, Wei::zero(), 1004)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0xd09de08a, bytes: 4)
        p.call(d, std::evm::wei(1), 1005)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x6d4ce63c, bytes: 4)
        push_be(mut d, 0x5, bytes: 32)
        p.call(d, Wei::zero(), 1006)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        p.call(d, Wei::zero(), 1007)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        d.push(0)
        d.push(0)
        d.push(1)
        p.call(d, Wei::zero(), 1008)
    }
    {
        var d: MemVec<u8> = MemVec::new()
        push_be(mut d, 0x7777, bytes: 4)
        p.call(d, Wei::zero(), 1009)
    }
}

#[test(balance = 1000)]
fn ops() uses (evm: mut Evm) {
    let b = Builds {
        ours: ours(
            "msg CgOpsMsg {\n    #[selector = 1]\n    Add { a: u256, b: u256 } -> u256,\n    #[selector = 2]\n    Sub { a: u256, b: u256 } -> u256,\n    #[selector = 3]\n    Mul { a: u256, b: u256 } -> u256,\n    #[selector = 4]\n    Div { a: u256, b: u256 } -> u256,\n    #[selector = 5]\n    Mod { a: u256, b: u256 } -> u256,\n    #[selector = 6]\n    Shl { a: u256, b: u256 } -> u256,\n    #[selector = 7]\n    Shr { a: u256, b: u256 } -> u256,\n    #[selector = 8]\n    Bits { a: u256, b: u256 } -> u256,\n    #[selector = 9]\n    Cmp { a: u256, b: u256 } -> u256,\n    #[selector = 10]\n    Logic { a: bool, b: bool } -> bool,\n    #[selector = 11]\n    Short { a: bool, b: u256 } -> bool,\n    #[selector = 12]\n    Fact { n: u256 } -> u256,\n    #[selector = 13]\n    Sum { n: u256 } -> u256,\n    #[selector = 14]\n    Early { a: u256 } -> u256,\n    #[selector = 15]\n    Order { a: u256 } -> u256,\n    #[selector = 16]\n    Args { a: u256 } -> u256,\n    #[selector = 17]\n    Assert { a: u256 },\n    #[selector = 18]\n    AssertMsg { a: u256 },\n    #[selector = 19]\n    AssertEmpty { a: u256 },\n    #[selector = 20]\n    Aug { a: u256, b: u256 } -> u256,\n    #[selector = 21]\n    Chain { a: u256 } -> u256,\n    #[selector = 22]\n    Store { a: u256, b: bool, c: Address },\n    #[selector = 23]\n    LoadX -> u256,\n    #[selector = 24]\n    LoadFlag -> bool,\n    #[selector = 25]\n    LoadWho -> Address,\n    #[selector = 26]\n    Same { a: Address, b: Address } -> bool,\n    #[selector = 27]\n    Swap { a: u256, b: u256 } -> u256,\n    #[selector = 28]\n    Bump -> u256,\n}\n\nconst TEN: u256 = 10\n\nfn flags(_ a: bool, _ b: bool, _ c: bool, _ d: bool, _ e: bool, _ f: bool) -> u256 {\n    var r: u256 = 0\n    if a { r |= 1 }\n    if b { r |= 2 }\n    if c { r |= 4 }\n    if d { r |= 8 }\n    if e { r |= 16 }\n    if f { r |= 32 }\n    r\n}\n\nfn fact(_ n: u256) -> u256 {\n    if n == 0 { 1 } else { n * fact(n - 1) }\n}\n\n// The sum of the odd numbers up to `n`, with `break` and `continue`.\nfn sum_odd(_ n: u256) -> u256 {\n    var i: u256 = 0\n    var s: u256 = 0\n    while true {\n        i += 1\n        if i > n { break }\n        if i % 2 == 0 { continue }\n        s += i\n    }\n    s\n}\n\n// Returns early from inside an operand, while `1` is pending on the stack.\nfn early(_ a: u256) -> u256 {\n    1 + {\n        if a == 0 { return 100 }\n        a\n    }\n}\n\nfn pair(p: u256, q: u256) -> u256 {\n    p * TEN + q\n}\n\nfn aug(_ a: u256, _ b: u256) -> u256 {\n    var v = a\n    v += b\n    v *= 2\n    v -= 1\n    v /= 3\n    v %= 1000\n    v <<= 2\n    v >>= 1\n    v |= 1\n    v &= 0xff\n    v ^= 3\n    v\n}\n\nfn bump_x(_ v: u256) -> u256 {\n    v + 1\n}\n\ncontract CgOps {\n    mut x: u256,\n    mut flag: bool,\n    mut who: Address,\n\n    recv CgOpsMsg {\n        Add { a, b } -> u256 {\n            a + b\n        }\n        Sub { a, b } -> u256 {\n            a - b\n        }\n        Mul { a, b } -> u256 {\n            a * b\n        }\n        Div { a, b } -> u256 {\n            a / b\n        }\n        Mod { a, b } -> u256 {\n            a % b\n        }\n        Shl { a, b } -> u256 {\n            a << b\n        }\n        Shr { a, b } -> u256 {\n            a >> b\n        }\n        Bits { a, b } -> u256 {\n            (a & b) | (a ^ b) | ~a\n        }\n        Cmp { a, b } -> u256 {\n            flags(a < b, a <= b, a > b, a >= b, a == b, a != b)\n        }\n        Logic { a, b } -> bool {\n            (a && !b) || (!a && b)\n        }\n        Short { a, b } -> bool {\n            (a || 1 / b == 0) && (!a || b == 0 || 1 / b == 0 || true)\n        }\n        Fact { n } -> u256 {\n            fact(n)\n        }\n        Sum { n } -> u256 {\n            sum_odd(n)\n        }\n        Early { a } -> u256 {\n            early(a) + early(a)\n        }\n        Order { a } -> u256 {\n            1 / a + (a - 1)\n        }\n        Args { a } -> u256 {\n            pair(p: 1 / a, q: a - 1)\n        }\n        Assert { a } {\n            assert!(a != 0)\n        }\n        AssertMsg { a } {\n            assert!(a != 0, \"a is zero\")\n        }\n        AssertEmpty { a } {\n            assert!(a != 0, \"\")\n        }\n        Aug { a, b } -> u256 {\n            aug(a, b)\n        }\n        Chain { a } -> u256 {\n            if a == 0 { 10 } else if a == 1 { 11 } else if a == 2 { 12 } else { 13 }\n        }\n        Store { a, b, c } uses (mut x, mut flag, mut who) {\n            x = a\n            flag = b\n            who = c\n        }\n        LoadX {} -> u256 uses (x) {\n            x\n        }\n        LoadFlag {} -> bool uses (flag) {\n            flag\n        }\n        LoadWho {} -> Address uses (who) {\n            who\n        }\n        Same { a, b } -> bool {\n            a == b\n        }\n        Swap { a, b } -> u256 uses (mut x) {\n            {\n                let t = a\n                x = b\n                return t\n            }\n        }\n        Bump {} -> u256 uses (mut x) {\n            x = bump_x(x)\n            x\n        }\n    }\n}\n",
        ),
        theirs: theirs(CgOps::init_code_offset(), CgOps::init_code_len()),
    }
    var a: MemVec<u8> = MemVec::new()
    let p = b.deploy(a, Wei::zero(), 1000)
    assert!(p.ours.word() != 0)
    {
