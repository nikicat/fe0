        d.push_selector(0x1)
        d.push_word(0x9)
        p.call(d, difftest::CaseCode::new(0x100001005))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x2)
        d.push_word(0x0)
        p.call(d, difftest::CaseCode::new(0x100001006))
    }
    {
        var d = difftest::Payload::new(Wei::zero())
        d.push_selector(0x2)
        d.push_word(0x5)
        p.call(d, difftest::CaseCode::new(0x100001007))
    }
    {
