    Swap { a: u256, b: u256 } -> u256,
    #[selector = 28]
    Bump -> u256,
}

const TEN: u256 = 10

fn flags(_ a: bool, _ b: bool, _ c: bool, _ d: bool, _ e: bool, _ f: bool) -> u256 {
    var r: u256 = 0
    if a { r |= 1 }
    if b { r |= 2 }
    if c { r |= 4 }
    if d { r |= 8 }
    if e { r |= 16 }
    if f { r |= 32 }
    r
}

fn fact(_ n: u256) -> u256 {
    if n == 0 { 1 } else { n * fact(n - 1) }
}

// The sum of the odd numbers up to `n`, with `break` and `continue`.
fn sum_odd(_ n: u256) -> u256 {
    var i: u256 = 0
    var s: u256 = 0
    while true {
        i += 1
        if i > n { break }
        if i % 2 == 0 { continue }
        s += i
    }
    s
}

// Returns early from inside an operand, while `1` is pending on the stack.
fn early(_ a: u256) -> u256 {
    1
        + {
            if a == 0 { return 100 }
            a
        }
}

fn pair(p: u256, q: u256) -> u256 {
    p * TEN + q
}

fn aug(_ a: u256, _ b: u256) -> u256 {
    var v = a
    v += b
    v *= 2
    v -= 1
    v /= 3
    v %= 1000
    v <<= 2
    v >>= 1
    v |= 1
    v &= 0xff
    v ^= 3
    v
}

fn bump_x(_ v: u256) -> u256 {
    v + 1
}

contract CgOps {
    mut x: u256,
    mut flag: bool,
    mut who: Address,

    recv CgOpsMsg {
        Add { a, b } -> u256 {
            a + b
        }
        Sub { a, b } -> u256 {
            a - b
        }
        Mul { a, b } -> u256 {
            a * b
        }
        Div { a, b } -> u256 {
            a / b
        }
        Mod { a, b } -> u256 {
            a % b
        }
        Shl { a, b } -> u256 {
            a << b
        }
        Shr { a, b } -> u256 {
            a >> b
        }
        Bits { a, b } -> u256 {
            (a & b) | (a ^ b) | ~a
        }
        Cmp { a, b } -> u256 {
            flags(a < b, a <= b, a > b, a >= b, a == b, a != b)
        }
        Logic { a, b } -> bool {
            (a && !b) || (!a && b)
        }
        Short { a, b } -> bool {
            (a || 1 / b == 0) && (!a || b == 0 || 1 / b == 0 || true)
        }
        Fact { n } -> u256 {
            fact(n)
        }
        Sum { n } -> u256 {
            sum_odd(n)
        }
        Early { a } -> u256 {
            early(a) + early(a)
        }
        Order { a } -> u256 {
            1 / a + (a - 1)
        }
        Args { a } -> u256 {
            pair(p: 1 / a, q: a - 1)
        }
        Assert { a } {
            assert!(a != 0)
        }
        AssertMsg { a } {
            assert!(a != 0, "a is zero")
        }
        AssertEmpty { a } {
            assert!(a != 0, "")
        }
        Aug { a, b } -> u256 {
            aug(a, b)
        }
        Chain { a } -> u256 {
            if a == 0 {
                10
            } else if a == 1 { 11 } else if a == 2 { 12 } else { 13 }
        }
        Store { a, b, c } uses (mut x, mut flag, mut who) {
            x = a
            flag = b
            who = c
        }
        LoadX {} -> u256 uses (x) {
            x
        }
        LoadFlag {} -> bool uses (flag) {
            flag
        }
        LoadWho {} -> Address uses (who) {
            who
        }
        Same { a, b } -> bool {
            a == b
        }
        Swap { a, b } -> u256 uses (mut x) {
            {
                let t = a
                x = b
                return t
            }
        }
        Bump {} -> u256 uses (mut x) {
            x = bump_x(x)
            x
        }
    }
}

