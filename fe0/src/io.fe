// The compiler core reads its input only through the `Source` effect. The adapters here decide
// where the bytes come from. docs/adr/0010-source-effect.md says why the core does not use
// std I/O.

use std::abi::{Bytes, DynString}

pub trait Source {
    // The next byte, or END after the last one.
    fn next_byte(mut self) -> Byte
}

// A byte of the input, or its end (END). END equals no byte and is within no range of
// bytes.
pub struct Byte { raw: u16 }

impl Copy for Byte {}

// The end of the input.
pub const END: Byte = Byte { raw: 0x100 }

impl Byte {
    pub fn of(_ b: u8) -> Byte {
        Byte { raw: b as u16 }
    }

    // Whether this is the end of the input.
    pub fn is_end(self) -> bool {
        self.raw > 0xff
    }

    // Whether this is byte `b`.
    pub fn is(self, _ b: u8) -> bool {
        self.raw == b as u16
    }

    // Whether this is a byte from `lo` to `hi`, both included.
    pub fn within(self, _ lo: u8, _ hi: u8) -> bool {
        self.raw >= lo as u16 && self.raw <= hi as u16
    }

    // Returns the byte. END gives 0.
    pub fn value(self) -> u8 {
        self.raw.downcast_truncate()
    }
}

// Returns a `Source` over the bytes of `s`, such as a test source.
pub fn text(_ s: own DynString) -> BytesReader {
    bytes(s.into_bytes())
}

// Returns a `Source` over `data`, such as source passed in calldata.
pub fn bytes(_ data: own Bytes) -> BytesReader {
    BytesReader { data, pos: 0 }
}

pub struct BytesReader { data: Bytes, pos: usize }

impl Source for BytesReader {
    fn next_byte(mut self) -> Byte {
        if self.pos >= self.data.len() {
            return END
        }
        let c = self.data.byte_at(self.pos)
        self.pos += 1
        Byte::of(c)
    }
}
