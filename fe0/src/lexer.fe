// Turns Fe0 source text into tokens. The rules are in SPEC.md §1, and the design is in
// DESIGN.md §2.

use ingot::diag::{
    Diag,
    DiagCode,
    diag,
    L_BAD_ESCAPE,
    L_BAD_INT,
    L_INT_TOO_LARGE,
    L_LINE_BREAK,
    L_NON_ASCII,
    L_RESERVED_WORD,
    L_UNEXPECTED_CHAR,
    L_UNTERMINATED_STRING,
}
use ingot::io::{Byte, Source}
use ingot::wire::{Lanes, Reader, Wire, Writer}

// The kind of a token. It is a struct and not an enum, because an enum that crosses a contract
// boundary costs bytecode in every phase contract (ADR 0014). The lexer makes only the
// constants below. A Tok from `Tok::from_wire` is only as good as the code it was given.
pub struct Tok { code: u8 }

impl Copy for Tok {}

impl core::ops::Eq for Tok {
    fn eq(self, _ other: Tok) -> bool {
        self.code == other.code
    }
}

// How far each A_ kind's code is from its O_ kind's. O_ kinds span 60-80, so A_ kinds take
// 90-110.
const ASSIGN_OFFSET: u8 = 30

impl Tok {
    // Returns the code that carries this kind across a phase boundary (`wire.fe`).
    pub fn wire(self) -> usize {
        self.code as usize
    }

    // Returns the kind whose `wire()` is `w`.
    pub fn from_wire(_ w: usize) -> Tok {
        Tok { code: w.downcast_truncate() }
    }

    fn after(self, _ k: usize) -> Tok {
        Tok { code: self.code + k.downcast_truncate() }
    }

    // Returns the assignment form of this operator, such as A_PLUS for O_PLUS.
    const fn assign_form(self) -> Tok {
        Tok { code: self.code + ASSIGN_OFFSET }
    }

    // Returns the operator of this assignment operator, such as O_PLUS for A_PLUS.
    pub fn plain_form(self) -> Tok {
        Tok { code: self.code - ASSIGN_OFFSET }
    }

    // Whether this is `=` or an assignment operator such as `+=`.
    pub fn is_assign(self) -> bool {
        self == O_ASSIGN || (self.code >= A_PLUS.code && self.code <= A_SHR.code)
    }

    // Whether this is a type name (SPEC.md §1).
    pub fn is_type_name(self) -> bool {
        self.code >= T_TYPE.code && self.code <= T_ADDRESS.code
    }

    // Whether this is a comparison operator, such as `==` or `<`.
    pub fn is_comparison(self) -> bool {
        self == O_EQ || self == O_NE || self == O_LT || self == O_GT || self == O_LE || self == O_GE
    }

    // Whether this is a binary operator, such as `+` or `&&`. The binary operators are the
    // operators from O_PLUS to O_SHR, except `~`, `!` and `=`.
    pub fn is_binary(self) -> bool {
        self.code >= O_PLUS.code
            && self.code <= O_SHR.code
            && self != O_TILDE
            && self != O_BANG
            && self != O_ASSIGN
    }

    // Whether a line inside parentheses may end with this token: `(`, `,` or a binary operator
    // (SPEC.md §3.4).
    fn may_end_line_in_parens(self) -> bool {
        self == P_LPAREN || self == P_COMMA || self.is_binary()
    }
}

// Token kinds.
pub const T_EOF: Tok = Tok { code: 0 }
pub const T_NEWLINE: Tok = Tok { code: 1 }
pub const T_IDENT: Tok = Tok { code: 2 }
pub const T_INT: Tok = Tok { code: 3 }
pub const T_STR: Tok = Tok { code: 4 }
pub const T_UNDERSCORE: Tok = Tok { code: 5 }
// A type name other than the types Fe0 supports, such as `u8` (SPEC.md §1).
pub const T_TYPE: Tok = Tok { code: 6 }
// The names of the types Fe0 supports (SPEC.md §1).
pub const T_U256: Tok = Tok { code: 7 }
pub const T_BOOL: Tok = Tok { code: 8 }
pub const T_ADDRESS: Tok = Tok { code: 9 }
// The names of the types Fe0 supports, matched as packed words like the keywords (ADR 0014).
// Entry k spells `T_U256.after(k)`.
const TYPE_NAMES: [Spelling; 3] = [
    // u256
    Spelling { packed: 0x75323536 },
    // bool
    Spelling { packed: 0x626f6f6c },
    // Address
    Spelling { packed: 0x41646472657373 },
]
// The spellings of `usize`, `isize` and `String`. Fe has these type names besides the sized
// integers such as `u8`.
const W_USIZE: Spelling = Spelling { packed: 0x7573697a65 }
const W_ISIZE: Spelling = Spelling { packed: 0x6973697a65 }
const W_STRING: Spelling = Spelling { packed: 0x537472696e67 }
// The spelling of `_`.
const W_UNDERSCORE: Spelling = Spelling { packed: 0x5f }

// Fe0 keywords and reserved words: SPEC.md §1.
pub const K_FN: Tok = Tok { code: 10 }
pub const K_LET: Tok = Tok { code: 11 }
pub const K_VAR: Tok = Tok { code: 12 }
pub const K_IF: Tok = Tok { code: 13 }
pub const K_ELSE: Tok = Tok { code: 14 }
pub const K_WHILE: Tok = Tok { code: 15 }
pub const K_RETURN: Tok = Tok { code: 16 }
pub const K_BREAK: Tok = Tok { code: 17 }
pub const K_CONTINUE: Tok = Tok { code: 18 }
pub const K_MSG: Tok = Tok { code: 19 }
pub const K_CONTRACT: Tok = Tok { code: 20 }
pub const K_USES: Tok = Tok { code: 21 }
pub const K_MUT: Tok = Tok { code: 22 }
pub const K_CONST: Tok = Tok { code: 23 }
pub const K_PUB: Tok = Tok { code: 24 }
pub const K_TRUE: Tok = Tok { code: 25 }
pub const K_FALSE: Tok = Tok { code: 26 }
pub const K_STRUCT: Tok = Tok { code: 27 }

// The lexer finds a keyword by one packed word per identifier in this table (ADR 0014).
// Entry k spells `K_FN.after(k)`.
const KEYWORDS: [Spelling; 18] = [
    // fn
    Spelling { packed: 0x666e },
    // let
    Spelling { packed: 0x6c6574 },
    // var
    Spelling { packed: 0x766172 },
    // if
    Spelling { packed: 0x6966 },
    // else
    Spelling { packed: 0x656c7365 },
    // while
    Spelling { packed: 0x7768696c65 },
    // return
    Spelling { packed: 0x72657475726e },
    // break
    Spelling { packed: 0x627265616b },
    // continue
    Spelling { packed: 0x636f6e74696e7565 },
    // msg
    Spelling { packed: 0x6d7367 },
    // contract
    Spelling { packed: 0x636f6e7472616374 },
    // uses
    Spelling { packed: 0x75736573 },
    // mut
    Spelling { packed: 0x6d7574 },
    // const
    Spelling { packed: 0x636f6e7374 },
    // pub
    Spelling { packed: 0x707562 },
    // true
    Spelling { packed: 0x74727565 },
    // false
    Spelling { packed: 0x66616c7365 },
    // struct
    Spelling { packed: 0x737472756374 },
]

// Fe0 rejects every keyword of Fe's lexer as a name (SPEC.md §1, "Reserved words"). These are
// the ones that have no token of their own.
const RESERVED: [Spelling; 22] = [
    // as
    Spelling { packed: 0x6173 },
    // mod
    Spelling { packed: 0x6d6f64 },
    // static_assert
    Spelling { packed: 0x7374617469635f617373657274 },
    // match
    Spelling { packed: 0x6d61746368 },
    // for
    Spelling { packed: 0x666f72 },
    // loop
    Spelling { packed: 0x6c6f6f70 },
    // in
    Spelling { packed: 0x696e },
    // where
    Spelling { packed: 0x7768657265 },
    // yield
    Spelling { packed: 0x7969656c64 },
    // self
    Spelling { packed: 0x73656c66 },
    // Self
    Spelling { packed: 0x53656c66 },
    // enum
    Spelling { packed: 0x656e756d },
    // trait
    Spelling { packed: 0x7472616974 },
    // impl
    Spelling { packed: 0x696d706c },
    // type
    Spelling { packed: 0x74797065 },
    // ref
    Spelling { packed: 0x726566 },
    // own
    Spelling { packed: 0x6f776e },
    // use
    Spelling { packed: 0x757365 },
    // extern
    Spelling { packed: 0x65787465726e },
    // unsafe
    Spelling { packed: 0x756e73616665 },
    // ingot
    Spelling { packed: 0x696e676f74 },
    // super
    Spelling { packed: 0x7375706572 },
]

// A doc comment: `///` up to the end of the line (SPEC.md §1).
pub const T_DOC: Tok = Tok { code: 30 }

// Punctuation.
pub const P_LPAREN: Tok = Tok { code: 40 }
pub const P_RPAREN: Tok = Tok { code: 41 }
pub const P_LBRACE: Tok = Tok { code: 42 }
pub const P_RBRACE: Tok = Tok { code: 43 }
pub const P_LBRACKET: Tok = Tok { code: 44 }
pub const P_RBRACKET: Tok = Tok { code: 45 }
pub const P_COLON: Tok = Tok { code: 46 }
pub const P_COMMA: Tok = Tok { code: 47 }
pub const P_ARROW: Tok = Tok { code: 48 }
pub const P_HASH: Tok = Tok { code: 49 }
pub const P_DOT: Tok = Tok { code: 50 }

// One-byte punctuation is found in this table, which keeps the Lexer small (ADR 0014).
// Entry k is the byte of `P_LPAREN.after(k)`.
// P_ARROW is `->`, so its entry is `_`. `Lexer.token` reads `_` as an identifier before it calls
// `punct`, and no entry is 0, so a NUL byte matches none.
const PUNCT: [u8; 11] = [b'(', b')', b'{', b'}', b'[', b']', b':', b',', b'_', b'#', b'.']
// The bytes of the operators that `=` may follow to make their assignment form. Entry k is the
// byte of `O_PLUS.after(k)` when that operator is one of them, and `_` when it is not, as in
// PUNCT.
const ASSIGNABLE: [u8; 11] = [b'+', b'_', b'*', b'_', b'%', b'_', b'_', b'^', b'_', b'_', b'_']

// Operators.
pub const O_PLUS: Tok = Tok { code: 60 }
pub const O_MINUS: Tok = Tok { code: 61 }
pub const O_STAR: Tok = Tok { code: 62 }
pub const O_SLASH: Tok = Tok { code: 63 }
pub const O_PERCENT: Tok = Tok { code: 64 }
pub const O_TILDE: Tok = Tok { code: 65 }
pub const O_BANG: Tok = Tok { code: 66 }
pub const O_CARET: Tok = Tok { code: 67 }
pub const O_AMP: Tok = Tok { code: 68 }
pub const O_PIPE: Tok = Tok { code: 69 }
pub const O_ANDAND: Tok = Tok { code: 70 }
pub const O_OROR: Tok = Tok { code: 71 }
pub const O_LT: Tok = Tok { code: 72 }
pub const O_GT: Tok = Tok { code: 73 }
pub const O_ASSIGN: Tok = Tok { code: 74 }
pub const O_EQ: Tok = Tok { code: 75 }
pub const O_NE: Tok = Tok { code: 76 }
pub const O_LE: Tok = Tok { code: 77 }
pub const O_GE: Tok = Tok { code: 78 }
pub const O_SHL: Tok = Tok { code: 79 }
pub const O_SHR: Tok = Tok { code: 80 }

// Assignment operators: the `op=` form of each binary operator.
pub const A_PLUS: Tok = O_PLUS.assign_form()
pub const A_MINUS: Tok = O_MINUS.assign_form()
pub const A_STAR: Tok = O_STAR.assign_form()
pub const A_SLASH: Tok = O_SLASH.assign_form()
pub const A_PERCENT: Tok = O_PERCENT.assign_form()
pub const A_CARET: Tok = O_CARET.assign_form()
pub const A_AMP: Tok = O_AMP.assign_form()
pub const A_PIPE: Tok = O_PIPE.assign_form()
pub const A_SHL: Tok = O_SHL.assign_form()
pub const A_SHR: Tok = O_SHR.assign_form()

// The bytes of an identifier as one big-endian number, which `Text.packed` returns. An
// identifier longer than 32 bytes keeps only its last 32 bytes. Its number still differs from
// that of every identifier shorter than 32 bytes, because no byte of an identifier is 0.
pub struct Spelling { packed: u256 }

impl Copy for Spelling {}

impl core::ops::Eq for Spelling {
    fn eq(self, _ other: Spelling) -> bool {
        self.packed == other.packed
    }
}

impl Spelling {
    pub const fn of(_ packed: u256) -> Spelling {
        Spelling { packed }
    }

    // Appends the bytes of this spelling to `out`, first byte first, as `Text.packed` packed
    // them. Skips every zero byte, so it gives back the bytes of any word that has no zero byte.
    pub fn push_bytes(self, _ out: mut MemVec<u8>) {
        var k: u256 = 32
        while k > 0 {
            k -= 1
            let b = (self.packed >> (k * 8)) & 0xff
            if b != 0 {
                out.push(b.downcast_truncate())
            }
        }
    }

    fn keyword(self) -> Tok {
        let k = self.index_in(KEYWORDS)
        if k < KEYWORDS.len() {
            return K_FN.after(k)
        }
        T_IDENT
    }

    // Returns the kind of the type name that this `len`-byte spelling spells, or T_IDENT when it
    // spells none (SPEC.md §1).
    fn type_kind(self, _ len: usize) -> Tok {
        let k = self.index_in(TYPE_NAMES)
        if k < TYPE_NAMES.len() {
            return T_U256.after(k)
        }
        // Putting these three in TYPE_NAMES, as T_TYPE, made Lexer 168 bytes larger
        // (Fe 26.6.0, -O s).
        if self.is_sized_int(len) || self == W_USIZE || self == W_ISIZE || self == W_STRING {
            return T_TYPE
        }
        T_IDENT
    }

    // Whether this `len`-byte spelling is `u` or `i` followed by one of Fe's widths: 8, 16, 32,
    // 64, 128 or 256.
    fn is_sized_int(self, _ len: usize) -> bool {
        if len < 2 || len > 4 {
            return false
        }
        let shift = (len - 1) as u256 * 8
        let c = self.packed >> shift
        let d = self.packed - (c << shift)
        (c == 0x75 || c == 0x69)
            && (d == 0x38
                || d == 0x3136
                || d == 0x3332
                || d == 0x3634
                || d == 0x313238
                || d == 0x323536)
    }

    fn is_reserved(self) -> bool {
        self.index_in(RESERVED) < RESERVED.len()
    }

    fn index_in<const N: usize>(self, _ table: [Spelling; N]) -> usize {
        var k: usize = 0
        while k < N {
            if table[k] == self {
                return k
            }
            k += 1
        }
        N
    }
}

// Identifiers that Fe gives a fixed meaning but does not reserve, unlike the K_ keywords
// (SPEC.md §1).
pub const W_INIT: Spelling = Spelling { packed: 0x696e6974 }
pub const W_RECV: Spelling = Spelling { packed: 0x72656376 }
pub const W_ASSERT: Spelling = Spelling { packed: 0x617373657274 }
pub const W_SELECTOR: Spelling = Spelling { packed: 0x73656c6563746f72 }
pub const W_CTX: Spelling = Spelling { packed: 0x437478 }
pub const W_ZERO: Spelling = Spelling { packed: 0x7a65726f }
pub const W_STORAGE_MAP: Spelling = Spelling { packed: 0x53746f726167654d6170 }
pub const W_EVENT: Spelling = Spelling { packed: 0x6576656e74 }
pub const W_INDEXED: Spelling = Spelling { packed: 0x696e6465786564 }
pub const W_LOG: Spelling = Spelling { packed: 0x4c6f67 }
pub const W_EMIT: Spelling = Spelling { packed: 0x656d6974 }
pub const W_CALL_EFFECT: Spelling = Spelling { packed: 0x43616c6c }
pub const W_CALL: Spelling = Spelling { packed: 0x63616c6c }

// The Solidity names of Fe's value types, which an event's signature spells.
pub const ABI_UINT256: Spelling = Spelling { packed: 0x75696e74323536 }
pub const ABI_BOOL: Spelling = Spelling { packed: 0x626f6f6c }
pub const ABI_ADDRESS: Spelling = Spelling { packed: 0x61646472657373 }

// A byte offset in the source text. A length is a plain count. An offset plus a length is an
// offset. The distance between two offsets is a length.
pub struct Pos { off: usize }

impl Copy for Pos {}

impl core::ops::Eq for Pos {
    fn eq(self, _ other: Pos) -> bool {
        self.off == other.off
    }
}

// The start of the source.
pub const SOURCE_START: Pos = Pos { off: 0 }

impl Pos {
    // Returns the position `off` bytes from the start of the source.
    pub fn at(_ off: usize) -> Pos {
        Pos { off }
    }

    // Returns the offset as a number of bytes from the start of the source.
    pub fn offset(self) -> usize {
        self.off
    }

    // Returns the position `n` bytes after this one.
    pub fn plus(self, _ n: usize) -> Pos {
        Pos { off: self.off + n }
    }

    // Returns the position `n` bytes before this one.
    pub fn minus(self, _ n: usize) -> Pos {
        Pos { off: self.off - n }
    }

    // Returns the number of bytes from `start` to this position.
    pub fn since(self, _ start: Pos) -> usize {
        self.off - start.off
    }
}

// `len` bytes of the source from offset `start`.
pub struct Span { pub start: Pos, pub len: usize }

impl Copy for Span {}

impl Span {
    // Returns the offset just past the last byte.
    pub fn end(self) -> Pos {
        self.start.plus(self.len)
    }

    // Returns where the last plain comment line after this newline token's line break starts,
    // or None when there is no such line. Only a newline token's span holds this (DESIGN.md §2).
    pub fn comment_line(self) -> Option<Pos> {
        if self.len > 1 {
            return Option::Some(self.end().minus(1))
        }
        Option::None
    }

    // Extends this newline token's span to the first byte of the plain comment line at `at`,
    // so that `comment_line` returns `at`.
    fn reach_comment_line(mut self, _ at: Pos) {
        self.len = at.since(self.start) + 1
    }
}

pub struct Token { pub kind: Tok, pub span: Span }

impl Copy for Token {}

impl Wire for Token {
    fn put(self, _ w: mut Writer) {
        self.span.put_beside(self.kind.wire(), mut w)
    }

    fn take(_ r: mut Reader) -> Token {
        let l = r.lanes()
        Token { kind: Tok::from_wire(l.c()), span: Span::from_lanes(l) }
    }
}

impl Span {
    // Puts the span into lanes a and b of one word, with `extra` in lane c.
    fn put_beside(self, _ extra: usize, _ w: mut Writer) {
        w.lanes(self.start.off, self.len, extra, 0)
    }

    // Returns the span that `put_beside` put into `l`.
    fn from_lanes(_ l: Lanes) -> Span {
        Span { start: Pos::at(l.a()), len: l.b() }
    }
}

impl Wire for Span {
    fn put(self, _ w: mut Writer) {
        self.put_beside(0, mut w)
    }

    fn take(_ r: mut Reader) -> Span {
        Span::from_lanes(r.lanes())
    }
}

// The lexed source. On error, `toks` holds the tokens before it. ADR 0011 says why this is
// not a `Result`.
pub struct Lexed { pub text: Text, pub toks: MemVec<Token>, pub err: Option<Diag> }

// A 1-based position in the source text.
pub struct LineCol { pub line: usize, pub col: usize }

impl Copy for LineCol {}

// The source text the lexer read. Spans and tokens index into it.
pub struct Text { bytes: MemVec<u8> }

impl Text {
    // Returns an empty text.
    pub fn new() -> Text {
        Text { bytes: MemVec::new() }
    }

    // Returns a text that holds a copy of `bytes`.
    pub fn of(_ bytes: MemSlice<u8>) -> Text {
        var text = Text::new()
        text.bytes.extend_from_slice(bytes)
        text
    }

    fn push(mut self, _ b: u8) {
        self.bytes.push(b)
    }

    // Returns the offset just past the last byte read so far.
    fn end(self) -> Pos {
        Pos { off: self.bytes.len() }
    }

    // Returns the byte at offset `off`.
    fn byte(self, _ off: usize) -> Byte {
        Byte::of(self.bytes[off])
    }

    // Returns byte `k` of span `s`.
    fn span_byte(self, _ s: Span, _ k: usize) -> Byte {
        self.byte(s.start.plus(k).off)
    }

    // Returns the bytes of span `s` packed into one Spelling, such as W_CTX for `Ctx`.
    pub fn packed(self, _ s: Span) -> Spelling {
        var v: u256 = 0
        var k: usize = 0
        while k < s.len {
            v = (v << 8) | self.span_byte(s, k).value() as u256
            k += 1
        }
        Spelling { packed: v }
    }

    // Whether span `s` starts with an uppercase letter.
    pub fn starts_upper(self, _ s: Span) -> bool {
        self.span_byte(s, 0).is_upper()
    }

    // Whether spans `a` and `b` hold the same text.
    pub fn same(self, _ a: Span, _ b: Span) -> bool {
        a.len == b.len && self.holds(a, self.span_bytes(b))
    }

    // Whether span `s` holds the first `s.len` bytes of `b`. Comparing the two spans as slices
    // made compiling corpus/amm.fe on chain cost 938K more gas (Fe 26.6.0, -O s).
    fn holds(self, _ s: Span, _ b: MemSlice<u8>) -> bool {
        var k: usize = 0
        while k < s.len {
            if !self.span_byte(s, k).is(b[k]) {
                return false
            }
            k += 1
        }
        true
    }

    // The bytes of span `s`.
    pub fn span_bytes(self, _ s: Span) -> ref MemSlice<u8> {
        self.bytes.as_slice().slice(offset: s.start.off, len: s.len)
    }

    // Value of the integer literal at span `s`, which `Lexer::number` scanned. Errors with
    // L_INT_TOO_LARGE at the literal when the value exceeds 2^256 - 1.
    pub fn int_value(self, _ s: Span) -> Result<Diag, u256> {
        var i = s.start.off
        let base = if s.len > 2 {
            self.byte(i + 1).radix()
        } else {
            10
        }
        if base != 10 { i += 2 }
        var v: u256 = 0
        while i < s.end().off {
            let c = self.byte(i)
            if !c.is(b'_') {
                let d = c.digit_value()
                if v > (U256_MAX - d) / base {
                    return Result::Err(diag(L_INT_TOO_LARGE, s.start))
                }
                v = v * base + d
            }
            i += 1
        }
        Result::Ok(v)
    }

    // Pushes the bytes of string literal `s` to `out` as the data words of an ABI-encoded string
    // (SPEC.md §4), with its escapes decoded and its quotes removed. Returns the number of bytes.
    pub fn string_words(self, _ s: Span, _ out: mut MemVec<u256>) -> usize {
        var word: u256 = 0
        var len: usize = 0
        var i = s.start.off + 1
        while i < s.end().off - 1 {
            var c = self.byte(i)
            if c.is(b'\\') {
                i += 1
                c = self.byte(i).unescape()
            }
            let k = len % STR_WORD_BYTES
            word = word | (c.value() as u256) << str_byte_shift(k)
            len += 1
            if k == STR_WORD_BYTES - 1 {
                out.push(word)
                word = 0
            }
            i += 1
        }
        if len % STR_WORD_BYTES != 0 {
            out.push(word)
        }
        len
    }

    // Line and column of byte offset `pos`. LF, CR and CRLF each end one line.
    pub fn line_col(self, _ pos: Pos) -> LineCol {
        var at = LineCol { line: 1, col: 1 }
        var i: usize = 0
        while i < pos.off && i < self.bytes.len() {
            let c = self.byte(i)
            i += 1
            let crlf = c.is(b'\r') && i < self.bytes.len() && self.byte(i).is(b'\n')
            if c.is_newline() && !crlf {
                at.line += 1
                at.col = 1
            } else {
                at.col += 1
            }
        }
        at
    }
}

// The number of bytes of a string literal in each word that `Text.string_words` pushes.
pub const STR_WORD_BYTES: usize = 32

// Returns byte `k` of a word that `Text.string_words` pushed.
pub fn str_word_byte(_ w: u256, _ k: usize) -> u8 {
    (w >> str_byte_shift(k)).downcast_truncate()
}

// Returns the shift of byte `k` in a string word. The first byte is the most significant.
fn str_byte_shift(_ k: usize) -> u256 {
    ((STR_WORD_BYTES - 1 - k) * 8) as u256
}

const U256_MAX: u256 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff

// The byte classes of SPEC.md §1.
impl Byte {
    fn is_ascii(self) -> bool {
        self.within(0, 0x7f)
    }

    fn is_newline(self) -> bool {
        self.is(b'\n') || self.is(b'\r')
    }

    fn is_upper(self) -> bool {
        self.within(b'A', b'Z')
    }

    fn is_ident_start(self) -> bool {
        self.within(b'a', b'z') || self.is_upper() || self.is(b'_')
    }

    fn is_digit(self) -> bool {
        self.within(b'0', b'9')
    }

    fn is_hex_digit(self) -> bool {
        self.is_digit() || self.within(b'a', b'f') || self.within(b'A', b'F')
    }

    // Returns the base of an integer literal whose leading `0` this byte follows: 16 for `x`, 8
    // for `o` and 2 for `b`, in either case. Any other byte gives 10.
    fn radix(self) -> u256 {
        if self.is(b'x') || self.is(b'X') {
            16
        } else if self.is(b'o') || self.is(b'O') {
            8
        } else if self.is(b'b') || self.is(b'B') {
            2
        } else {
            10
        }
    }

    fn is_digit_in(self, _ base: u256) -> bool {
        self.is_hex_digit() && self.digit_value() < base
    }

    // A byte that may follow `\` in a string escape.
    fn is_escape(self) -> bool {
        self.is(b'"') || self.is(b'\\') || self.is(b'n') || self.is(b'r') || self.is(b't')
    }

    // Returns the byte that a `\` followed by this byte stands for. Any other byte stands for
    // itself.
    fn unescape(self) -> Byte {
        if self.is(b'n') {
            Byte::of(b'\n')
        } else if self.is(b'r') {
            Byte::of(b'\r')
        } else if self.is(b't') { Byte::of(b'\t') } else { self }
    }

    // Returns the value of this hex digit, in either case. Any other byte gives a meaningless
    // value.
    fn digit_value(self) -> u256 {
        let c = self.value()
        let v = if self.is_digit() {
            c - b'0'
        } else if c >= b'a' {
            c - b'a' + 10
        } else {
            c - b'A' + 10
        }
        v as u256
    }
}

// The stack of open `(` and `{` in the source, innermost last. It holds the innermost 256
// levels. The parser rejects nesting that deep anyway (`MAX_DEPTH`).
struct Brackets { bits: u256 }

impl Copy for Brackets {}

impl Brackets {
    // Opens or closes a bracket if `kind` is one, and does nothing for other tokens.
    fn track(mut self, _ kind: Tok) {
        if kind == P_LPAREN {
            self.bits = self.bits << 1 | 1
        } else if kind == P_LBRACE {
            self.bits = self.bits << 1
        } else if kind == P_RPAREN || kind == P_RBRACE {
            self.bits = self.bits >> 1
        }
    }

    // Checks whether the innermost open bracket is `(`.
    fn innermost_is_paren(self) -> bool {
        self.bits & 1 == 1
    }
}

struct Lexer {
    text: Text,
    peeked: Byte,
    // A newline is a token unless the innermost open bracket is `(` (SPEC §3.4).
    open: Brackets,
    // The kind of the token that `next` returned last.
    last: Tok,
    // Offset in `text` where the token being read starts.
    start: Pos,
    // A `/` operator or a doc comment that skip_trivia read. `next` returns it after the
    // newline before it, if there is one.
    queued: Option<Token>,
}

impl Lexer {
    fn new() -> Self uses (input: mut Source) {
        Lexer {
            text: Text::new(),
            peeked: input.next_byte(),
            open: Brackets { bits: 0 },
            last: T_EOF,
            start: SOURCE_START,
            queued: Option::None,
        }
    }

    // Consume the peeked byte into `text`.
    fn bump(mut self) uses (input: mut Source) {
        self.text.push(self.peeked.value())
        self.peeked = input.next_byte()
    }

    fn eat(mut self, _ c: u8) -> bool uses (input: mut Source) {
        if self.peeked.is(c) {
            self.bump()
            return true
        }
        false
    }

    // Returns the span of the token read so far.
    fn span(self) -> Span {
        Span { start: self.start, len: self.text.end().since(self.start) }
    }

    fn tok(self, _ kind: Tok) -> Token {
        Token { kind, span: self.span() }
    }

    fn err(self, _ code: DiagCode) -> Result<Diag, Token> {
        Result::Err(diag(code, self.start))
    }

    // Returns the next token. Inside parentheses, a line may end only with a token that
    // `may_end_line_in_parens`, or before a `)` (SPEC §3.4).
    fn next(mut self) -> Result<Diag, Token> uses (input: mut Source) {
        // Where a line inside parentheses ends with a token that may not end it.
        var bad_break: Option<Pos> = Option::None
        if self.queued.is_none() {
            let span = self.skip_trivia()
            if span.len != 0 {
                if !self.open.innermost_is_paren() {
                    return Result::Ok(Token { kind: T_NEWLINE, span })
                }
                if !self.last.may_end_line_in_parens() {
                    bad_break = Option::Some(span.start)
                }
            }
        }
        match self.token() {
            Result::Ok(t) => {
                match bad_break {
                    Option::Some(pos) => {
                        if t.kind != P_RPAREN {
                            return Result::Err(diag(L_LINE_BREAK, pos))
                        }
                    },
                    Option::None => {},
                }
                self.last = t.kind
                Result::Ok(t)
            },
            Result::Err(d) => Result::Err(d),
        }
    }

    // Reads the token that starts at the peeked byte, or the one that `skip_trivia` queued.
    fn token(mut self) -> Result<Diag, Token> uses (input: mut Source) {
        match self.queued.take() {
            Option::Some(t) => {
                return Result::Ok(t)
            },
            Option::None => {},
        }
        self.start = self.text.end()
        let c = self.peeked
        if c.is_end() {
            return Result::Ok(self.tok(T_EOF))
        }
        if !c.is_ascii() {
            return self.err(L_NON_ASCII)
        }
        if c.is_ident_start() {
            return self.ident()
        }
        if c.is_digit() {
            return self.number()
        }
        if c.is(b'"') {
            return self.string()
        }
        match self.punct() {
            Option::Some(kind) => {
                self.open.track(kind)
                Result::Ok(self.tok(kind))
            },
            Option::None => self.err(L_UNEXPECTED_CHAR),
        }
    }

    // Skips blanks and comments, and queues the `/` operator or the doc comment that ends them.
    // Returns the span of the newline token that they make, in the form `Span.comment_line`
    // reads. The span is empty when they hold no line break.
    fn skip_trivia(mut self) -> Span uses (input: mut Source) {
        // smell: an empty span stands for "no line break". Kept, because returning Option<Span>
        // made the Lexer 6,013 bytes against 5,751 (Fe 26.7.0, -O s). Fix when an Option costs no
        // more than the length check.
        var newline = Span { start: SOURCE_START, len: 0 }
        while true {
            let c = self.peeked
            if c.is_newline() && newline.len == 0 {
                newline = Span { start: self.text.end(), len: 1 }
            }
            if c.is(b' ') || c.is(b'\t') || c.is_newline() {
                self.bump()
            } else if c.is(b'/') {
                self.start = self.text.end()
                self.bump()
                if !self.peeked.is(b'/') {
                    let kind = self.op_or_assign(O_SLASH)
                    self.queued = Option::Some(self.tok(kind))
                    break
                }
                self.bump()
                let doc = self.peeked.is(b'/')
                while !self.peeked.is_end() && !self.peeked.is_newline() {
                    self.bump()
                }
                if doc {
                    self.queued = Option::Some(self.tok(T_DOC))
                    break
                }
                if newline.len != 0 {
                    newline.reach_comment_line(self.start)
                }
            } else {
                break
            }
        }
        newline
    }

    // An identifier, `_` or a keyword.
    fn ident(mut self) -> Result<Diag, Token> uses (input: mut Source) {
        while self.peeked.is_ident_start() || self.peeked.is_digit() {
            self.bump()
        }
        let span = self.span()
        let w = self.text.packed(span)
        if w == W_UNDERSCORE {
            return Result::Ok(self.tok(T_UNDERSCORE))
        }
        if w.is_reserved() {
            return self.err(L_RESERVED_WORD)
        }
        let ty = w.type_kind(span.len)
        if ty != T_IDENT {
            return Result::Ok(self.tok(ty))
        }
        Result::Ok(self.tok(w.keyword()))
    }

    // Kind of the punctuation or operator at the peeked byte, or none if no token starts with it.
    fn punct(mut self) -> Option<Tok> uses (input: mut Source) {
        let c = self.peeked
        self.bump()
        // One loop scans PUNCT and ASSIGNABLE. Two loops, the second over a table of only
        // `+ * % ^`, made Lexer 67 bytes larger (Fe 26.6.0, -O s).
        var k: usize = 0
        while k < PUNCT.len() {
            if c.is(PUNCT[k]) {
                return Option::Some(P_LPAREN.after(k))
            }
            if c.is(ASSIGNABLE[k]) {
                return Option::Some(self.op_or_assign(O_PLUS.after(k)))
            }
            k += 1
        }
        if c.is(b'~') {
            return Option::Some(O_TILDE)
        }
        if c.is(b'-') {
            if self.eat(b'>') {
                return Option::Some(P_ARROW)
            }
            return Option::Some(self.op_or_assign(O_MINUS))
        }
        if c.is(b'&') {
            if self.eat(b'&') {
                return Option::Some(O_ANDAND)
            }
            return Option::Some(self.op_or_assign(O_AMP))
        }
        if c.is(b'|') {
            if self.eat(b'|') {
                return Option::Some(O_OROR)
            }
            return Option::Some(self.op_or_assign(O_PIPE))
        }
        if c.is(b'!') {
            if self.eat(b'=') {
                return Option::Some(O_NE)
            }
            return Option::Some(O_BANG)
        }
        if c.is(b'=') {
            if self.eat(b'=') {
                return Option::Some(O_EQ)
            }
            return Option::Some(O_ASSIGN)
        }
        if c.is(b'<') {
            if self.eat(b'<') {
                return Option::Some(self.op_or_assign(O_SHL))
            }
            if self.eat(b'=') {
                return Option::Some(O_LE)
            }
            return Option::Some(O_LT)
        }
        if c.is(b'>') {
            if self.eat(b'>') {
                return Option::Some(self.op_or_assign(O_SHR))
            }
            if self.eat(b'=') {
                return Option::Some(O_GE)
            }
            return Option::Some(O_GT)
        }
        Option::None
    }

    // Kind `one`, or its assignment form when `=` follows.
    fn op_or_assign(mut self, _ one: Tok) -> Tok uses (input: mut Source) {
        if self.eat(b'=') {
            return one.assign_form()
        }
        one
    }

    // Reads an integer literal. SPEC.md §1 gives its syntax. Its value is not checked here.
    fn number(mut self) -> Result<Diag, Token> uses (input: mut Source) {
        let first = self.peeked
        self.bump()
        let base = if first.is(b'0') {
            self.peeked.radix()
        } else {
            10
        }
        if base != 10 {
            self.bump()
            if !self.peeked.is_digit_in(base) {
                return self.err(L_BAD_INT)
            }
            while self.peeked.is_digit_in(base) {
                self.bump()
            }
        } else {
            var last_underscore = false
            while self.peeked.is_digit() || self.peeked.is(b'_') {
                let underscore = self.peeked.is(b'_')
                if underscore && last_underscore {
                    return self.err(L_BAD_INT)
                }
                last_underscore = underscore
                self.bump()
            }
            if last_underscore {
                return self.err(L_BAD_INT)
            }
        }
        if self.peeked.is_ident_start() || self.peeked.is_digit() {
            return self.err(L_BAD_INT)
        }
        Result::Ok(self.tok(T_INT))
    }

    // Reads a string literal. SPEC.md §1 gives its syntax. It may not span lines.
    fn string(mut self) -> Result<Diag, Token> uses (input: mut Source) {
        self.bump()
        while true {
            let c = self.peeked
            if c.is_end() || c.is_newline() {
                return self.err(L_UNTERMINATED_STRING)
            }
            self.bump()
            if c.is(b'"') { break }
            if c.is(b'\\') {
                if !self.peeked.is_escape() {
                    return Result::Err(diag(L_BAD_ESCAPE, self.text.end().minus(1)))
                }
                self.bump()
            }
        }
        Result::Ok(self.tok(T_STR))
    }
}

// Returns the tokens of everything `Source` provides. Stops at the first error.
pub fn lex() -> Lexed uses (input: mut Source) {
    var lx = Lexer::new()
    var toks: MemVec<Token> = MemVec::new()
    var err: Option<Diag> = Option::None
    while true {
        match lx.next() {
            Result::Ok(t) => {
                toks.push(t)
                if t.kind == T_EOF { break }
            },
            Result::Err(d) => {
                err = Option::Some(d)
                break
            },
        }
    }
    Lexed { text: lx.text, toks, err }
}
