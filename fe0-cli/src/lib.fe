// The native command line compiler: Fe0 source on stdin, the deploy code as hex on stdout, and
// errors and warnings on stderr. It is the only part of Fe0 that touches std I/O
// (docs/adr/0010-source-effect.md).

use core::text::hex
use fe0::codegen::{Compiled, compile}
use fe0::diag::{Diag, DiagCode}
use fe0::io::{Source, bytes}
use fe0::lexer::Text
use ingot::messages::message
use std::abi::Bytes
use std::env::Args
use std::io::{Display, Stderr, Stdin, Stdout, read_to_end}

// Exit codes.
const COMPILED: i32 = 0
const REJECTED: i32 = 1
const USAGE: i32 = 2

pub fn main() -> i32
uses (args: Args, stdin: mut Stdin, stdout: mut Stdout, stderr: mut Stderr)
{
    if args.count() != 1 {
        return usage()
    }
    var program = MemBuffer::empty()
    read_to_end(mut program)
    let reporter = Reporter { text: Text::of(program.span()) }
    let compiled = with (Source = bytes(Bytes::from_payload(source: program.span()))) {
        compile()
    }
    reporter.report(compiled)
}

// Prints the usage line on stderr and returns the exit code for a wrong command line.
fn usage() -> i32 uses (stderr: mut Stderr) {
    eprintln!("usage: fe0_cli < program.fe")
    USAGE
}

// Reports what the compiler made of a program, with each position as a line and a column of
// the program's text.
struct Reporter { text: Text }

impl Reporter {
    // Prints the warnings of `c` on stderr. Then prints its error on stderr, or its code as hex
    // on stdout. Returns the exit code.
    fn report(self, _ c: own Compiled) -> i32
    uses (stdout: mut Stdout, stderr: mut Stderr)
    {
        var i: usize = 0
        while i < c.warns.len() {
            self.print_diag(c.warns[i], Severity::Warning)
            i += 1
        }
        match c.out {
            Result::Ok(code) => {
                println!(DeployCode { bytes: code })
                COMPILED
            },
            Result::Err(d) => {
                self.print_diag(d, Severity::Error)
                REJECTED
            },
        }
    }

    // Prints `d` as `<stdin>:line:col: CODE message`, with its severity before the code.
    fn print_diag(self, _ d: Diag, _ severity: Severity) uses (stderr: mut Stderr) {
        let at = self.text.line_col(d.pos())
        eprintln!(
            "<stdin>:",
            at.line,
            ":",
            at.col,
            ": ",
            severity,
            PrintedCode { code: d.code },
            " ",
            message(d.code),
        )
    }
}

// How bad a diagnostic is. It prints before the diagnostic's code.
enum Severity {
    Error,
    Warning,
}

impl Display for Severity {
    fn fmt(self, _ out: mut MemBuffer) {
        match self {
            Severity::Error => {},
            Severity::Warning => write!(mut out, "warning: "),
        }
    }
}

// A diagnostic code. It prints as its letter and its number in 3 digits, such as N014.
struct PrintedCode { code: DiagCode }

impl Display for PrintedCode {
    fn fmt(self, _ out: mut MemBuffer) {
        let n = self.code.number()
        out.push(self.code.letter())
        if n < 100 { out.push(b'0') }
        if n < 10 { out.push(b'0') }
        write!(mut out, n)
    }
}

// The deploy code of a program. It prints as lowercase hex.
struct DeployCode { bytes: MemVec<u8> }

impl Display for DeployCode {
    fn fmt(self, _ out: mut MemBuffer) {
        var i: usize = 0
        while i < self.bytes.len() {
            write!(mut out, hex(self.bytes[i] as u256, 1))
            i += 1
        }
    }
}
