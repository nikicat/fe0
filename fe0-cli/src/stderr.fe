// Lines for stderr, written with libc's `write` on file descriptor 2 (docs/WORKAROUNDS.md,
// "A native program has no stderr").

extern {
    fn malloc(_ size: u64) -> *u8
    fn free(_ address: *u8)
    fn write(_ fd: i32, _ buf: *u8, _ n: u64) -> i64
}

const STDERR: i32 = 2
pub const NEWLINE: u8 = 10
const ZERO_DIGIT: u8 = 48

// A line of text, written to stderr at once by `print`.
pub struct Line { bytes: MemVec<u8> }

impl Line {
    pub fn new() -> Line {
        Line { bytes: MemVec::new() }
    }

    // Appends byte `b`.
    pub fn byte(mut self, _ b: u8) {
        self.bytes.push(b)
    }

    // Appends the bytes of `s`.
    pub fn text<const N: usize>(mut self, _ s: String<N>) {
        let b = s.as_bytes()
        var i: usize = 0
        while i < N {
            self.byte(b[i])
            i += 1
        }
    }

    // Appends `n` in decimal, with zeros in front up to `digits` digits.
    pub fn number(mut self, _ n: usize, digits: usize) {
        if n >= 10 || digits > 1 {
            self.number(n / 10, digits: if digits > 1 { digits - 1 } else { 0 })
        }
        self.byte(ZERO_DIGIT + (n % 10).downcast_truncate())
    }

    // Writes the line and a newline to stderr. Errors are ignored: there is nowhere left to
    // report them.
    pub fn print(mut self) {
        self.byte(NEWLINE)
        let len: u64 = self.bytes.len().downcast_truncate()
        let buf = malloc(len)
        var i: usize = 0
        while i < self.bytes.len() {
            unsafe {
                *core::ptr::offset(buf, i as u256) = self.bytes[i]
            }
            i += 1
        }
        let _ = unsafe {
            write(STDERR, buf, len)
        }
        unsafe {
            free(buf)
        }
    }
}
