#![cfg(target = "evm")]
use ingot::{lex_all, BufferReader, Read}

// Gas for lexing 1024 bytes of the starter's Vault contract on the EVM.
#[test]
fn lex_gas() uses (evm: mut Evm) {
    let src: [u8; 1024] = [112, 117, 98, 32, 99, 111, 110, 116, 114, 97, 99, 116, 32, 86, 97, 117, 108, 116, 32, 117, 115, 101, 115, 32, 40, 99, 116, 120, 58, 32, 67, 116, 120, 44, 32, 99, 97, 108, 108, 58, 32, 109, 117, 116, 32, 67, 97, 108, 108, 44, 32, 108, 111, 103, 58, 32, 109, 117, 116, 32, 76, 111, 103, 41, 32, 123, 10, 32, 32, 32, 32, 108, 111, 99, 107, 58, 32, 68, 117, 114, 97, 116, 105, 111, 110, 44, 10, 32, 32, 32, 32, 109, 117, 116, 32, 98, 97, 108, 97, 110, 99, 101, 115, 58, 32, 83, 116, 111, 114, 97, 103, 101, 77, 97, 112, 60, 65, 100, 100, 114, 101, 115, 115, 44, 32, 87, 101, 105, 62, 44, 10, 32, 32, 32, 32, 109, 117, 116, 32, 117, 110, 108, 111, 99, 107, 95, 97, 116, 58, 32, 83, 116, 111, 114, 97, 103, 101, 77, 97, 112, 60, 65, 100, 100, 114, 101, 115, 115, 44, 32, 84, 105, 109, 101, 115, 116, 97, 109, 112, 62, 44, 10, 10, 32, 32, 32, 32, 105, 110, 105, 116, 40, 108, 111, 99, 107, 95, 112, 101, 114, 105, 111, 100, 58, 32, 68, 117, 114, 97, 116, 105, 111, 110, 41, 32, 117, 115, 101, 115, 32, 40, 109, 117, 116, 32, 108, 111, 99, 107, 41, 32, 123, 32, 108, 111, 99, 107, 32, 61, 32, 108, 111, 99, 107, 95, 112, 101, 114, 105, 111, 100, 32, 125, 10, 10, 32, 32, 32, 32, 114, 101, 99, 118, 32, 86, 97, 117, 108, 116, 77, 115, 103, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 47, 47, 32, 69, 118, 101, 114, 121, 32, 100, 101, 112, 111, 115, 105, 116, 32, 114, 101, 115, 116, 97, 114, 116, 115, 32, 116, 104, 101, 32, 100, 101, 112, 111, 115, 105, 116, 111, 114, 39, 115, 32, 108, 111, 99, 107, 32, 112, 101, 114, 105, 111, 100, 46, 10, 32, 32, 32, 32, 32, 32, 32, 32, 35, 91, 112, 97, 121, 97, 98, 108, 101, 93, 10, 32, 32, 32, 32, 32, 32, 32, 32, 68, 101, 112, 111, 115, 105, 116, 32, 45, 62, 32, 84, 105, 109, 101, 115, 116, 97, 109, 112, 32, 117, 115, 101, 115, 32, 40, 99, 116, 120, 44, 32, 108, 111, 99, 107, 44, 32, 109, 117, 116, 32, 98, 97, 108, 97, 110, 99, 101, 115, 44, 32, 109, 117, 116, 32, 117, 110, 108, 111, 99, 107, 95, 97, 116, 44, 32, 109, 117, 116, 32, 108, 111, 103, 41, 32, 123, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 108, 101, 116, 32, 111, 119, 110, 101, 114, 32, 61, 32, 99, 116, 120, 46, 99, 97, 108, 108, 101, 114, 40, 41, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 108, 101, 116, 32, 97, 109, 111, 117, 110, 116, 32, 61, 32, 99, 116, 120, 46, 118, 97, 108, 117, 101, 40, 41, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 97, 115, 115, 101, 114, 116, 33, 40, 97, 109, 111, 117, 110, 116, 32, 62, 32, 87, 101, 105, 58, 58, 122, 101, 114, 111, 40, 41, 44, 32, 34, 78, 111, 116, 104, 105, 110, 103, 32, 116, 111, 32, 100, 101, 112, 111, 115, 105, 116, 34, 41, 10, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 108, 101, 116, 32, 117, 110, 108, 111, 99, 107, 32, 61, 32, 99, 116, 120, 46, 116, 105, 109, 101, 115, 116, 97, 109, 112, 40, 41, 32, 43, 32, 108, 111, 99, 107, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 98, 97, 108, 97, 110, 99, 101, 115, 46, 115, 101, 116, 40, 107, 101, 121, 58, 32, 111, 119, 110, 101, 114, 44, 32, 118, 97, 108, 117, 101, 58, 32, 98, 97, 108, 97, 110, 99, 101, 115, 46, 103, 101, 116, 40, 107, 101, 121, 58, 32, 111, 119, 110, 101, 114, 41, 32, 43, 32, 97, 109, 111, 117, 110, 116, 41, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 117, 110, 108, 111, 99, 107, 95, 97, 116, 46, 115, 101, 116, 40, 107, 101, 121, 58, 32, 111, 119, 110, 101, 114, 44, 32, 118, 97, 108, 117, 101, 58, 32, 117, 110, 108, 111, 99, 107, 41, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 108, 111, 103, 46, 101, 109, 105, 116, 40, 68, 101, 112, 111, 115, 105, 116, 101, 100, 32, 123, 32, 111, 119, 110, 101, 114, 44, 32, 97, 109, 111, 117, 110, 116, 44, 32, 117, 110, 108, 111, 99, 107, 95, 97, 116, 58, 32, 117, 110, 108, 111, 99, 107, 32, 125, 41, 10, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32, 117, 110, 108, 111, 99, 107, 10, 32, 32, 32, 32, 32, 32, 32, 32, 125, 10, 10, 32, 32, 32, 32, 32, 32, 32, 32, 87, 105, 116, 104, 100, 114, 97, 119, 32, 123, 32, 116, 111, 32, 125, 32, 4