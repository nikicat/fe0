    // Built before the first reading, so that the gas counts only the lexing.
    var reader = BufferReader::from_array(src)
    let before = evm.gas()
    with (Read = reader) {
        let tokens = lex_all()
        let used = before - evm.gas()
        assert!(tokens.len() > 100)
        core::panic_code(used)
    }
}
