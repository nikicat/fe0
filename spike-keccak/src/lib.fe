// Feasibility: one keccak-f[1600] round in Fe on u64 lanes, on EVM and native.

const RHO: [u64; 25] = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]

fn rotl(_ x: u64, _ n: u64) -> u64 {
    if n == 0 { x } else { (x << n) | (x >> (64 - n)) }
}

// theta, rho, pi, chi, iota with round constant `rc`. Lane (x, y) is at index x + 5y.
pub fn round(_ a: own [u64; 25], _ rc: u64) -> [u64; 25] {
    var s = a
    var c: [u64; 5] = [0; 5]
    var x: usize = 0
    while x < 5 {
        c[x] = s[x] ^ s[x + 5] ^ s[x + 10] ^ s[x + 15] ^ s[x + 20]
        x += 1
    }
    x = 0
    while x < 5 {
        let d = c[(x + 4) % 5] ^ rotl(c[(x + 1) % 5], 1)
        var y: usize = 0
        while y < 25 {
            s[x + y] = s[x + y] ^ d
            y += 5
        }
        x += 1
    }
    var b: [u64; 25] = [0; 25]
    x = 0
    while x < 5 {
        var y: usize = 0
        while y < 5 {
            b[y + 5 * ((2 * x + 3 * y) % 5)] = rotl(s[x + 5 * y], RHO[x + 5 * y])
            y += 1
        }
        x += 1
    }
    x = 0
    while x < 5 {
        var y: usize = 0
        while y < 25 {
            s[x + y] = b[x + y] ^ (~b[(x + 1) % 5 + y] & b[(x + 2) % 5 + y])
            y += 5
        }
        x += 1
    }
    s[0] = s[0] ^ rc
    s
}

pub fn input() -> [u64; 25] {
    var s: [u64; 25] = [0; 25]
    var i: usize = 0
    var k: u64 = 0
    while i < 25 {
        s[i] = k * 0x0123456789abcdef + 0x9e3779b97f4a7c15
        i += 1
        k += 1
    }
    s
}

// Fold the state to one word for comparison.
pub fn digest(_ s: [u64; 25]) -> u64 {
    var h: u64 = 0
    var i: usize = 0
    while i < 25 {
        h = rotl(h, 7) ^ s[i]
        i += 1
    }
    h
}

// Prints the digest as 16 hex digits.
#[cfg(target = "native")]
pub fn main() -> i32 uses (stdout: mut std::io::Stdout) {
    let h = digest(round(input(), 0x8000000080008081))
    println!(core::text::hex(h as u256, 8))
    0
}
