{
  "name": "fe0",
  "build": { "dockerfile": "Containerfile" },
  "remoteUser": "vscode",
  // the Fe extension's language server runs the image's compiler
  "remoteEnv": { "FE_PATH": "/usr/local/bin/fe" },
  "customizations": {
    "vscode": {
      // ms-python.python brings Pylance, which navigates the tools' Python. It reads the
      // tools' own environment, which postCreateCommand creates from tools/uv.lock.
      "extensions": ["tamasfe.even-better-toml", "ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/tools/.venv/bin/python" }
    }
  },
  // The hooks in .githooks/ check what CI checks before a commit gets that far.
  "postCreateCommand": "uv sync --project tools --locked && git config core.hooksPath .githooks",
  // Fe's extension is not on the marketplace, so the image holds its VSIX (Containerfile).
  // CI attaches without VS Code, so the install runs only where `code` exists.
  "postAttachCommand": "if command -v code >/dev/null; then code --install-extension /usr/local/share/vscode/fe-language.vsix; fi"
}
