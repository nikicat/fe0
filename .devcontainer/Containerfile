# The development image: what this repo's tools and CI run, and Fe work around them, nothing
# about whoever runs it. Debian trixie, for amd64 and arm64 alike, with its current point release
# and security fixes; the tools Debian lacks or has too old are pinned by version and checksum.
FROM docker.io/library/debian:trixie-20261104-slim

ARG DEBIAN_FRONTEND=noninteractive
# chromium for the playground's browser tests (playground/playwright.config.ts), from Debian, so
# that it gets Debian's security fixes on both architectures
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git make gcc libc6-dev xz-utils \
      chromium \
 && rm -rf /var/lib/apt/lists/*

# uv from its release, and the latest CPython through it as the default python3; each uv
# release checks the builds it downloads against its own checksums
ARG UV=0.13.7
ARG UV_SHA256_amd64=c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83
ARG UV_SHA256_arm64=71279f8d3c67241e807b9d8db872d1bf541579fb9f08b7d1eb1682196d1e57dc
ARG PYTHON=3.15.2
ENV UV_PYTHON_INSTALL_DIR=/usr/local/uv/python UV_PYTHON_BIN_DIR=/usr/local/bin
RUN set -e; arch=$(dpkg --print-architecture); \
    case $arch in amd64) triple=x86_64-unknown-linux-gnu ;; arm64) triple=aarch64-unknown-linux-gnu ;; esac; \
    curl -fsSLo /tmp/uv.tgz "https://github.com/astral-sh/uv/releases/download/$UV/uv-$triple.tar.gz"; \
    eval echo \"\$UV_SHA256_$arch  /tmp/uv.tgz\" | sha256sum -c -; \
    tar -C /usr/local/bin --strip-components=1 -xzf /tmp/uv.tgz "uv-$triple/uv" "uv-$triple/uvx"; rm /tmp/uv.tgz; \
    uv python install --default --preview-features python-install-default "$PYTHON"

# Fe's release build, pinned here for CI and the dev container alike
ARG FE=v26.7.0
ARG FE_SHA256_amd64=4ef2b818e260f0ba0b0af4bd78468dda589dc4949503fffaef25d8188e5107d5
ARG FE_SHA256_arm64=8410974317f84d419203cf1e78644865579f0886e32c84d865c9f8e95f804dbe
RUN set -e; arch=$(dpkg --print-architecture); \
    curl -fsSLo /usr/local/bin/fe "https://github.com/argotorg/fe/releases/download/$FE/fe_linux_$arch"; \
    eval echo \"\$FE_SHA256_$arch  /usr/local/bin/fe\" | sha256sum -c -; \
    chmod 755 /usr/local/bin/fe

# Node from its release, for the playground's build and tests (ADR 0032), and for building Fe
# from source. Fe's tree-sitter grammar runs `tree-sitter generate` in its build script, and
# `npm ci` in crates/tree-sitter-fe installs that CLI.
ARG NODE=26.13.1
ARG NODE_SHA256_amd64=5c063e46bab0fbc1c17cc445d7ff129cbdcd0471be6ed83b6ab864f8143bc864
ARG NODE_SHA256_arm64=89e1853138db51e8b82d3e98ba9c0d3f2956a28e5e55ea1b7e12d25aae92d5dd
RUN set -e; arch=$(dpkg --print-architecture); \
    case $arch in amd64) narch=x64 ;; arm64) narch=arm64 ;; esac; \
    curl -fsSLo /tmp/node.txz "https://nodejs.org/dist/v$NODE/node-v$NODE-linux-$narch.tar.xz"; \
    eval echo \"\$NODE_SHA256_$arch  /tmp/node.txz\" | sha256sum -c -; \
    tar -C /usr/local --strip-components=1 -xJf /tmp/node.txz "node-v$NODE-linux-$narch/bin" "node-v$NODE-linux-$narch/lib"; \
    rm /tmp/node.txz

# Fe's VS Code extension (highlighting and the language server), which is published only as a
# VSIX on GitHub; devcontainer.json's postAttachCommand installs it
ARG VSCODE_FE=0.1.0
ARG VSCODE_FE_SHA256=13ff65dfbf74592a0a4990bb686be1d16b9e3742de3ec625c694278d2c71eca0
RUN set -e; mkdir -p /usr/local/share/vscode; \
    f=/usr/local/share/vscode/fe-language.vsix; \
    curl -fsSLo "$f" "https://github.com/fe-lang/vscode-fe/releases/download/v$VSCODE_FE/fe-language-$VSCODE_FE.vsix"; \
    echo "$VSCODE_FE_SHA256  $f" | sha256sum -c -

# the user VS Code connects as (devcontainer.json's remoteUser)
RUN useradd -m -u 1000 -U vscode

# rust through rustup, at one version; the user owns its homes so cargo can fill the registry
ARG RUSTUP=1.29.3
ARG RUSTUP_SHA256_amd64=b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55
ARG RUSTUP_SHA256_arm64=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
ARG RUST=1.99.1
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
# foundry from its release; solc for Fe's differential tests (FE_SOLC_PATH), which
# soliditylang.org builds for amd64 only
ARG FOUNDRY=1.9.0
ARG FOUNDRY_SHA256_amd64=8d17599b42e3139f1a9c171be3798c4ed8e743ae17b84cc3435e57bf2a51ae99
ARG FOUNDRY_SHA256_arm64=22d3060fa83515fb901690a2c59a5f552bd41c241886195b2159562fc4947abc
ARG SOLC=0.8.30
ARG SOLC_COMMIT=73712a01
ARG SOLC_SHA256=f3e987dc6ecebd4bd350c48edcbc320b46cf9e3109bd3fc3d88f1acaf4c428f7
ENV FE_SOLC_PATH=/usr/local/bin/solc-${SOLC}
RUN set -e; arch=$(dpkg --print-architecture); \
    case $arch in amd64) triple=x86_64-unknown-linux-gnu ;; arm64) triple=aarch64-unknown-linux-gnu ;; esac; \
    get() { curl -fsSLo "$1" "$2"; echo "$3  $1" | sha256sum -c -; }; \
    eval get /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/$RUSTUP/$triple/rustup-init" \$RUSTUP_SHA256_$arch; \
    chmod 755 /tmp/rustup-init; /tmp/rustup-init -y -q --no-modify-path --profile minimal \
      --default-toolchain "$RUST" -c rustfmt,clippy,rust-src -t wasm32-unknown-unknown,wasm32-wasip1; \
    chown -R vscode: "$RUSTUP_HOME" "$CARGO_HOME"; \
    eval get /tmp/foundry.tgz "https://github.com/foundry-rs/foundry/releases/download/v$FOUNDRY/foundry_v${FOUNDRY}_linux_$arch.tar.gz" \$FOUNDRY_SHA256_$arch; \
    tar -C /usr/local/bin -xzf /tmp/foundry.tgz forge cast anvil chisel; \
    if [ "$arch" = amd64 ]; then \
      get "$FE_SOLC_PATH" "https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v$SOLC+commit.$SOLC_COMMIT" "$SOLC_SHA256"; \
      chmod 755 "$FE_SOLC_PATH"; \
    fi; \
    rm /tmp/rustup-init /tmp/foundry.tgz

